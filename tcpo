#!/bin/bash

# ==================================================
# tcpo —— TCP/UDP 网络调优面板
# 一键执行: bash <(curl -sL <你的分发地址>)
# 安装后直接敲: tcpo
# ==================================================

# 版本号。启动时的版本检查按字符串不等来判「有新版」，不做大小比较——
# 语义化版本的数值比较在纯 bash 里要拆三段，而这里只需要「和线上不一样就提示」。
# [人工决策-2026-08-05 14:22:07] 只用单个整数递增，不用 semver 的三段式。
# 判据是「不等即提示」本来就不需要大小关系，三段式反而要求维护者每次判断
# 这算 minor 还是 patch。改动此处必须同步 VERSION 文件（Jenkins 门 4 会逐字校验）
SCRIPT_VERSION="2"

# --- 分发地址：改这一处即可（自建域名 / GitHub raw / jsDelivr）---
# 支持环境变量覆盖，便于本地测试：TCP_DASHBOARD_URL=http://127.0.0.1:8000/tcpo bash tcpo
# 站点由仓库根的 Jenkinsfile 发布到 tcp.itssx.com，网页与本脚本同批上线；
# 该流水线会校验此处指向 https://tcp.itssx.com/tcpo，改动需同步 Jenkinsfile 的 SITE_URL
SCRIPT_URL="${TCP_DASHBOARD_URL:-https://tcp.itssx.com/tcpo}"

# 版本检查的候选源，按顺序试，第一个拿到就停。自建域名在前（改完立即生效），
# GitHub raw 兜底（自建域名挂了仍能发现新版）。
# 只读一个小文本文件、不下载脚本本体，检查到有新版也只提示不自动更新——
# 自动更新等于让远端代码在用户没同意的情况下改动一台生产机
VERSION_URLS="https://tcp.itssx.com/VERSION
https://raw.githubusercontent.com/SunSeekerX/tcpo/main/VERSION"
# 检查超时：两个源各自的上限。总耗时最坏 2×3=6 秒，且失败静默跳过不打扰用户
VERSION_TIMEOUT=3
# 检查结果缓存，避免每次开面板都联网。文件存「检查时间戳 线上版本号」
VERSION_CACHE_TTL=86400

# 安装路径即命令名：文件名 tcpo 无扩展名，装到 PATH 里本身就是命令，不需要额外软链。
# 名字取 tcp optimize。不能用 tcpd（Debian 的 tcpd 包占 /usr/sbin/tcpd、tcm 包占 /usr/bin/tcpd，
# 装到 /usr/local/bin 会靠 PATH 优先级静默劫持系统命令），也不能用 ttcp
# （1980 年代的经典吞吐测试工具 Test TCP，同领域撞名）。
# tcpo 查过 Debian 全仓库无同名文件，Debian/RHEL/Alpine/Arch 四系均不冲突
SCRIPT_PATH="/usr/local/bin/tcpo"
# 用 zz- 前缀确保最后加载。systemd-sysctl 按文件名字典序应用、后者覆盖前者，
# 而多数发行版/面板自带 99-sysctl.conf（字典序在 99-network-performance.conf 之后），
# 会把这里设的值悄悄盖回去——实测判例：somaxconn 写了 65535、实际生效仍是 1024，且全程无任何报错
SYSCTL_OPT="/etc/sysctl.d/zz-network-performance.conf"
LEGACY_SYSCTL_OPT="/etc/sysctl.d/99-network-performance.conf"
BBR_OPT="/etc/sysctl.d/10-bbr.conf"
# tcp_bbr 的开机加载配置。集中成常量而不是散在 enable_bbr 里硬编码：
# 它和上面几个一样是「本脚本落地的文件」，要能被回退清理、被演练重定向、走同一套写保护
BBR_MODLOAD="/etc/modules-load.d/bbr.conf"
LIMITS_OPT="/etc/security/limits.d/99-network-performance.conf"
# gai.conf 与它的备份。集中成常量是为了能纳入演练模式的路径重定向——
# 之前这两个路径散落在七处硬编码，演练模式改不到它们，于是 TCPO_DRYRUN=1 跑菜单 1
# 仍会真实改机，与「零写入」的承诺直接冲突
GAI_CONF="/etc/gai.conf"
GAI_BAK="/etc/gai.conf.bak"
# 状态标记与诊断要读的是**真机**状态，不能跟着演练重定向走——否则演练模式下
# 菜单栏显示的是临时目录里的内容，用户会误以为真机已经改了。
# 写入路径用 $GAI_CONF（受演练重定向），只读探测用这个
GAI_CONF_REAL="/etc/gai.conf"
# systemd 服务的 fd 上限不走 PAM/limits.d，得靠 systemd 自己的 DefaultLimitNOFILE。
# 写成 drop-in 而不是改主配置文件，回退时整份删掉即可
SYSTEMD_LIMITS_OPT="/etc/systemd/system.conf.d/zz-tcpo-limits.conf"

# 状态目录：存首次运行前的原始值（供回退还原真实值而非猜的默认值）、
# 被接管的冲突文件清单、以及 sysctl 应用日志
STATE_DIR="/var/lib/tcp-dashboard"
ORIG_STATE="$STATE_DIR/original-values"
TAKEOVER_LIST="$STATE_DIR/taken-over"
APPLY_LOG="$STATE_DIR/apply.log"
# 版本检查缓存：一行「检查时间戳 线上版本号」。有它才能做到「每天最多查一次」，
# 否则每次敲 tcpo 都要等一次网络往返
VERSION_CACHE="$STATE_DIR/version-check"
# /sys 下的设置（RPS/RFS/XPS）重启即失效，用一份 plan + 一个 oneshot unit 持久化。
# plan 与实时应用共用同一份内容，避免两边漂移
NICPLAN="$STATE_DIR/nic.plan"
# qdisc 的开机重放单独一份 plan：$NICPLAN 是「/sys 路径<TAB>值」的直接写入，
# 而 qdisc 要跑 tc 命令并区分 mq/非 mq，格式与执行方式都不同，混在一份里会互相干扰
QDISCPLAN="$STATE_DIR/qdisc.plan"
NIC_UNIT="/etc/systemd/system/tcp-dashboard-nic.service"
NIC_APPLY="/usr/local/bin/tcp-dashboard-nic-apply.sh"
# networkd-dispatcher 钩子：网卡变为 routable 时重放队列设置（补 oneshot 只在开机跑的缺口）。
# 只在装了 systemd-networkd 的机器上有这个目录，没有就跳过
NIC_DISPATCH="/etc/networkd-dispatcher/routable.d/50-tcp-dashboard"
# iptables 规则的所有权标记。iptables 没有 drop-in 概念，规则一旦加进链里就和别人的
# 混在一起，comment 是唯一可靠的归属判据
MSS_TAG="tcpo-mss-clamp"
# RTT / 抖动的探测目标。集中成一处：探测函数与「RTT 来源」的说明文案共用同一份，
# 否则改了目标而文案还写着旧地址
RTT_PROBE_TARGETS="1.1.1.1 8.8.8.8 9.9.9.9"
# RFS 全局流表单独一个 drop-in：菜单 5 可以独立执行，不能依赖主配置文件已存在
NIC_SYSCTL_OPT="/etc/sysctl.d/zz-network-rfs.conf"
# 无 systemd 环境（WSL 默认、sysvinit、容器）里 /etc/sysctl.d/ 开机没人读，
# 写进去的参数重启即失效。给这类机器生成一个可挂到自家 init 流程的重放脚本。
# 不自动改 wsl.conf / rc 目录：那超出「网络参数」范畴，且会改变整个发行版的启动方式
SYSCTL_APPLY="/usr/local/bin/tcp-dashboard-sysctl-apply.sh"
# 上面那个脚本每次运行都往这里写一行时间戳。判「它到底有没有被挂进启动链」时读它——
# 记的是「运行时的 uptime」而不是墙钟时间：只有 uptime 很小才说明它是被 init 在开机
# 早期自动拉起的。这比扫启动配置猜「会不会执行」可靠（后者要解析任意 shell 语义），
# 也比只记「跑过」可靠（手工跑一次就会被误判成已挂）
SYSCTL_APPLY_STAMP="$STATE_DIR/sysctl-apply.stamp"
# 「开机早期」的上限（秒）。重放脚本记录运行时的 uptime，只有小于这个值才算开机钩子。
# 300 秒的依据：init 拉起 rc.local / openrc 服务 / WSL 的 [boot] command 通常在开机
# 几秒内，慢机器上装完驱动挂完盘也很少超过一两分钟；而用户手工执行时机器一般已开机很久。
# 定得太小只会漏判慢启动的机器（保守方向：多提示一句挂法），太大则可能把
# 「开机没多久用户自己手动跑了一次」误判成钩子
HOOK_MAX_UPTIME=300

# ==================================================
# 演练模式（TCPO_DRYRUN=1）
# ==================================================
# 把上面全部写入路径重定向到一个临时目录，于是整条流程照跑、一个字节都不进 /etc。
# 这样做而不是在每个写入函数里加 if：写入函数一行都不用改，也就不存在「某个分支
# 忘了判断 dry-run」这类漏洞——真实路径与演练路径跑的是同一份代码。
#
# 用途有两个：让用户零副作用地看清「两档分别会写什么」，以及在 CI 里验证生成逻辑
# （容器里 net.core.* 多半不可写，但配置文件内容是可验的）。
#
# sysctl --system / tc / iptables 这些「改内核状态」的动作由 apply_sysctl 等函数
# 各自判断 DRYRUN 跳过——它们不写文件，重定向路径管不到
DRYRUN=0
if [ "${TCPO_DRYRUN:-0}" = "1" ]; then
    DRYRUN=1
    DRYRUN_ROOT=$(mktemp -d 2>/dev/null) || {
        echo "演练模式无法创建临时目录，退出" >&2
        exit 1
    }
    # 目录结构照抄真实布局，方便用户直接 diff
    mkdir -p "$DRYRUN_ROOT/etc/sysctl.d" "$DRYRUN_ROOT/etc/security/limits.d" \
        "$DRYRUN_ROOT/etc/systemd/system.conf.d" "$DRYRUN_ROOT/etc/systemd/system" \
        "$DRYRUN_ROOT/etc/modules-load.d" \
        "$DRYRUN_ROOT/var/lib/tcp-dashboard" "$DRYRUN_ROOT/usr/local/bin" 2>/dev/null
    SYSCTL_OPT="$DRYRUN_ROOT$SYSCTL_OPT"
    LEGACY_SYSCTL_OPT="$DRYRUN_ROOT$LEGACY_SYSCTL_OPT"
    BBR_OPT="$DRYRUN_ROOT$BBR_OPT"
    # 新增受管落地文件必须同步加进这份重定向清单，否则演练模式会真的写 /etc
    BBR_MODLOAD="$DRYRUN_ROOT$BBR_MODLOAD"
    LIMITS_OPT="$DRYRUN_ROOT$LIMITS_OPT"
    GAI_CONF="$DRYRUN_ROOT$GAI_CONF"
    GAI_BAK="$DRYRUN_ROOT$GAI_BAK"
    SYSTEMD_LIMITS_OPT="$DRYRUN_ROOT$SYSTEMD_LIMITS_OPT"
    NIC_SYSCTL_OPT="$DRYRUN_ROOT$NIC_SYSCTL_OPT"
    NIC_UNIT="$DRYRUN_ROOT$NIC_UNIT"
    NIC_APPLY="$DRYRUN_ROOT$NIC_APPLY"
    NIC_DISPATCH="$DRYRUN_ROOT$NIC_DISPATCH"
    SYSCTL_APPLY="$DRYRUN_ROOT$SYSCTL_APPLY"
    STATE_DIR="$DRYRUN_ROOT$STATE_DIR"
    ORIG_STATE="$STATE_DIR/original-values"
    TAKEOVER_LIST="$STATE_DIR/taken-over"
    APPLY_LOG="$STATE_DIR/apply.log"
    VERSION_CACHE="$STATE_DIR/version-check"
    NICPLAN="$STATE_DIR/nic.plan"
    QDISCPLAN="$STATE_DIR/qdisc.plan"
    SYSCTL_APPLY_STAMP="$STATE_DIR/sysctl-apply.stamp"
fi

# 演练模式下把「将要执行但被跳过」的动作打出来。真实模式什么都不做（返回 1），
# 调用方据此决定要不要真的执行
dryrun_skip() {
    [ "$DRYRUN" = "1" ] || return 1
    echo -e "  ${CYAN}[演练]${NC} 跳过: $*"
    return 0
}

# 演练结束时把生成的文件内容全部倒出来给用户看
dryrun_report() {
    [ "$DRYRUN" = "1" ] || return 0
    local f n=0
    echo
    echo -e "${YELLOW}=========== 演练结果：将写入的文件 ===========${NC}"
    # find 而不是逐个变量判断：这样新增写入点时不用改这里
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        n=$((n + 1))
        echo -e "\n${CYAN}--- ${f#$DRYRUN_ROOT} ---${NC}"
        sed 's/^/  /' "$f"
    done <<EOF
$(find "$DRYRUN_ROOT" -type f 2>/dev/null | sort)
EOF
    if [ "$n" -eq 0 ]; then
        echo -e "  ${YELLOW}（本次流程未生成任何文件）${NC}"
    fi
    echo
    echo -e "${GREEN}演练结束，系统未做任何改动。临时目录: $DRYRUN_ROOT${NC}"
    echo -e "${YELLOW}退出后可自行删除: rm -rf $DRYRUN_ROOT${NC}"
}

# 演练模式不写任何系统文件，所以不需要 root——这正是它的用处之一：
# 在自己机器上先看清会写什么，再决定要不要上生产机。
# 注意非 root 下 sysctl -n 读某些 key 会失败，推导出的值可能与 root 下略有差异，
# 但配置文件的结构与推导链是一样的
if [ "$EUID" -ne 0 ] && [ "${TCPO_DRYRUN:-0}" != "1" ]; then
    echo -e "\033[0;31m错误: 必须使用 root 权限运行此脚本！\033[0m"
    echo -e "\033[1;33m提示: 只想看看会改什么？用 TCPO_DRYRUN=1 tcpo（无需 root，不写任何文件）\033[0m"
    exit 1
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

draw_line() {
    echo -e "${YELLOW}--------------------------------------------------${NC}"
}

# 校验一个「刚下载的、准备当成 tcpo 用」的文件是否真是本脚本。
# 首次安装与菜单 7 更新共用这一份，两条路径的严格程度必须一致——
# 首次安装反而更宽松是最糟的组合（用户第一次接触就可能装到坏内容）。
# 判据三条，任一不过即整体放弃：
#   1. 首行必须是 shebang —— 域名被泛解析/回落到 index.html 时拿到的是 HTML
#   2. 必须过 bash -n —— 传输截断的文件语法必然不完整
#   3. 必须含本脚本的特征串 —— 防止拿到的是别的 shell 脚本（比如错误页里的示例）
validate_script() {
    local f=$1
    head -1 "$f" 2>/dev/null | grep -q '^#!/bin/bash' || {
        echo -e "  ${RED}首行不是 #!/bin/bash（拿到的可能是 HTML 错误页）${NC}" >&2
        return 1
    }
    bash -n "$f" 2>/dev/null || {
        echo -e "  ${RED}bash -n 语法检查未通过（传输可能被截断）${NC}" >&2
        return 1
    }
    grep -q '^SCRIPT_VERSION=' "$f" || {
        echo -e "  ${RED}缺少 SCRIPT_VERSION，不像是本脚本${NC}" >&2
        return 1
    }
    return 0
}

# BATCH=1 时不等待回车，供「一键全部」连续执行
BATCH=0
pause_return() {
    [ "$BATCH" = "1" ] && return
    read -p "按回车返回..."
}

# ==================================================
# --- 通用工具 ---
# ==================================================
# ==================================================
# --- 依赖安装 ---
# ==================================================
# 检测包管理器。顺序有讲究：先查 apt-get（Debian 系），再 dnf（新 RHEL）后 yum（老 RHEL），
# 因为 Fedora/RHEL9 同时有 dnf 和 yum（yum 是软链），优先用 dnf 更快
detect_pkg_mgr() {
    local pm
    for pm in apt-get dnf yum zypper pacman apk; do
        command -v "$pm" >/dev/null 2>&1 && { echo "$pm"; return 0; }
    done
    return 1
}

# 工具名 -> 各包管理器下的包名。同一个命令在不同发行版里包名不同，
# 而且 ss/nstat/tc 三个命令来自同一个包（iproute2 / iproute），
# 所以按「命令名」而不是「包名」组织
pkg_for() {
    local tool=$1 pm=$2
    case "$tool" in
    ss | nstat | ip)
        case "$pm" in
        apt-get) echo iproute2 ;;
        dnf | yum) echo iproute ;;
        zypper) echo iproute2 ;;
        pacman) echo iproute2 ;;
        apk) echo iproute2 ;;
        esac
        ;;
    tc)
        # RHEL 系把 tc 拆成了独立包 iproute-tc，装 iproute 拿不到它。
        # 实测 Fedora 41 / Rocky 9 / Alma 9 都是这样
        case "$pm" in
        apt-get) echo iproute2 ;;
        dnf | yum) echo iproute-tc ;;
        zypper) echo iproute2 ;;
        pacman) echo iproute2 ;;
        apk) echo iproute2 ;;
        esac
        ;;
    ethtool) echo ethtool ;;
    iptables)
        # 全系都写 iptables 就够。RHEL 9+ 起没有名为 iptables 的包了
        # （dnf info iptables 报 No matching Packages），但 iptables-nft
        # 声明了 Provides: iptables，所以 dnf install iptables 照样能装上。
        # 实测 Rocky 8 装到 iptables、Rocky 9 装到 iptables-nft，都拿到可用的
        # /usr/sbin/iptables。判包名是否存在要用 provides 而不是 info——
        # 用 info 会把这种虚拟包误判成「映射错了」
        echo iptables
        ;;
    ping)
        case "$pm" in
        apt-get) echo iputils-ping ;;
        dnf | yum) echo iputils ;;
        zypper) echo iputils ;;
        pacman) echo iputils ;;
        apk) echo iputils ;;
        esac
        ;;
    tracepath)
        case "$pm" in
        apt-get) echo iputils-tracepath ;;
        dnf | yum) echo iputils ;;
        zypper) echo iputils ;;
        pacman) echo iputils ;;
        apk) echo iputils ;;
        esac
        ;;
    iperf3) echo iperf3 ;;
    *) echo "$tool" ;;
    esac
}

# apt 索引是否已经可用且够新。只在本进程内记标记不够：面板的每个菜单是同一进程内调用，
# 但用户可能反复进出脚本（每次都是新进程），那样每次装包都要等 apt-get update
# 跑完（Ubuntu 上 30-60 秒）。
#
# 判据必须是「索引文件本身真实存在且够新」，不能用 /var/lib/apt/lists/lock 的时间：
# lock 会在任何 apt 操作时被创建或 touch——包括一次失败的 update、apt-get install、
# 甚至 apt-cache——此后 24 小时内都会被误判成「索引新鲜」，于是跳过 update
# 直接装包，得到 "E: Unable to locate package"，本来能自动补齐的依赖被错误降级。
# update-success-stamp 是 apt 自己维护的「成功」时间戳，可信；lists/lock 不可信。
apt_index_fresh() {
    local stamp age
    # apt 的 periodic 成功戳（unattended-upgrades 装了才有），存在就直接采信
    stamp=/var/lib/apt/periodic/update-success-stamp
    if [ -f "$stamp" ]; then
        age=$(($(date +%s) - $(stat -c %Y "$stamp" 2>/dev/null || echo 0)))
        [ "$age" -lt 86400 ] && return 0
    fi
    # 否则要求确实存在一天内的 Packages 索引文件。
    # find 命中即表示「索引存在且新」，两个条件一次满足
    [ -n "$(find /var/lib/apt/lists -maxdepth 1 -name '*_Packages*' -mtime -1 2>/dev/null | head -1)" ]
}

APT_UPDATED=0
# 所有装包动作都套超时：软件源不可达时 apt/dnf 会挂很久（实测某些环境下
# apt-get update 卡满 10 分钟仍拉不到索引），没有超时的话用户只看到面板卡死、
# 不知道在等什么，也没法中断
PKG_TIMEOUT=180
# 装包日志。输出不直接打印（apt/dnf 几百行会刷屏），但必须留下来供排查——
# 出问题时「装不上」三个字没有任何用，得能看到源返回了什么
PKG_LOG="$STATE_DIR/pkg.log"

# 后台跑装包命令，前台显示转轮 + 已用秒数。
# 装包在慢源上要几十秒，全静默会让用户以为卡死了（实测反馈）。
# 无 tty 时（CI/管道）退化为静默，不往日志里刷转轮字符
run_pkg() {
    local rc pid spin='-\|/' i=0 elapsed=0
    mkdir -p "$STATE_DIR" 2>/dev/null
    printf '=== %s %s\n' "$(date '+%F %T' 2>/dev/null)" "$*" >>"$PKG_LOG" 2>/dev/null

    if command -v timeout >/dev/null 2>&1; then
        timeout "$PKG_TIMEOUT" "$@" >>"$PKG_LOG" 2>&1 &
    else
        "$@" >>"$PKG_LOG" 2>&1 &
    fi
    pid=$!

    # 非交互环境直接等，不画转轮
    if [ ! -t 2 ]; then
        wait "$pid"
        return $?
    fi

    while kill -0 "$pid" 2>/dev/null; do
        i=$(((i + 1) % 4))
        # \r 回到行首原地刷新，不新增行。\033[K 清到行尾，比补空格可靠——
        # 秒数从 9s 涨到 10s 会变宽，靠固定宽度的空格补位迟早留残影
        printf '\r    %s %ds\033[K' "${spin:$i:1}" "$elapsed" >&2
        sleep 1
        elapsed=$((elapsed + 1))
    done
    wait "$pid"
    rc=$?
    # 清掉转轮那一行，后续输出从干净的行首开始
    printf '\r\033[K' >&2
    return $rc
}

pkg_install() {
    local pm=$1 pkg=$2
    case "$pm" in
    apt-get)
        # 变量前缀对 shell 函数不起作用（只对外部命令有效），必须 export
        export DEBIAN_FRONTEND=noninteractive
        if [ "$APT_UPDATED" = "0" ] && ! apt_index_fresh; then
            echo -e "  ${YELLOW}  先更新 apt 索引（首次较慢，最多等 ${PKG_TIMEOUT}s）${NC}" >&2
            run_pkg apt-get update -qq ||
                echo -e "  ${YELLOW}apt 索引更新超时，软件源可能不可达${NC}" >&2
            APT_UPDATED=1
        fi
        run_pkg apt-get install -y -qq "$pkg" && return 0
        # 装失败且这次还没 update 过：判据可能误判了索引新鲜度（比如索引虽在但已过期、
        # 或源列表变过），补一次 update 再试。这样任何判据误差都不会让依赖被错误降级
        if [ "$APT_UPDATED" = "0" ]; then
            echo -e "  ${YELLOW}$pkg 装不上，补一次 apt 索引更新后重试 ...${NC}" >&2
            run_pkg apt-get update -qq
            APT_UPDATED=1
            run_pkg apt-get install -y -qq "$pkg" && return 0
        fi
        return 1
        ;;
    dnf) run_pkg dnf install -y -q "$pkg" ;;
    yum) run_pkg yum install -y -q "$pkg" ;;
    zypper) run_pkg zypper --non-interactive --quiet install -y "$pkg" ;;
    pacman)
        # 先试不同步（-S），失败再同步（-Sy）。避免每装一个包都拉一遍数据库
        run_pkg pacman -S --noconfirm --needed --quiet "$pkg" ||
            run_pkg pacman -Sy --noconfirm --needed --quiet "$pkg"
        ;;
    apk) run_pkg apk add --quiet --no-cache "$pkg" ;;
    *) return 1 ;;
    esac
}

# 确保若干命令可用，缺的自动装。返回仍然缺失的命令列表（空则全部就绪）。
# 用法: missing=$(ensure_tools ss nstat tc)
# 只装、不报错退出——装不上就降级，由调用方决定怎么提示。
# 这是有意的：调优面板不该因为装不上一个诊断工具就拒绝干活
ensure_tools() {
    local want=("$@") missing=() need_install=() t pm pkg
    for t in "${want[@]}"; do
        command -v "$t" >/dev/null 2>&1 || need_install+=("$t")
    done
    [ ${#need_install[@]} -eq 0 ] && return 0

    pm=$(detect_pkg_mgr) || {
        printf '%s\n' "${need_install[@]}"
        return 1
    }

    echo -e "  ${YELLOW}缺少 ${need_install[*]}，正在用 $pm 安装 ...${NC}" >&2
    # 先把包名去重（ss/nstat/tc 都来自 iproute2，只需装一次）
    local pkgs="" seen
    for t in "${need_install[@]}"; do
        pkg=$(pkg_for "$t" "$pm")
        case " $pkgs " in *" $pkg "*) continue ;; esac
        pkgs="$pkgs $pkg"
    done
    # 逐包报进度：一次可能装好几个包（ethtool + iproute2 + iputils-ping），
    # 只说「正在安装」的话用户看不出卡在哪一个上
    local total done_n=0
    total=$(printf '%s\n' $pkgs | wc -l | tr -d ' ')
    for pkg in $pkgs; do
        done_n=$((done_n + 1))
        echo -e "  ${YELLOW}[$done_n/$total] $pkg ...${NC}" >&2
        if pkg_install "$pm" "$pkg"; then
            echo -e "  ${GREEN}[$done_n/$total] $pkg 完成${NC}" >&2
        else
            echo -e "  ${YELLOW}[$done_n/$total] $pkg 安装失败（源不可达、超时或包名不符），详见 $PKG_LOG${NC}" >&2
        fi
    done

    # 装完复查，仍缺的返回给调用方
    for t in "${need_install[@]}"; do
        command -v "$t" >/dev/null 2>&1 || missing+=("$t")
    done
    if [ ${#missing[@]} -gt 0 ]; then
        echo -e "  ${YELLOW}仍缺 ${missing[*]}，相关功能会降级。手动补装:${NC}" >&2
        local hint=""
        for t in "${missing[@]}"; do
            pkg=$(pkg_for "$t" "$pm")
            case " $hint " in *" $pkg "*) continue ;; esac
            hint="$hint $pkg"
        done
        case "$pm" in
        apt-get) echo -e "  ${YELLOW}    apt install -y$hint${NC}" >&2 ;;
        dnf | yum) echo -e "  ${YELLOW}    $pm install -y$hint${NC}" >&2 ;;
        zypper) echo -e "  ${YELLOW}    zypper install -y$hint${NC}" >&2 ;;
        pacman) echo -e "  ${YELLOW}    pacman -S$hint${NC}" >&2 ;;
        apk) echo -e "  ${YELLOW}    apk add$hint${NC}" >&2 ;;
        esac
        printf '%s\n' "${missing[@]}"
        return 1
    fi
    return 0
}

# 只读功能（菜单 8/a/b）用这个，不用 ensure_tools。
# 差别是它绝不装包：只检测、报告缺什么、给出手动补装命令。
# 理由是这三个菜单对外承诺「零副作用、生产机可直接跑」，而装包会刷新包索引、
# 改 dpkg/rpm 数据库、往系统里装新二进制——在别人的生产机上那不算零副作用。
# 缺工具时相关指标降级（由调用方各自处理缺失），不阻止其余项继续跑。
# 返回 0 = 全部就绪，1 = 有缺失
require_tools_readonly() {
    local want=("$@") missing=() t pm pkg hint=""
    for t in "${want[@]}"; do
        command -v "$t" >/dev/null 2>&1 || missing+=("$t")
    done
    [ ${#missing[@]} -eq 0 ] && return 0

    echo -e "  ${YELLOW}缺少 ${missing[*]}，相关指标会跳过（只读功能不会自动装包）${NC}" >&2
    if pm=$(detect_pkg_mgr); then
        for t in "${missing[@]}"; do
            pkg=$(pkg_for "$t" "$pm")
            case " $hint " in *" $pkg "*) continue ;; esac
            hint="$hint $pkg"
        done
        case "$pm" in
        apt-get) echo -e "  ${YELLOW}要补装:  apt install -y$hint${NC}" >&2 ;;
        dnf | yum) echo -e "  ${YELLOW}要补装:  $pm install -y$hint${NC}" >&2 ;;
        zypper) echo -e "  ${YELLOW}要补装:  zypper install -y$hint${NC}" >&2 ;;
        pacman) echo -e "  ${YELLOW}要补装:  pacman -S$hint${NC}" >&2 ;;
        apk) echo -e "  ${YELLOW}要补装:  apk add$hint${NC}" >&2 ;;
        esac
    fi
    return 1
}

# 确保 /etc/sysctl.d 存在。RHEL / Rocky / AlmaLinux / Fedora 的最小化安装里这个目录
# 可能不存在（Debian 系自带，容易掩盖这个问题），直接 cat > 会报 No such file or directory
# 并让整个调优静默失败——实测判例：Rocky 9 容器里菜单 3 全程无配置写入
ensure_sysctl_dir() {
    [ -d /etc/sysctl.d ] && return 0
    mkdir -p /etc/sysctl.d 2>/dev/null && return 0
    echo -e "  ${RED}无法创建 /etc/sysctl.d（只读文件系统？），配置无法持久化${NC}"
    return 1
}

# sysctl --system 的报错不能丢：内核拒绝某个值、参数不存在、被后加载文件覆盖，
# 三种情况的提示都在这里。之前统一 &>/dev/null 导致排查时拿不到内核给的原因
apply_sysctl() {
    mkdir -p "$STATE_DIR"
    # 只跑一次并复用输出：跑两遍（一次写日志一次抓报错）既浪费又可能两次结果不一致
    local out errs
    dryrun_skip "sysctl --system（应用内核参数）" && return 0
    out=$(sysctl --system 2>&1)
    {
        echo "===== $(date '+%F %T') sysctl --system ====="
        printf '%s\n' "$out"
    } >>"$APPLY_LOG"
    # 只把真正的报错回显给用户（正常输出是一堆 "* Applying /etc/sysctl.d/xx.conf ..."）
    errs=$(printf '%s\n' "$out" | grep -iE 'cannot|error|unknown|invalid|permission' | head -8)
    [ -z "$errs" ] && return 0

    # sysctl --system 应用系统里的全部 conf，报错可能压根不来自本脚本。
    # 典型判例：systemd 自带的 /usr/lib/sysctl.d/50-default.conf 用
    # net.ipv4.conf.*.accept_source_route 通配，展开后命中伪接口 all 被内核拒绝，
    # 任何一次 sysctl --system 都会打印它。把这类无条件报成「sysctl 报错」，
    # 会让用户以为本次调优失败了（实测反馈）。
    # 判据：报错行里的 key 是否属于本脚本受管的 MANAGED_KEYS
    local ours="" theirs="" line key
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        # sysctl 的报错有三种格式，都要认（只认第一种会把后两种误判成「别人的」）：
        #   sysctl: setting key "net.core.somaxconn": Invalid argument
        #   sysctl: permission denied on key "net.core.netdev_budget"
        #   sysctl: cannot stat /proc/sys/net/ipv4/tcp_fastopen: No such file...
        # 第三种是路径形式，转成点号 key 再比对
        key=$(printf '%s\n' "$line" | sed -n 's/.*key "\([^"]*\)".*/\1/p')
        if [ -z "$key" ]; then
            key=$(printf '%s\n' "$line" |
                sed -n 's|.*/proc/sys/\([A-Za-z0-9_/.-]*\).*|\1|p' | tr '/' '.')
        fi
        if [ -n "$key" ] && printf '%s\n' $MANAGED_KEYS | grep -qxF "$key"; then
            ours="$ours$line
"
        else
            theirs="$theirs$line
"
        fi
    done <<EOF
$errs
EOF

    if [ -n "$ours" ]; then
        echo -e "${RED}  本脚本管理的参数写入失败（完整日志见 $APPLY_LOG）:${NC}"
        printf '%s' "$ours"
    fi
    if [ -n "$theirs" ]; then
        # 措辞明确说清「不是本次调优的问题」，否则用户没法判断要不要管
        echo -e "${YELLOW}  以下报错来自系统里其他 sysctl 配置文件，与本次调优无关（详见 $APPLY_LOG）:${NC}"
        printf '%s' "$theirs"
    fi
    return 0
}

# ==================================================
# --- 环境探测：决定「写进 /etc/sysctl.d 之后开机还会不会生效」---
# ==================================================
# 这一组判据只回答一个问题：本机开机时有没有人去读 /etc/sysctl.d/。
# 有 systemd 就有 systemd-sysctl，没有则配置文件躺着没人管、重启即回原值。
# [人工决策-2026-08-05 14:22:07] 加这一层的起因是实测判例：WSL2 默认不跑 systemd，
# 面板跑完参数确实生效，wsl --shutdown 后全部回到原值，而主菜单始终显示「已开启」、
# 菜单 3 还打印「配置持久化于 xxx」——用户以为早就调好了，实际每次重启都白调。
# 菜单 5 的网卡队列本来就查 has_systemd 并如实降级，sysctl 这条路径漏了同样的判断。
# 规则：凡宣布「持久化」前必须先探测本机开机会不会重放，禁止无条件打印

# 容器判据。原先内联在 verify_sysctl_applied 里，现在两处都要用，提出来
is_container() {
    [ -f /.dockerenv ] && return 0
    grep -qaE 'docker|containerd|lxc' /proc/1/cgroup 2>/dev/null
}

# WSL 判据。必须在 is_container 之后判：Docker Desktop 的容器跑在 WSL2 内核上，
# /proc/version 同样含 microsoft，只看这一条会把普通容器误判成 WSL
is_wsl() {
    [ -e /proc/sys/fs/binfmt_misc/WSLInterop ] && return 0
    [ -d /run/WSL ] && return 0
    grep -qi microsoft /proc/version 2>/dev/null
}

# 系统是否真的由 systemd 管。容器、以及 sysvinit/openrc 的机器上装 unit 是无效动作，
# 不能装完就宣布「已持久化」
has_systemd() {
    command -v systemctl >/dev/null 2>&1 || return 1
    [ -d /run/systemd/system ] || return 1
    return 0
}

# WSL 的 /etc/wsl.conf 里已配置的 [boot] command（没有则空串）。
# 只取第一条：WSL 只认一个 command=，写两行不会都执行
wsl_boot_command() {
    [ -f /etc/wsl.conf ] || return 0
    sed -n 's/^[[:space:]]*command[[:space:]]*=[[:space:]]*//p' /etc/wsl.conf | head -1
}

# 开机会不会重放 sysctl 配置。返回 0 表示会，非 0 表示写了也留不住。
# 判据按环境分开，不能只看某一条：
#   - WSL 必须先判（它的 /etc/rcS.d/S01procps 链接是发行版自带的，但 WSL 的 /init
#     不是 sysvinit，那个链接压根不会被执行，只看 rc 链接会误报「能持久化」）
#   - 容器由宿主决定，脚本管不了
# 本脚本生成的重放脚本有没有被挂进启动链。
# 与「开机会不会应用 sysctl.d」是两件不同的事，必须分开判——混成一件会得出
# 「procps 会跑 sysctl，所以我们的脚本在重放」这种错误结论（判例见 sysctl_replay_ok）
# [人工决策-2026-08-05 21:29:17] 不再宣称「已挂进启动链」这个事实——它无法被可靠判定，
# 六轮尝试全部被推翻，两条路各有不可消除的缺陷：
#   A) 扫启动配置 grep 脚本名：静态判断任意 shell 会不会执行某脚本要解析 shell 语义，
#      grep 做不到。被纯注释、行尾注释、不可执行的 .bak、`echo 那个名字` 逐一击穿
#   B) 看运行痕迹（时间戳 / uptime）：证明得了「跑过」，证明不了「配置还在」。
#      用户跑过一次后把 rc.local 删掉，本次 boot 内会一直误报已挂；而「开机 N 秒内
#      跑的」也分不清是 init 拉起还是用户刚开机就手动执行——固定阈值不解决这个歧义
# 结论：面板改为只陈述能确证的事，把不确定的部分交给用户判断。
# 于是本函数只回答「这台机器上，本脚本是否**可能**已挂进启动链」，用于决定措辞：
#   有运行痕迹 -> 说「检测到它在本次开机早期运行过，看起来已挂好；请自行确认配置还在」
#   无运行痕迹 -> 说「开机不会自动重放」并给出挂法
# 两种措辞都不断言「已持久化」。这样最坏情况是用户多确认一次，而不是被告知一件假事
# 戳里记的那个 uptime（供提示文案引用，让用户自己判断那次运行是不是 init 拉起的）
sysctl_apply_stamp_up() {
    local b u
    [ -f "$SYSCTL_APPLY_STAMP" ] || { echo "?"; return 0; }
    read -r b u _ <"$SYSCTL_APPLY_STAMP" 2>/dev/null
    case "${u:-x}" in '' | *[!0-9]*) echo "?" ;; *) echo "$u" ;; esac
}

# 本次开机的标识。boot_id 每次开机由内核重新生成，四类环境（WSL / Debian / Alpine /
# RHEL 容器）实测都可读。有它才能把「本次开机的记录」与「上次开机的」区分开，
# 而不必靠 uptime 大小去猜。
# [人工决策-2026-08-06 01:05:22] 替代标识必须是「重启后必然变化」的东西，
# 不能是任何基于时间的近似。两版被推翻的写法：
#   1) 比 uptime 大小：分不清开机——上次留下 uptime 5，本次开机 120 秒钩子还没跑，
#      5 <= 120 且 <= 300 仍为真，旧痕迹长期伪装成本次
#   2) 开机墙钟时刻 now-uptime + ±120 秒宽容：短命开机会被合并——上一轮开机只持续
#      40 秒就重启，两次的 at: 只差 40 秒，落在宽容窗口内仍判同一次开机。
#      宽容窗口是必需的（NTP 校时、时钟漂移），所以这条路本身就自相矛盾：
#      窗口够大才能容忍漂移，够小才能区分快速重启，两者不可兼得
# 现在的替代标识：在 tmpfs 上放一个随机 token。tmpfs 重启即清空，所以
# token 还在 == 同一次开机，token 没了 == 重启过。这是精确判据不是近似。
# 目录按 /run → /dev/shm → /tmp 依次尝试（前两个必为 tmpfs；/tmp 在部分发行版
# 也是 tmpfs，不是则退化为「跨重启仍存在」，那时宁可报未挂也不误报已挂，见下）
BOOT_TOKEN_DIRS="/run /dev/shm"
boot_ident() {
    local id d f tok
    id=$(cut -c1-36 /proc/sys/kernel/random/boot_id 2>/dev/null)
    if [ -n "$id" ]; then
        printf 'id:%s' "$id"
        return 0
    fi
    # 没有 boot_id：用 tmpfs 上的 token
    for d in $BOOT_TOKEN_DIRS; do
        # 必须确认这个目录真的是 tmpfs——不是的话 token 会跨重启留下来，
        # 那就等于没有判据（旧痕迹又会伪装成本次）
        case "$(stat -f -c %T "$d" 2>/dev/null)" in
        tmpfs | ramfs) ;;
        *) continue ;;
        esac
        [ -w "$d" ] || continue
        f="$d/.tcpo-boot-token"
        if [ -f "$f" ] && [ ! -L "$f" ]; then
            read -r tok _ <"$f" 2>/dev/null
            case "${tok:-x}" in '' | *[!0-9a-f]*) tok="" ;; esac
            [ -n "$tok" ] && {
                printf 'tok:%s' "$tok"
                return 0
            }
        fi
        # 本 boot 还没有 token：生成一个。用 /proc/sys/kernel/random/uuid，
        # 拿不到就退回 $$ 与 uptime 拼（同一 boot 内只生成一次，够用）
        tok=$(tr -dc 'a-f0-9' </proc/sys/kernel/random/uuid 2>/dev/null | cut -c1-32)
        [ -n "$tok" ] || tok=$(printf '%x%x' "$$" "$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)")
        [ -n "$tok" ] || continue
        [ -L "$f" ] && continue
        printf '%s\n' "$tok" >"$f" 2>/dev/null && {
            chmod 600 "$f" 2>/dev/null
            printf 'tok:%s' "$tok"
            return 0
        }
    done
    # 既没有 boot_id 也没有可用的 tmpfs：无法可靠区分开机，如实返回失败。
    # 调用方按「无法判定」处理——只会多提示一句挂法，不会误报已挂
    return 1
}

sysctl_apply_ran_at_boot() {
    [ -x "$SYSCTL_APPLY" ] || return 1
    # [人工决策-2026-08-05 23:05:41] 戳里记的必须是**本次开机内最早一次**运行的
    # uptime，且带 boot_id。原先每次运行都覆盖，于是钩子在开机 5 秒时成功跑过之后，
    # 用户同一 boot 内再手工跑一次，早期痕迹被覆盖成大 uptime，
    # sysctl_apply_ran_at_boot 立刻转假——一个其实挂得好好的启动链被报成
    # 「开机不会自动重放」，BBR 那边也跟着退回「重启回到 cubic」的错误结论。
    # 靠 uptime 大小区分开机新旧也不够（重启后 uptime 归零，旧记录反而更大，
    # 但同一 boot 内被覆盖的情况无从分辨），所以改为 boot_id + 只保留最早值
    local rec_ident rec_up cur_ident
    [ -f "$SYSCTL_APPLY_STAMP" ] || return 1
    # 文件格式：「<开机标识> <该 boot 内最早一次运行的 uptime 整秒> <人类可读时间>」
    # 开机标识形如 id:<boot_id> 或 at:<开机墙钟时刻>，见 boot_ident()
    read -r rec_ident rec_up _ <"$SYSCTL_APPLY_STAMP" 2>/dev/null || return 1
    case "${rec_up:-x}" in '' | *[!0-9]*) return 1 ;; esac
    # 标识取不到就是「无法判定」，按未挂处理——宁可多提示一句挂法，
    # 不可让上一次开机的痕迹伪装成本次
    cur_ident=$(boot_ident) || return 1
    [ -n "$cur_ident" ] || return 1
    boot_ident_same "$rec_ident" "$cur_ident" || return 1
    [ "$rec_up" -le "$HOOK_MAX_UPTIME" ]
}

# 两个开机标识是否指同一次开机。两种形式（id: 的 boot_id、tok: 的 tmpfs token）
# 都是「重启后必然变化」的精确值，所以一律要求逐字相等——不再有任何宽容窗口。
# 形式不同视为不同：那说明判据来源变了（比如内核换了、tmpfs 挂载变了），无从比较
boot_ident_same() {
    [ -n "$1" ] && [ "$1" = "$2" ]
}

# 开机会不会重新应用 /etc/sysctl.d/*.conf。
# 注意它只管 sysctl 这一件事：BBR 是模块时还要有人 modprobe（/etc/modules-load.d
# 只有 systemd 读），所以调用方不能拿它当「BBR 也会恢复」的依据
sysctl_replay_ok() {
    has_systemd && return 0
    # 容器的持久化由宿主决定，脚本管不了
    is_container && return 1
    # 我们自己的重放脚本在本次开机早期运行过 —— 它内部就是 modprobe + sysctl --system。
    # 这只是「看起来挂好了」的迹象，不是确证（配置可能在那之后被删），
    # 所以调用方的措辞必须留有余地，不能说成「已持久化」
    sysctl_apply_ran_at_boot && return 0
    if is_wsl; then
        # WSL 的 /init 不是 sysvinit：发行版自带的 rc 链接压根不会被执行，
        # 所以除了上面那条（用户挂了我们的脚本）之外一律判「不会重放」
        return 1
    fi
    # sysvinit：Debian 系 procps 包的 rcS 链接会跑 sysctl --system
    [ -x /etc/init.d/procps ] && ls /etc/rc[S2].d/S*procps >/dev/null 2>&1 && return 0
    # openrc（Alpine / Gentoo）：sysctl 服务加入 boot runlevel 后会应用 /etc/sysctl.d/*.conf。
    # 判据是 runlevel 链接真的存在，不是「服务脚本存在」——脚本是包自带的，
    # 没 rc-update add 就不会跑（Alpine 默认不 add，实测 /etc/runlevels/boot 是空的）
    [ -e /etc/runlevels/boot/sysctl ] || [ -e /etc/runlevels/sysinit/sysctl ] ||
        [ -e /etc/runlevels/default/sysctl ]
}

# 开机会不会加载 tcp_bbr 模块。与 sysctl 分开判：
# /etc/modules-load.d 只有 systemd 读，无 systemd 机器上光靠 sysctl 重放不够——
# 模块没加载时内核会直接拒绝 tcp_congestion_control=bbr，重启后静默回到 cubic。
# 判例：sysvinit 机器上 procps 会重放 sysctl，据此报「已持久化」，但 BBR 实际没恢复
bbr_reload_ok() {
    # 内建（非模块）时不需要任何人加载。判据是 tcp_bbr 出现在 modules.builtin，
    # 不能用「/sys/module/tcp_bbr 存在但没有 initstate」——那个目录在模块已加载时
    # 同样存在，且部分内核对内建项也给 initstate，两种情况分不开
    grep -qE '(^|/)tcp_bbr\.ko' "/lib/modules/$(uname -r)/modules.builtin" 2>/dev/null && return 0
    # [人工决策-2026-08-05 16:58:33] 判据必须是「开机时谁会加载它」，不是
    # 「现在可用列表里有没有 bbr」。available 含 bbr 只说明本次会话里模块已加载
    # （可能是手工 modprobe、或本面板刚 modprobe 的），与下次开机毫无关系。
    # 旧写法在「模块已临时加载 + 没有任何持久化配置」时报「开机可恢复」，
    # 而重启后无人加载、静默回到 cubic——正是本函数要防的那个假报
    if has_systemd; then
        # systemd 读 /etc/modules-load.d/*.conf 与 /etc/modules（后者由 kmod 的
        # systemd-modules-load 兼容读取）。必须确认文件真的在且内容对：
        # 写入可能失败（只读 /etc、磁盘满），也可能被用户或别的工具删掉
        modules_load_has_bbr && return 0
        return 1
    fi
    # 无 systemd：/etc/modules 里写着就是确证（Debian 系 kmod 会读它）
    grep -qE '^[[:space:]]*tcp_bbr[[:space:]]*$' /etc/modules 2>/dev/null && return 0
    # [人工决策-2026-08-05 22:14:33] 重放脚本在本次开机早期跑过也要算进来（返回 2）。
    # 上一轮把它排除是错的：那个脚本开机时会先 modprobe tcp_bbr 再 sysctl --system，
    # 所以它确实解决了模块加载。用户按提示挂好之后，面板仍报「重启后静默回到 cubic」
    # 并再次让他生成/挂载脚本——稳定的假阴性，且提示自相矛盾（那个脚本就是干这个的）。
    # 但也不能当成完全确证：痕迹证明不了那段启动配置现在还在。
    # 所以用第三种返回值：0=确证、2=有迹象但需用户核实、1=没有任何依据。
    # 调用方据此给三套措辞，而不是把「有迹象」硬归到确证或否定的任一边
    sysctl_apply_ran_at_boot && return 2
    return 1
}

# /etc/modules-load.d/*.conf 或 /etc/modules 里是否真的写着 tcp_bbr。
# 单独成函数是因为「写了没有」与「写成功了没有」要在两处用：enable_bbr 落盘后要验，
# bbr_reload_ok 判开机能否恢复时也要验。只看我们自己那个文件不够——
# 用户可能把它写在别的 .conf 里，那也算有效
modules_load_has_bbr() {
    local f
    # [人工决策-2026-08-05 18:31:44] 只查 *.conf，不能对整个目录递归 grep：
    # systemd 明文规定「Files must have the ".conf" extension」(man 5 modules-load.d)，
    # 所以 bbr.conf.bak、.dpkg-old、编辑器临时文件里的 tcp_bbr 开机不会被读。
    # 递归 grep 会把这类备份文件当成「开机会自动加载」，于是 BBR 仍被误报为可恢复。
    # [人工决策-2026-08-05 19:20:38] 只查 /etc 与 /usr/lib，不查 /run：
    # /run 是 tmpfs（实测 findmnt -no FSTYPE /run 为 tmpfs），重启即清空。
    # 那里有配置只证明「本次 boot 有人临时放过」，不证明「下次开机还会加载」——
    # 拿它当持久化依据会把临时文件误报成 BBR 可持久恢复
    # [人工决策-2026-08-05 20:31:05] 目录清单以 systemd-modules-load 二进制里的路径
    # 字符串为准，不以 man 的 SYNOPSIS 为准——SYNOPSIS 只列了 /etc、/run、/usr/lib
    # 三个，但同一页 DESCRIPTION 正文写着「Files in /etc/ override files with the same
    # name in /run/, /usr/local/lib/, and /lib/」，而 strings 二进制确认搜索路径是五个：
    # /etc、/run、/usr/local/lib、/usr/lib、/lib。
    # 漏掉 /usr/local/lib 的后果是：tcp_bbr 由那里提供时会被误判成「开机没人加载」，
    # 于是菜单 2/3/4 报错误告警、还多生成一份不需要的重放脚本与挂载提示。
    # /lib 通常是 /usr/lib 的符号链接，但不能假定（有发行版不做 usr-merge），一并查
    for f in /etc/modules-load.d/*.conf /usr/local/lib/modules-load.d/*.conf \
        /usr/lib/modules-load.d/*.conf /lib/modules-load.d/*.conf; do
        [ -f "$f" ] || continue
        grep -qE '^[[:space:]]*tcp_bbr[[:space:]]*$' "$f" 2>/dev/null && return 0
    done
    # /etc/modules 是 Debian 系 kmod 的清单（systemd 的 systemd-modules-load 也会读），
    # 它是单个文件、没有扩展名约定，直接查
    grep -qE '^[[:space:]]*tcp_bbr[[:space:]]*$' /etc/modules 2>/dev/null
}

# 无 systemd 环境的开机重放脚本。
# [人工决策-2026-08-05 14:22:07] 三个方案里选「生成兜底脚本 + 告知挂法」，不选
# 「只提示不生成」也不选「新增菜单项自动挂」：
#   - 只提示的话用户得自己写这个脚本，而正确写法有坑（modprobe 要在 sysctl 之前，
#     否则 BBR 是模块时 tcp_congestion_control=bbr 会被内核直接拒绝）
#   - 自动挂要改 wsl.conf 或 rc 目录，那会改变整个发行版的启动方式，超出「网络参数」
#     范畴，也不再是「文件级可完整回退」——与项目边界冲突
# 所以只把东西备好、挂哪由用户决定。这是本项目「不越界」与「别让用户自己踩坑」的折中
write_sysctl_apply() {
    # 重定向失败（目标只读 / 磁盘满 / 目录不存在）的报错由 shell 打印到 stderr、
    # 退出码却容易被忽略。必须包住整个复合命令才吞得掉那行裸报错，并自己给归属明确的提示，
    # 否则用户只看到一行 "cannot create" 不知道是谁在写什么
    # 必须先查链接：这里写的是一个 root 执行的可执行脚本，跟着链接写出去等于
    # 让本脚本以 root 覆盖任意文件。已复现：把 $SYSCTL_APPLY 预先链到别处，
    # 目标文件会被整份改成启动脚本内容而函数仍返回 0。
    # [人工决策-2026-08-05 16:22:41] 这是安全问题而非假成功提示，优先级高于其余写入点
    refuse_if_symlink "$SYSCTL_APPLY" || return 1
    if ! { cat >"$SYSCTL_APPLY" <<APPLYEOF
#!/bin/bash
# 由 tcpo 生成：无 systemd 环境（WSL / sysvinit / 容器）里开机重放网络调优。
# systemd 机器不需要它——systemd-sysctl 会自动应用 /etc/sysctl.d/*.conf。
# 先 modprobe 再应用参数：BBR 是模块时，/etc/modules-load.d 在无 systemd 环境
# 同样没人读，不先加载模块的话 tcp_congestion_control=bbr 会被内核直接拒绝。
# 条件是「本脚本管的任一配置文件里写了 bbr」而不是「$BBR_OPT 存在」——菜单 3/4
# 把 bbr 写进主配置文件，那时 $BBR_OPT 并不存在，只看它会漏掉这条最常见的路径
for _c in $BBR_OPT $SYSCTL_OPT; do
    [ -f "\$_c" ] && grep -qE '^[[:space:]]*net\.ipv4\.tcp_congestion_control[[:space:]]*=[[:space:]]*bbr' "\$_c" 2>/dev/null && {
        modprobe tcp_bbr 2>/dev/null
        break
    }
done
# 这里不经 apply_sysctl（面板里的 sysctl --system 一律走那个入口以便回显内核报错）：
# 本脚本在开机时跑、没有终端可回显，且是独立文件调不到面板的函数。
# 输出落日志供事后排查，别丢掉
sysctl --system >>$APPLY_LOG 2>&1
# 菜单 5 的 /sys 队列设置（RPS/RFS/XPS）也一并重放，省得再挂第二个钩子
[ -x $NIC_APPLY ] && $NIC_APPLY
# 记录「本次开机 + 该 boot 内最早一次运行的 uptime」。面板据此判断本脚本是否被挂进
# 启动链：uptime 很小 => 是 init 在开机早期自动拉起的；很大 => 是谁手工跑的。
# 关键是**只保留最早那次**：同一 boot 内已有记录就不覆盖。
# 覆盖式写法有判例——钩子在开机 5 秒时跑过，用户之后手工再跑一次，早期痕迹被覆盖成
# 大 uptime，面板于是把挂得好好的启动链报成「开机不会自动重放」，BBR 也跟着报错结论
mkdir -p $STATE_DIR 2>/dev/null
# 开机标识：优先 boot_id（id:...），读不到就用 tmpfs 上的随机 token（tok:...）。
# 与面板侧 boot_ident() 必须同格式、同来源——两边不一致的话记录永远比不上。
# 不用「开机墙钟时刻」那种近似判据：短命开机（上一轮只跑几十秒就重启）会被合并成
# 同一次，旧痕迹于是伪装成本次已挂；而 tmpfs 重启即清空，token 在不在是精确判据
_up=\$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 999999)
_bid=\$(cut -c1-36 /proc/sys/kernel/random/boot_id 2>/dev/null)
_ident=""
if [ -n "\$_bid" ]; then
    _ident="id:\$_bid"
else
    for _d in /run /dev/shm; do
        case "\$(stat -f -c %T "\$_d" 2>/dev/null)" in tmpfs | ramfs) ;; *) continue ;; esac
        [ -w "\$_d" ] || continue
        _f="\$_d/.tcpo-boot-token"
        [ -L "\$_f" ] && continue
        if [ -f "\$_f" ]; then
            read -r _tok _ <"\$_f" 2>/dev/null
            case "\${_tok:-x}" in '' | *[!0-9a-f]*) _tok="" ;; esac
        else
            _tok=""
        fi
        if [ -z "\$_tok" ]; then
            _tok=\$(tr -dc 'a-f0-9' </proc/sys/kernel/random/uuid 2>/dev/null | cut -c1-32)
            [ -n "\$_tok" ] || _tok=\$(printf '%x%x' "\$\$" "\$_up")
            printf '%s\n' "\$_tok" >"\$_f" 2>/dev/null && chmod 600 "\$_f" 2>/dev/null
        fi
        [ -n "\$_tok" ] && { _ident="tok:\$_tok"; break; }
    done
fi
# 标识拿不到就不写记录：写个无法比对的标识只会让面板永远判「非本次开机」，
# 不如不写——面板那边会如实说「开机不会自动重放」并给出挂法
[ -n "\$_ident" ] || exit 0
_old_ident=""; _old_up=""
[ -f $SYSCTL_APPLY_STAMP ] && read -r _old_ident _old_up _ <$SYSCTL_APPLY_STAMP 2>/dev/null
case "\${_old_up:-x}" in '' | *[!0-9]*) _old_up="" ;; esac
# 该写还是该保留旧值：
#   没有旧记录 -> 写
#   旧记录与本次是同一次开机 -> 保留（旧的那次更早）
#   不是同一次开机 -> 写（旧痕迹必须让位，否则上次开机的 uptime 5 会长期
#   伪装成本次已挂——判例：无 boot_id 环境下靠「uptime 谁小」判断做不到这一点）
# 两种标识（id: / tok:）都是重启后必然变化的精确值，一律逐字相等才算同一次开机。
# 不留任何宽容窗口——窗口够大才能容忍时钟漂移、够小才能区分快速重启，不可兼得
_same=0
if [ -n "\$_old_up" ] && [ -n "\$_old_ident" ] && [ "\$_old_ident" = "\$_ident" ]; then
    _same=1
fi
_write=1
[ "\$_same" = 1 ] && _write=0
if [ "\$_write" = 1 ]; then
    # 原子写：先落同目录临时文件再 rename，且拒绝跟随符号链接。
    # 这个文件在开机时由 root 写，裸重定向遇到预置的符号链接会覆写链接目标；
    # 半写入还会让「保留本 boot 最早痕迹」的判据变脆（读到空/半行就当没记录）
    if [ -L $SYSCTL_APPLY_STAMP ]; then
        : # 是符号链接：不跟着写出去，也不删用户的链接，直接放弃本次记录
    else
        _tmp=\$(mktemp $STATE_DIR/.stamp.XXXXXX 2>/dev/null) && {
            printf '%s %s %s\n' "\$_ident" "\$_up" "\$(date '+%F %T' 2>/dev/null)" \\
                >"\$_tmp" 2>/dev/null &&
                chmod 644 "\$_tmp" 2>/dev/null &&
                mv -f "\$_tmp" $SYSCTL_APPLY_STAMP 2>/dev/null || rm -f "\$_tmp" 2>/dev/null
        }
    fi
fi
# 恒为 0：开机脚本失败不该拖住启动流程，最坏情况停在「参数没生效」
exit 0
APPLYEOF
    } 2>/dev/null; then
        echo -e "  ${RED}无法写入 $SYSCTL_APPLY（只读挂载 / 磁盘满 / 目录不存在）${NC}"
        return 1
    fi
    if ! chmod 755 "$SYSCTL_APPLY"; then
        echo -e "  ${YELLOW}给 $SYSCTL_APPLY 加可执行位失败，请手动 chmod 755${NC}"
        return 1
    fi
    return 0
}

# 「重放脚本挂到哪」的说明。菜单 2/3/4 与菜单 5 都要打印，提出来共用一份，
# 免得两处文案漂移（一处教对了、另一处还在教旧办法）
# 「看起来已挂好」时给出「怎么自己核实一遍」的具体命令。
# 不替用户下结论，只告诉他去看哪里——那段配置还在不在，只有看配置本身才知道
wsl_boot_hint_verify() {
    if is_wsl; then
        local cur
        cur=$(wsl_boot_command)
        # 只把 wsl.conf 里那行**原样打出来**让用户自己看，不替他判断里面有没有。
        # wsl.conf 是结构化配置（不是任意 shell），把原文摊开是有意义的信息；
        # 但那行到底会不会执行本脚本仍要用户自己认（`command=/bin/echo xxx.sh` 就不会）
        if [ -n "$cur" ]; then
            echo -e "  ${CYAN}参考: /etc/wsl.conf 的 [boot] command 现在是${NC}"
            echo -e "        command=$cur"
        else
            echo -e "  ${YELLOW}参考: /etc/wsl.conf 里当前没有 [boot] command${NC}"
        fi
    fi
    # [人工决策-2026-08-05 22:14:33] 不给 grep 启动目录那条命令：面板自己已经因为
    # 「文本匹配不可靠」放弃了那个判据（注释、示例字符串、备份文件都会命中，
    # 换个挂法又会漏），把同一套不可靠判据当作「自己核实的办法」推给用户，
    # 只是把误导转移了一层。
    # 改为给一条真正能验的办法：重启后回来看这台机器的参数还在不在——
    # 那是「开机会不会自动重放」的定义本身，不需要任何推测
    echo -e "  ${CYAN}核实办法（唯一可靠的）：重启这台机器，然后回到本面板看状态${NC}"
    echo -e "  ${CYAN}    菜单 3/4 显示 ${GREEN}[保守档]${CYAN}/${GREEN}[中转档]${CYAN} 就是真的重放了；${NC}"
    echo -e "  ${CYAN}    显示 ${YELLOW}[配置未生效]${CYAN} 说明没重放，那段启动配置得再查${NC}"
    echo -e "  ${CYAN}    也可直接比一条: sysctl -n net.core.rmem_max（重启后应仍是调优值）${NC}"
    return 0
}

wsl_boot_hint() {
    if ! is_wsl; then
        echo -e "  ${CYAN}请把 $SYSCTL_APPLY 挂到你的 init 流程（sysvinit 可放进 /etc/rc.local）${NC}"
        return 0
    fi
    local cur
    cur=$(wsl_boot_command)
    echo -e "  ${CYAN}WSL 挂载办法：编辑 /etc/wsl.conf 的 [boot] 段${NC}"
    if [ -n "$cur" ]; then
        # [人工决策-2026-08-05 14:22:07] 已有 command= 时给串联写法而不是让用户再加一行：
        # WSL 只认第一条 command，加第二行会静默把用户原有的开机命令顶掉。
        # 实测机器上就有一条 zram_swap.sh，照抄「新增一行」会让 zram swap 消失
        echo -e "  ${YELLOW}    注意：已有 command=$cur，WSL 只认一条，别再加一行${NC}"
        # 原命令要塞进单引号里，所以必须先把其中的单引号转义成 '\''。
        # 判例：cur=/bin/sh -c 'echo hi' 时，不转义会生成
        #   command=/bin/sh -c '/bin/sh -c 'echo hi'; ...'
        # 引号在此断裂，实测两段都不执行——本意是「保留原命令」，结果是给出一条
        # 不可用且会改坏用户启动配置的指令
        local esc
        esc=$(printf '%s' "$cur" | sed "s/'/'\\\\''/g")
        echo -e "  ${CYAN}    改成串联: command=/bin/sh -c '$esc; $SYSCTL_APPLY'${NC}"
        case "$cur" in
        *\'*)
            # 原命令本身带引号时，串联写法会变得很难读。给一条等价且不必转义的替代：
            # 自己写个小脚本按顺序调两者，command= 只指向那个脚本
            echo -e "  ${YELLOW}    原命令含单引号，上面已按 shell 规则转义；${NC}"
            echo -e "  ${YELLOW}    若看不顺眼可改为自建一个脚本依次调用两者，command= 只写那个脚本${NC}"
            ;;
        esac
    else
        echo -e "  ${CYAN}    [boot]${NC}"
        echo -e "  ${CYAN}    command=$SYSCTL_APPLY${NC}"
    fi
    echo -e "  ${CYAN}    改完在 Windows 侧执行 wsl --shutdown 重启本发行版${NC}"
    echo -e "  ${CYAN}  或改用 systemd（一次到位，菜单 5 的开机单元也会随之可用）：${NC}"
    echo -e "  ${CYAN}    同一段写 systemd=true，注意开了 systemd 后 command= 的行为需自行验证${NC}"
    return 0
}

# 「sysctl 会重放」不等于「BBR 会回来」：BBR 是模块时得先有人 modprobe，
# 而 /etc/modules-load.d 只有 systemd 读。模块没加载时内核直接拒绝
# tcp_congestion_control=bbr，重启后静默回到 cubic——而 sysctl 那边全绿。
# [人工决策-2026-08-05 15:47:12] 判例：sysvinit 机器上 procps 会重放 /etc/sysctl.d，
# 早期版本据此报「已持久化」，但 BBR 实际没恢复。所以模块与参数必须分别核实、分别报
# 写 tcp_bbr 的开机加载配置。返回 0 = 已落地（或演练模式跳过），非 0 = 没写成。
#
# 抽成函数是因为两处都要用：菜单 2（enable_bbr）本来就写它，而菜单 3/4 也把
# tcp_congestion_control=bbr 写进了主配置——那时如果 tcp_bbr 是模块且开机没人加载，
# 重启后内核会静默拒绝 bbr、回到 cubic。
# [人工决策-2026-08-05 22:41:09] 菜单 3/4 从「只给人工命令」改为「自动补齐」：
# 它们已经在写 tcp_congestion_control=bbr 了，不配齐模块加载等于写了一个重启就失效的
# 参数——那本身就不自洽。$BBR_MODLOAD 已在菜单 6 的清理清单里，可完整回退。
# 三个判例都记在这里，别再退回裸重定向：
#   1) 只在「available 里没有 bbr」时写 —— 模块已被手工 modprobe 的机器走不到，
#      于是永远没有持久化配置，重启回 cubic
#   2) echo 重定向不查返回值 —— 只读 /etc 或磁盘满时只往 stderr 报一行、退出码被丢，
#      面板照样报「已持久化」
#   3) 裸重定向绕过 atomic_write —— 这条路径被预置成符号链接时会以 root 跟着写出去，
#      属实际的任意文件覆盖；本项目的最坏边界是「参数没生效」
write_bbr_modload() {
    dryrun_skip "写 $BBR_MODLOAD" && return 0
    if printf 'tcp_bbr\n' | atomic_write "$BBR_MODLOAD" &&
        grep -qE '^[[:space:]]*tcp_bbr[[:space:]]*$' "$BBR_MODLOAD" 2>/dev/null; then
        return 0
    fi
    return 1
}

bbr_persist_note() {
    # 只有本次确实写了 BBR 配置才需要交代模块的事。
    # 判据不能只看 $BBR_OPT：菜单 3/4 把 tcp_congestion_control=bbr 写进主配置文件，
    # 那时 $BBR_OPT 并不存在，于是「只跑菜单 3」的用户在无 systemd 环境下
    # 拿不到任何模块加载的提示，重启后 bbr 被内核静默拒绝、回到 cubic。
    # [人工决策-2026-08-05 16:41:07] 改为「本次写的文件或任一受管文件里含 bbr」
    if [ "$1" != "$BBR_OPT" ] && [ ! -f "$BBR_OPT" ]; then
        # 本次写的那个文件里有 bbr 吗
        [ -n "$1" ] && [ -f "$1" ] &&
            grep -qE '^[[:space:]]*net\.ipv4\.tcp_congestion_control[[:space:]]*=[[:space:]]*bbr' "$1" 2>/dev/null ||
            return 0
    fi
    # 三态：0=确证有人加载、2=有迹象（重放脚本本次开机早期跑过，它内含 modprobe）、
    # 其他=没有任何依据。「有迹象」不能报成「没人加载」——那与面板刚给的挂法自相矛盾
    bbr_reload_ok
    case $? in
    0) return 0 ;;
    2)
        echo -e "  ${CYAN}tcp_bbr 是内核模块。$(basename "$SYSCTL_APPLY") 在本次开机早期运行过，${NC}"
        echo -e "  ${CYAN}它会先 modprobe tcp_bbr 再应用 sysctl，所以 BBR 看起来能随开机恢复${NC}"
        echo -e "  ${YELLOW}同上：这是运行痕迹而非确证。若想要一个与本面板无关的保底，${NC}"
        echo -e "  ${YELLOW}可把 tcp_bbr 单独写进 /etc/modules（Debian 系 kmod 开机会读它）${NC}"
        return 0
        ;;
    esac
    echo -e "  ${YELLOW}但 tcp_bbr 是内核模块，开机没有人加载它——模块未加载时内核会拒绝${NC}"
    echo -e "  ${YELLOW}tcp_congestion_control=bbr，于是重启后静默回到 cubic（sysctl 那边看不出问题）${NC}"

    # 补救办法必须按「本机由谁负责开机加载模块」分流。
    # [人工决策-2026-08-05 21:07:44] 原先不分 systemd 与否，一律生成 $SYSCTL_APPLY
    # 并调 wsl_boot_hint。但那套「脚本 + 自己挂进启动链」只对无 systemd 的机器成立：
    # systemd 机器上没人会去执行那个脚本，提示等于让用户照着做也不生效，
    # 而真正的问题是 modules-load.d 没配好——给错方向的 remediation 比不给更糟。
    if has_systemd; then
        # systemd 机器的正解是写 modules-load.d，由 systemd-modules-load 在开机时读。
        # 直接补齐而不是只给命令：菜单 3/4 已经把 tcp_congestion_control=bbr 写进主配置了，
        # 不配齐模块加载等于写了一个重启就失效的参数，那本身不自洽。
        # 该文件在菜单 6 的清理清单里，可完整回退
        if write_bbr_modload; then
            echo -e "  ${GREEN}已补写 $BBR_MODLOAD${NC}（让 systemd-modules-load 开机加载 tcp_bbr）"
            return 0
        fi
        echo -e "  ${RED}补写 $BBR_MODLOAD 失败（只读 /etc、磁盘满，或该路径是符号链接）${NC}"
        echo -e "  ${YELLOW}手动补: echo tcp_bbr > $BBR_MODLOAD${NC}"
        return 1
    fi

    # 无 systemd：那份重放脚本才是有效手段，它会先 modprobe 再应用 sysctl
    if write_sysctl_apply; then
        echo -e "  ${GREEN}已生成 $SYSCTL_APPLY${NC}（它会先 modprobe tcp_bbr 再应用 sysctl）"
        wsl_boot_hint
    else
        # 兜底：脚本写不出来时至少给出 /etc/modules 这条不依赖本脚本的办法
        echo -e "  ${YELLOW}请把 tcp_bbr 加进 /etc/modules（Debian 系 sysvinit 会读它）${NC}"
    fi
    return 1
}

# 菜单 2/3/4 写完配置后统一调这里报持久化状态，禁止各自打印「已持久化」。
# 能重放就照常说，不能就如实说「本次有效、开机不会自动重放」并按环境给出具体办法。
# 措辞必须指名道姓说清是谁在重放：报错的机制会让用户去查错的地方
report_sysctl_persist() {
    local conf=$1
    if has_systemd; then
        # 顺序要紧：先核 BBR 模块的事，再下持久化结论。
        # [人工决策-2026-08-05 22:52:17] 原先先打印绿色「配置持久化于」再调
        # bbr_persist_note，于是「已持久化」和随后「重启会回到 cubic」同屏出现、自相矛盾。
        # 现在 bbr_persist_note 会自动补齐 modules-load.d，补上了才报绿；
        # 补不上就降级成黄字——结论必须与实际状态一致
        if bbr_persist_note "$conf"; then
            echo -e "  ${GREEN}配置持久化于 $conf（开机由 systemd-sysctl 重放）${NC}"
        else
            echo -e "  ${YELLOW}配置已写入 $conf（开机由 systemd-sysctl 重放），但 BBR 那一项见上${NC}"
        fi
        return 0
    fi
    # 我们的重放脚本在本次开机早期跑过：这是「看起来挂好了」的迹象，不是确证。
    # [人工决策-2026-08-05 21:29:17] 措辞必须留有余地，不能说成「已持久化」——
    # 判例：用户跑过一次后把 rc.local 里那行删掉，本次 boot 内运行痕迹还在，
    # 但下次开机不会再重放；「配置还在不在」无法从运行痕迹推出来。
    # 同样也分不清那次早期运行是 init 拉起还是用户刚开机就手动执行的。
    # 所以只陈述观测到的事实 + 让用户自己确认一句，把判断权交回去
    if sysctl_apply_ran_at_boot; then
        # 脚本仍要重写一遍：挂着的可能是旧版本，或路径被换过
        if write_sysctl_apply; then
            echo -e "  ${GREEN}配置已写入 $conf，本次已生效${NC}"
            echo -e "  ${CYAN}检测到 $(basename "$SYSCTL_APPLY") 在本次开机早期运行过（uptime $(sysctl_apply_stamp_up)s），看起来已挂进启动链${NC}"
            echo -e "  ${YELLOW}这只是运行痕迹，不能证明那段配置现在还在——请确认后再当作已持久化${NC}"
            wsl_boot_hint_verify
            bbr_persist_note "$conf"
            return 0
        fi
        echo -e "  ${RED}开机重放脚本 $SYSCTL_APPLY 写入失败，重启后配置会失效${NC}"
        return 1
    fi
    # 没挂我们的脚本，但发行版自带的机制会应用 /etc/sysctl.d（sysvinit 的 procps、
    # openrc 的 sysctl 服务）。这条必须与上一条分开说：那时重放的不是我们的脚本，
    # 说成「由 tcp-dashboard-sysctl-apply.sh 重放」会让用户以为脚本已挂好（实测判例）。
    # 且它只管 sysctl，模块加载要另外交代，所以下面 bbr_persist_note 仍会核一遍
    if sysctl_replay_ok; then
        echo -e "  ${GREEN}配置持久化于 $conf${NC}${YELLOW}（开机由本机自带的 sysctl 服务重放，非本面板的脚本）${NC}"
        bbr_persist_note "$conf"
        return 0
    fi

    echo -e "  ${YELLOW}配置已写入 $conf，本次已生效${NC}"
    if is_container; then
        # 容器里多数 net.* 本来就不在命名空间内，持久化由宿主决定，写脚本没意义
        echo -e "  ${YELLOW}但本机是容器，开机不会重放 /etc/sysctl.d/，且多数参数由宿主内核决定${NC}"
        echo -e "  ${YELLOW}要持久化请在宿主上设置，或用 docker run --sysctl 逐项传入${NC}"
        return 1
    fi
    echo -e "  ${YELLOW}但本机没有 systemd，开机不会有人读 /etc/sysctl.d/，重启后回到原值${NC}"
    write_sysctl_apply || return 1
    echo -e "  ${GREEN}已生成开机重放脚本 $SYSCTL_APPLY${NC}（sysctl + BBR 模块 + 网卡队列一并重放）"
    wsl_boot_hint
    # 这条分支也要交代 BBR：它是「什么都没挂」的情况，模块加载的提醒在这里最要紧。
    # 漏掉的话只跑菜单 3（bbr 写进主配置文件）的用户拿不到任何模块相关提示
    bbr_persist_note "$conf"
    return 1
}

# 取内核当前值与目标值中的较大者，即红帽 tuned 的 "=>"（只升不降）语义。
# 直接赋值的写法会在内核默认值抬高后把参数写回旧值——社区脚本里 tcp_rmem 中间值
# 常年停在 87380 就是这么来的。对「容量类」参数（缓冲区/队列/句柄）一律走这里
sysctl_ceil() {
    local key=$1 want=$2 cur
    cur=$(sysctl -n "$key" 2>/dev/null)
    case "$cur" in
    '' | *[!0-9]*) echo "$want"; return ;;
    esac
    [ "$cur" -gt "$want" ] && echo "$cur" || echo "$want"
}

# 三元组（tcp_rmem/tcp_wmem）逐字段取较大者
sysctl_ceil3() {
    local key=$1 w1=$2 w2=$3 w3=$4 cur c1 c2 c3
    cur=$(sysctl -n "$key" 2>/dev/null | tr -s ' \t' ' ')
    read -r c1 c2 c3 <<<"$cur"
    case "$c1$c2$c3" in
    '' | *[!0-9]*) echo "$w1 $w2 $w3"; return ;;
    esac
    [ "$c1" -gt "$w1" ] && w1=$c1
    [ "$c2" -gt "$w2" ] && w2=$c2
    [ "$c3" -gt "$w3" ] && w3=$c3
    echo "$w1 $w2 $w3"
}

# 本脚本可能改动的全部 sysctl key。回退要按这份清单逐个还原运行时值——
# 删掉配置文件再 sysctl --system 是不够的：sysctl 只应用「文件里还写着的」值，
# 对「文件里已经没有的」key 不做任何事，运行时值会原样留着。
# 中转档的 ip_forward 留在 1 尤其是安全问题（机器仍在当路由器转包）
MANAGED_KEYS="
net.ipv4.tcp_congestion_control
net.core.default_qdisc
net.core.somaxconn
net.core.netdev_max_backlog
net.core.netdev_budget
net.core.netdev_budget_usecs
net.core.rmem_max
net.core.wmem_max
net.core.rps_sock_flow_entries
net.ipv4.tcp_max_syn_backlog
net.ipv4.tcp_syncookies
net.ipv4.ip_local_port_range
net.ipv4.ip_local_reserved_ports
net.ipv4.tcp_rmem
net.ipv4.tcp_wmem
net.ipv4.tcp_notsent_lowat
net.ipv4.tcp_mtu_probing
net.ipv4.udp_rmem_min
net.ipv4.tcp_slow_start_after_idle
net.ipv4.tcp_no_metrics_save
net.ipv4.tcp_tw_reuse
net.ipv4.tcp_fin_timeout
net.ipv4.tcp_fastopen
net.ipv4.ip_forward
"

# 目标是符号链接时拒绝写入。返回 0 = 可以写，1 = 拒绝。
#
# 场景确实罕见（正常系统上 /etc/sysctl.d/zz-tcpo.conf 这种自有文件名不会是链接），
# 但处置方式值得明确：
#   - 跟着链接写出去，内容会落到一个我们没预期的位置（可能是共享挂载、可能是 /dev/null，
#     后者是 systemd 官方推荐的「禁用某个 vendor 配置」的做法）；
#   - 删掉链接再写，等于替用户做了个他没同意的决定，而且那个链接可能是他自己建的。
# 所以两个都不做，直接拒绝并把情况说清楚，让用户自己确认那个目标是不是他想改的。
# [人工决策-2026-08-05 13:47:12] 取「拒绝」而非「跟随」或「删除」：本项目最坏情况
# 必须停在「参数没生效」，而跟随链接写出去可能改到完全无关的文件——那超出了最坏边界
refuse_if_symlink() {
    local target=$1 dst
    [ -L "$target" ] || return 0
    dst=$(readlink -f "$target" 2>/dev/null || readlink "$target" 2>/dev/null)
    echo -e "  ${RED}拒绝写入：$target 是符号链接${NC}" >&2
    echo -e "  ${RED}  -> ${dst:-（目标无法解析，可能是悬空链接）}${NC}" >&2
    echo -e "  ${YELLOW}  本脚本不跟着链接写出去，也不删你的链接。请自行确认那个目标是不是你想改的，${NC}" >&2
    echo -e "  ${YELLOW}  确认后手动处理再重跑。本次未对该文件做任何改动${NC}" >&2
    return 1
}

# 从 stdin 读内容，原子写入目标文件（先落临时文件再 mv）。
#
# 为什么状态文件必须这么写：直接 `{ ... } >"$FILE"` 会先把目标截断成 0 字节再逐步写入，
# 磁盘满 / 进程被 SIGKILL / OOM 时目标就停在空文件或半截内容上。而 $ORIG_STATE 和
# $TAKEOVER_LIST 是回退的唯一依据——它们变空等于回退能力归零，机器被永久留在改过的状态。
# 本项目的优先级是「可回退性 > 正确性 > 效果」，所以这两个文件不能用直接重定向。
# mv 在同一文件系统内是 rename(2)，原子：要么是旧内容要么是新内容，不会有中间态。
# 临时文件必须建在目标同目录，跨设备 mv 会退化成 copy+unlink 从而失去原子性
atomic_write() {
    local target=$1 dir tmp
    refuse_if_symlink "$target" || return 1
    dir=$(dirname "$target")
    mkdir -p "$dir" || return 1
    tmp=$(mktemp "$dir/.tcpo.XXXXXX") || return 1
    if ! cat >"$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    # chmod 在 mv 之前：mv 之后再改会有一个短暂的宽权限窗口
    chmod 644 "$tmp" 2>/dev/null
    if ! mv -f "$tmp" "$target"; then
        rm -f "$tmp"
        return 1
    fi
    return 0
}

# 追加一行到文件，同样保证不会因中途失败留下半截文件。
# 追加本身在小于 PIPE_BUF 时基本原子，但「读旧内容 + 写新内容」的组合不是，
# 所以走同一条 atomic_write 路径：把旧内容和新行一起重写
atomic_append() {
    local target=$1 line=$2
    {
        [ -f "$target" ] && cat "$target"
        printf '%s\n' "$line"
    } | atomic_write "$target"
}

# 快照原始值，供回退逐个还原。只在文件不存在时写，避免二次运行把已调过的值当成原始值。
# 任何会改动运行时状态的入口（菜单 2/3/4/5）都必须先调它——否则用户只跑菜单 2 再回退，
# 会被 orig_value 的兜底值改成 cubic/fq_codel，而机器原本可能就不是这套值
save_original_values() {
    mkdir -p "$STATE_DIR"
    [ -f "$ORIG_STATE" ] && return
    {
        echo "# tcp-dashboard 首次运行前的原始值 $(date '+%F %T')"
        echo "# 格式 key=value；ABSENT 表示该 key 在本内核/命名空间不存在，回退时跳过。"
        echo "# 空值（key= 后面什么都没有）是合法原值，回退时要写回空串而不是跳过"
        local k v
        for k in $MANAGED_KEYS; do
            # 必须用退出码而不是「值是否为空」来判断 key 存不存在：
            # ip_local_reserved_ports 在「原本没有保留端口」时合法值就是空串（rc=0），
            # 把它记成 ABSENT 会让回退跳过它，菜单 3/4 写进去的保留端口一直留到重启。
            # 真正不存在的 key（含容器里的 net.core.*）rc=1
            if v=$(sysctl -n "$k" 2>/dev/null); then
                # 三元组等多值参数里的空白统一成单空格，便于回退时原样写回
                echo "$k=$(printf '%s' "$v" | tr -s ' \t' ' ' | sed 's/^ //;s/ $//')"
            else
                echo "$k=ABSENT"
            fi
        done
    } | atomic_write "$ORIG_STATE" || {
        # 快照写不成就不能继续改动：没有快照的回退等于猜，而猜错是把机器改成第三种状态。
        # 项目原则「备份失败必须放弃后续改动」
        echo -e "  ${RED}原始值快照写入失败（磁盘满或 $STATE_DIR 不可写），中止${NC}" >&2
        echo -e "  ${RED}没有快照就无法可靠回退，不继续改动${NC}" >&2
        return 1
    }
}

# 读回快照里的原始值。没有快照或该 key 记的是 ABSENT 时返回空，调用方据此跳过——
# 不再用硬编码兜底值去猜，猜错就是把用户的机器改成另一个状态
orig_value() {
    local key=$1
    [ -f "$ORIG_STATE" ] || return 1
    awk -F= -v k="$key" '$1==k {print substr($0, index($0,"=")+1); found=1} END{exit !found}' \
        "$ORIG_STATE" 2>/dev/null
}

# 把所有受管 key 的运行时值恢复到快照记录的原值
restore_managed_keys() {
    local k v restored=0 skipped=0
    if [ ! -f "$ORIG_STATE" ]; then
        echo -e "  ${YELLOW}没有原始值快照，跳过运行时值还原（配置文件已删除，重启后即为系统默认）${NC}"
        return 0
    fi
    for k in $MANAGED_KEYS; do
        # orig_value 返回非 0 = 快照里没这一行；返回 0 且值为空 = 原值就是空串，要写回去
        v=$(orig_value "$k") || { skipped=$((skipped + 1)); continue; }
        # ABSENT 表示快照时该 key 在本内核/命名空间不存在，不能瞎写。
        # 注意不能用 [ -z "$v" ] 当跳过条件——空串是 ip_local_reserved_ports 的合法原值，
        # sysctl -w key= 正是清空它的办法
        [ "$v" = "ABSENT" ] && { skipped=$((skipped + 1)); continue; }
        if [ "$DRYRUN" = "1" ]; then
            skipped=$((skipped + 1))
            continue
        elif sysctl -w "$k=$v" &>/dev/null; then
            restored=$((restored + 1))
        else
            skipped=$((skipped + 1))
        fi
    done
    echo -e "  已还原 ${GREEN}${restored}${NC} 项运行时值（$skipped 项不可写或原本不存在，已跳过）"
}

# 累加 /proc/net/softnet_stat 指定列（每 CPU 一行、值为十六进制）。
# 不能用 awk 的 strtonum：那是 GNU 扩展，Debian/Ubuntu 默认的 mawk 没有，
# 结果会是空值而非数字（症状是显示 "?"）。用 shell 的 $((16#..)) 做转换
softnet_sum() {
    local col=$1 sum=0 v
    while read -r -a f; do
        v=${f[$((col - 1))]}
        case "$v" in
        '' | *[!0-9a-fA-F]*) continue ;;
        esac
        sum=$((sum + 16#$v))
    done </proc/net/softnet_stat 2>/dev/null
    echo "$sum"
}

# 删掉本脚本加的 MSS clamp 规则。
#
# 为什么不能只靠精确文本匹配（`iptables -D` 原样传回添加时的参数）：
#   1) 参数写法一变（改了链、加了 -o 限定、内核规范化了 --tcp-flags 的表示）就删不掉，
#      规则永久残留在链里；
#   2) 无法区分「本脚本加的」和「用户自己加的同款规则」，回退时会把用户的一并删掉。
# 所以加规则时打 comment 标记，删除时从 iptables-save 里按标记反查——那是 iptables
# 唯一的所有权表达方式。实测验证：用户手加的同款规则不带标记，不会被误删。
#
# 用 iptables-save 而不是 `iptables -t mangle -S`：后者在 mangle 表未使用时会把
# iptable_mangle 模块加载进内核，这里是回退路径不该有额外副作用。
# 旧版本（无 comment）加的规则用精确匹配兜底删除，否则升级过来的用户会留残余
del_owned_mss() {
    command -v iptables >/dev/null 2>&1 || return 0
    if [ "$DRYRUN" = "1" ]; then echo 0; return 0; fi
    local rule n=0
    if command -v iptables-save >/dev/null 2>&1; then
        # sed 只改行首的 -A，规则体原样回传给 iptables，避免自己拼参数拼错
        while IFS= read -r rule; do
            [ -n "$rule" ] || continue
            # shellcheck disable=SC2086
            if eval "iptables -t mangle $rule" 2>/dev/null; then
                n=$((n + 1))
            fi
        done <<EOF
$(iptables-save -t mangle 2>/dev/null | grep -F -- "--comment $MSS_TAG" | sed 's/^-A /-D /')
EOF
    fi
    # 兜底只在「一条带标记的都没找到」时才做。
    # [人工决策-2026-08-05 12:18:44] 兜底走的是精确文本匹配，它分不清「旧版本 tcpo 加的」
    # 和「用户自己加的同款规则」。实测：用户手加一条 + 本脚本加一条（带标记）时，
    # 无条件兜底会把用户那条也删掉。取舍是宁可留下残余也不删用户的规则——
    # 残余用户能自己看到并处理，误删则是静默破坏别人的配置。
    # 所以只在确认本脚本没留下任何带标记规则时（= 要么从没跑过，要么是旧版本装的）才兜底
    if [ "$n" -eq 0 ]; then
        iptables -t mangle -D FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null &&
            n=$((n + 1))
        iptables -t mangle -D POSTROUTING -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null &&
            n=$((n + 1))
    fi
    echo "$n"
}

# 取默认路由出口网卡。多处要用（诊断、qdisc 校验、MTU 探测、XPS）
egress_dev() {
    ip -o route get 1.1.1.1 2>/dev/null |
        awk '{for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}'
}

# 一次性取齐全部内核网络计数器，输出 key=value。诊断与效果测量共用这一份。
#
# 有 nstat 就用（输出已经是 名字 值 两列，最规整），没有则直读 /proc——
# 最小化容器与 busybox 环境常缺 iproute2，而只读功能不装包（见 require_tools_readonly），
# 缺了就整段诊断失效未免太脆。/proc/net/snmp 与 /proc/net/netstat 是 nstat 自己的数据源，
# 两者拿到的是同一批数字。
#
# 这两个文件的格式是「两行一组」：奇数行 "族名: 字段名 字段名 ..."，
# 偶数行 "族名: 值 值 ..."，靠列位置对应。拼出的 key 与 nstat 命名一致
# （族名直接前缀，如 TcpExt + ListenOverflows = TcpExtListenOverflows），
# 这样两条路径的下游判据代码完全共用，不必写两套。
# 同一族可能出现多次（IpExt 在 netstat 里就有两组），所以 seen 只认第一次的表头。
read_counters() {
    if command -v nstat >/dev/null 2>&1; then
        # -s 不写 /tmp 历史文件（保持只读），-az 输出全部计数器含为 0 的
        nstat -saz 2>/dev/null | awk 'NF>=2 {print $1"="$2}'
        return
    fi
    # 纯 POSIX awk：不用 gensub/strtonum/asort 之类 GNU 扩展，mawk 与 busybox awk 均可
    awk '
        {
            fam = $1
            sub(/:$/, "", fam)
            if (!(fam in seen)) {
                seen[fam] = 1
                for (i = 2; i <= NF; i++) hdr[fam, i] = $i
                next
            }
            for (i = 2; i <= NF; i++)
                if (hdr[fam, i] != "") print fam hdr[fam, i] "=" $i
        }
    ' /proc/net/snmp /proc/net/netstat 2>/dev/null
}

# 从 read_counters 的输出里取一个计数器。取不到回 空串（调用方据此显示「-」而不是 0——
# 「读不到」和「确实是 0」是两回事，后者能作判据，前者不能）
counter_get() {
    printf '%s\n' "$2" | awk -F= -v k="$1" '$1==k {print $2; exit}'
}

# 网卡出向队列的累计丢包数（全部队列之和）。
#
# 必须累加而不是只取第一处：多队列网卡的第一行是 mq 的汇总，实际丢包发生在各叶子
# 队列上。喂 root=0 / leaf=12 / leaf=30 的样例，取首处得 0，真实是 42。
# [人工决策-2026-08-05 15:12:08] 抽成函数是因为 diagnose 与 counter_snapshot 都要用，
# 而它们原先各写一份 awk——修了 diagnose 那份、漏了 counter_snapshot 那份，
# 于是菜单 8 报得对、菜单 a 仍在多队列机器上读成 0。同一份判据只留一处实现
qdisc_drops() {
    local dev=$1
    [ -n "$dev" ] || { echo 0; return; }
    command -v tc >/dev/null 2>&1 || { echo 0; return; }
    tc -s qdisc show dev "$dev" 2>/dev/null |
        awk '{ while (match($0, /dropped [0-9]+/)) {
                   s += substr($0, RSTART+8, RLENGTH-8)
                   $0 = substr($0, RSTART+RLENGTH)
               } }
             END { print s+0 }'
}

# 网卡实际生效的 root qdisc 类型，以及多队列情况下的叶子 qdisc。
# 输出一行：root<TAB>叶子类型（去重后空格分隔，非多队列时叶子为空）
#
# 为什么不能只看第一行：多队列网卡的 root 恒为 mq/mqprio，真正的 qdisc 挂在每个
# 硬件队列的叶子上（parent :1 ... :N）。内核文档说得很明确——多队列网卡 root 保持 mq，
# default_qdisc 作用在叶子上（"multiqueue NICs keep mq as root and use this for leaves"）。
# 所以拿 root 去和 default_qdisc 比，在任何多队列机器上都必然报「不一致」，是假警告
qdisc_kinds() {
    local dev=$1
    [ -n "$dev" ] || return 1
    command -v tc >/dev/null 2>&1 || return 1
    tc qdisc show dev "$dev" 2>/dev/null | awk '
        NR == 1 { root = $2 }
        # 叶子行形如 "qdisc fq 8001: dev eth0 parent :1 ..."，$2 是类型
        /parent/ { if (!($2 in kind)) { kind[$2] = 1; order[++n] = $2 } }
        END {
            if (root == "") exit 1
            leaves = ""
            for (i = 1; i <= n; i++) leaves = leaves (i > 1 ? " " : "") order[i]
            print root "\t" leaves
        }'
}

# ==================================================
# --- 自动安装 ---
# ==================================================
# 判据：脚本不是从 $SCRIPT_PATH 跑的（管道执行或首次本地执行）就装到本地再 exec 过去。
# 仍要解析符号链接——用户可能自己建了软链指过来，直接比 $0 会让每次运行都重跑一遍安装，
# 且 cp 源与目标是同一文件时报 "are the same file"
SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
# 演练模式不装自己：装到 /usr/local/bin 是实打实的系统改动，而演练承诺零写入。
# 顺带这也让非 root 用户能直接演练（自安装需要写 /usr/local/bin）。
# 写成把 SELF 改成 SCRIPT_PATH 而不是在下面的 if 上加条件——那样会让整个安装块
# 变成 elif，而安装块的完整性是由 site-test 按 `if [ "$SELF" != "$SCRIPT_PATH" ]`
# 定位后逐条校验的（校验/查返回值/兜底确认共六项），改动它的开头等于让那些断言失效
if [ "$DRYRUN" = "1" ] && [ "$SELF" != "$SCRIPT_PATH" ]; then
    echo -e "${CYAN}[演练]${NC} 跳过自安装到 $SCRIPT_PATH"
    SELF=$SCRIPT_PATH
fi
if [ "$SELF" != "$SCRIPT_PATH" ]; then
    echo -e "${YELLOW}>>> 正在安装脚本到 $SCRIPT_PATH ...${NC}"
    mkdir -p /usr/local/bin

    if [ -f "$SELF" ]; then
        # 本地文件执行：直接复制，不联网。
        # 必须查 cp 的返回值——目标只读/磁盘满/权限异常时它只往 stderr 报一行，
        # 不查就会一路走到「已安装」并 exit 0，而文件根本没落地（实测过）
        if ! cp -f "$SELF" "$SCRIPT_PATH"; then
            echo -e "${RED}安装失败：无法写入 $SCRIPT_PATH${NC}"
            echo -e "  ${YELLOW}检查该路径是否可写（只读挂载 / 磁盘满 / 权限），或换个 PATH 目录${NC}"
            exit 1
        fi
    else
        # 管道执行（$0 是 bash 或 /dev/fd/xx）：从分发地址下载物理文件。
        # 先落临时文件并校验再就位——直接写 $SCRIPT_PATH 的话，站点误配返回 HTML、
        # 传输截断或被劫持时，坏内容会直接成为正式命令且立刻被 exec。
        # 这与菜单 7 的更新走同一套校验（validate_script），两条路径不能松紧不一
        if ! curl -fsSL "$SCRIPT_URL" -o "$SCRIPT_PATH.tmp"; then
            rm -f "$SCRIPT_PATH.tmp"
            echo -e "${RED}下载失败，请检查网络或 SCRIPT_URL: $SCRIPT_URL${NC}"
            exit 1
        fi
        if ! validate_script "$SCRIPT_PATH.tmp"; then
            rm -f "$SCRIPT_PATH.tmp"
            echo -e "${RED}安装中止：$SCRIPT_URL 返回的内容不是有效脚本，未写入任何文件。${NC}"
            exit 1
        fi
        if ! mv "$SCRIPT_PATH.tmp" "$SCRIPT_PATH"; then
            rm -f "$SCRIPT_PATH.tmp"
            echo -e "${RED}安装失败：无法写入 $SCRIPT_PATH${NC}"
            echo -e "  ${YELLOW}检查该路径是否可写（只读挂载 / 磁盘满 / 跨设备），或换个 PATH 目录${NC}"
            exit 1
        fi
    fi
    if ! chmod +x "$SCRIPT_PATH"; then
        echo -e "${RED}安装失败：无法给 $SCRIPT_PATH 加可执行位${NC}"
        exit 1
    fi
    # 最后确认一次文件真的在位且可执行。前面每步都查了返回值，这里是兜底：
    # 少了它，任何一步的漏检都会以「已安装」+ exit 0 的形式骗过用户
    if [ ! -x "$SCRIPT_PATH" ]; then
        echo -e "${RED}安装失败：$SCRIPT_PATH 不存在或不可执行${NC}"
        exit 1
    fi

    echo -e "${GREEN}已安装，以后任意目录输入 ${YELLOW}tcpo${GREEN} 即可打开面板。${NC}"

    # curl -sL URL | bash 这种管道执行时 stdin 是脚本自身的字节流、已被读完，
    # 直接 exec 过去菜单的 read 会立刻拿到 EOF 并空转刷屏；重新绑定到 /dev/tty 才能进交互。
    # 必须先试开一次：容器/CI 里 /dev/tty 节点存在但无控制终端，open 会 ENXIO
    if [ ! -t 0 ]; then
        if { : </dev/tty; } 2>/dev/null; then
            exec bash "$SCRIPT_PATH" </dev/tty
        fi
        # 无 tty 可绑（CI / 无控制终端的容器）：装完即止，不进交互菜单
        echo -e "${GREEN}安装完成。当前是非交互环境，请运行 ${YELLOW}tcpo${GREEN} 打开面板。${NC}"
        exit 0
    fi
    exec bash "$SCRIPT_PATH"
fi

# ==================================================
# --- 维护：在线更新 / 卸载 ---
# ==================================================
# 启动时的版本检查。只读一个小文本文件（VERSION），发现新版只在标题栏提示，
# 绝不自动下载或替换脚本——这台机器可能正在跑业务，换代码得由用户按菜单 7 明确触发。
# 设计要点：
#   - 静默失败：无网络、域名挂了、curl 没装，一律当「未知」处理，不打印任何错误
#   - 有缓存：每 $VERSION_CACHE_TTL 秒最多查一次，避免每次开面板都等网络
#   - 多源：自建域名在前、GitHub raw 兜底，任一可达即可
#   - 可关：设 TCP_DASHBOARD_NO_CHECK=1 完全跳过（离线环境 / 不想让脚本联网）
LATEST_VERSION=""
fetch_latest_version() {
    [ -n "${TCP_DASHBOARD_NO_CHECK:-}" ] && return 0

    # 缓存读取必须在 curl 检查之前：机器可能之前联网时查到过新版、后来断网或卸了 curl，
    # 那份缓存仍然有效。反过来先判 curl 会让离线机永远读不到已缓存的结果
    local now cached_at cached_ver
    now=$(date +%s 2>/dev/null) || return 0
    if [ -f "$VERSION_CACHE" ]; then
        read -r cached_at cached_ver <"$VERSION_CACHE" 2>/dev/null
        # 时间戳必须是纯数字：文件被手改坏或时钟回拨时按「缓存失效」处理而不是算出负数
        case "$cached_at" in
        '' | *[!0-9]*) cached_at=0 ;;
        esac
        if [ "$cached_at" -gt 0 ] && [ $((now - cached_at)) -lt "$VERSION_CACHE_TTL" ] &&
            [ $((now - cached_at)) -ge 0 ]; then
            LATEST_VERSION="$cached_ver"
            return 0
        fi
    fi

    # 缓存过期或没有，才需要联网。curl 缺失时直接放弃（保持 LATEST_VERSION 为空）
    command -v curl >/dev/null 2>&1 || return 0

    local url got
    for url in $VERSION_URLS; do
        # --max-time 是硬上限（含连接与传输），源不可达时不会卡住面板启动。
        # tr -d 清掉可能的 \r 与换行：VERSION 文件由 CI 生成，行尾未必干净
        got=$(curl -fsSL --max-time "$VERSION_TIMEOUT" "$url" 2>/dev/null |
            head -1 | tr -d ' \r\n\t')
        # 只接受形似版本号的内容。拿到 HTML（域名被泛解析到别的站）时必须丢弃，
        # 否则标题栏会显示一串 <!DOCTYPE html>
        case "$got" in
        '' | *[!0-9.]*) continue ;;
        esac
        LATEST_VERSION="$got"
        break
    done

    # 结果落缓存（含「查过但没查到」的情况：写空版本号，避免每次启动都重试一轮超时）
    # 版本缓存内容无害（时间戳+版本号），但同样不跟随链接——统一规则比逐个判断可靠
    if mkdir -p "$STATE_DIR" 2>/dev/null && refuse_if_symlink "$VERSION_CACHE" 2>/dev/null; then
        printf '%s %s\n' "$now" "$LATEST_VERSION" >"$VERSION_CACHE" 2>/dev/null
    fi
    return 0
}

# 有新版时给菜单标题用的一行提示。同版本或检查失败都返回空串
version_hint() {
    [ -n "$LATEST_VERSION" ] || return 0
    [ "$LATEST_VERSION" = "$SCRIPT_VERSION" ] && return 0
    printf '%s' "${YELLOW}有新版 ${LATEST_VERSION}（当前 ${SCRIPT_VERSION}，菜单 7 更新）${NC}"
}

check_update() {
    echo -e "${YELLOW}正在从 $SCRIPT_URL 同步...${NC}"
    if curl -fsSL "$SCRIPT_URL" -o "$SCRIPT_PATH.tmp"; then
        # 先校验再替换：拉到 HTML（域名被泛解析）或截断的文件时，
        # 直接 mv 过去会让 tcpo 从此起不来，而这台机器可能正在远程 SSH 里。
        # 与首次安装共用 validate_script，两条路径的严格程度必须一致
        if ! validate_script "$SCRIPT_PATH.tmp"; then
            rm -f "$SCRIPT_PATH.tmp"
            echo -e "${RED}更新失败：$SCRIPT_URL 返回的内容未通过校验，已放弃，当前版本未改动。${NC}"
            pause_return
            return
        fi
        # mv / chmod 都要查返回值：目标只读或磁盘满时它们只往 stderr 报一行，
        # 不查就会打印「更新成功」再 exec 一个没换过的（甚至不存在的）文件
        if ! mv "$SCRIPT_PATH.tmp" "$SCRIPT_PATH"; then
            rm -f "$SCRIPT_PATH.tmp"
            echo -e "${RED}更新失败：无法写入 $SCRIPT_PATH（只读挂载 / 磁盘满 / 权限），当前版本未改动。${NC}"
            pause_return
            return
        fi
        if ! chmod +x "$SCRIPT_PATH" || [ ! -x "$SCRIPT_PATH" ]; then
            echo -e "${RED}更新失败：$SCRIPT_PATH 不可执行，请手动检查。${NC}"
            pause_return
            return
        fi
        # 清掉版本检查缓存，否则新版启动后仍会读到旧缓存、继续提示「有新版」
        rm -f "$VERSION_CACHE"
        echo -e "${GREEN}更新成功，正在重新载入...${NC}"
        exec bash "$SCRIPT_PATH"
    else
        rm -f "$SCRIPT_PATH.tmp"
        echo -e "${RED}更新失败，请检查网络。${NC}"
        pause_return
    fi
}

uninstall_script() {
    echo -e "\n${RED}>>> 卸载脚本并回退全部网络优化${NC}"
    read -p "确定要卸载吗？(会同时回退所有网络优化设置) [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        rollback_tune
        # 状态目录里有原始值快照和接管备份，回退用得上，只在卸载时才删
        rm -rf "$STATE_DIR"
        rm -f "$SCRIPT_PATH"
        echo -e "${GREEN}卸载完成，命令 tcpo 与状态目录均已移除。${NC}\n"
        exit 0
    fi
    echo -e "${GREEN}已取消。${NC}"
    sleep 1
}

# ==================================================
# --- 1. IPv4 优先解析 ---
# ==================================================
set_ipv4_priority() {
    echo -e "\n${YELLOW}>>> 设置 IPv4 优先解析${NC}"

    # 目标是符号链接时拒绝：跟着写会改到链接目标（可能是共享挂载上的别人的文件）。
    # 这里改的是 /etc 下的系统文件而不是本脚本自有的 drop-in，被做成链接的可能性
    # 比 sysctl.d 那些高（有人把 /etc 的一部分指到别处统一管理）
    refuse_if_symlink "$GAI_CONF" || {
        pause_return
        return 1
    }

    # 演练模式下 $GAI_CONF 指向临时目录，那里本来是空的。要先把真实文件拷进去，
    # 否则会走下面「生成默认模板」的分支——演练看到的就不是这台机器真实的改动结果了。
    # [人工决策-2026-08-05 15:31:20] 演练必须反映真实起点：读真实文件、写临时副本。
    # 早前版本这个函数完全绕过 DRYRUN 重定向，TCPO_DRYRUN=1 跑菜单 1 会真实改机，
    # 与「零写入」承诺直接冲突
    if [ "$DRYRUN" = "1" ] && [ ! -f "$GAI_CONF" ] && [ -f /etc/gai.conf ]; then
        cp /etc/gai.conf "$GAI_CONF" 2>/dev/null &&
            echo -e "  ${CYAN}[演练]${NC} 已把真实 /etc/gai.conf 复制进演练目录作为起点"
    fi

    if [ ! -f "$GAI_CONF" ]; then
        # 函数开头已查过一次，这里再查一次：那次到这里之间有 cp 操作，
        # 且「文件不存在」与「是悬空链接」两种状态容易混淆
        refuse_if_symlink "$GAI_CONF" || {
            pause_return
            return 1
        }
        if ! cat >"$GAI_CONF" <<'EOF'
label ::1/128       0
label ::/0          1
label 2002::/16     2
label ::/96         3
label ::ffff:0:0/96 4
precedence  ::1/128       50
precedence  ::/0          40
precedence  2002::/16     30
precedence  ::/96         20
precedence  ::ffff:0:0/96 10
EOF
        then
            echo -e "  ${RED}生成 $GAI_CONF 失败（磁盘满 / 只读挂载 / 权限）${NC}"
            pause_return
            return 1
        fi
    fi

    # 备份失败必须放弃后续改动：回退靠这份备份整份还原，没备份成功就改原文件
    # 等于制造不可逆状态（项目原则：可回退性优先于参数生效）
    if [ ! -f "$GAI_BAK" ]; then
        if ! cp "$GAI_CONF" "$GAI_BAK"; then
            echo -e "  ${RED}备份 $GAI_CONF 失败，中止（没有备份就无法回退）${NC}"
            pause_return
            return 1
        fi
    fi

    # 两处写盘都要查返回值。
    # [人工决策-2026-08-05 16:58:19] 早前版本 sed -i 与 >> 都不查，失败后照样打印
    # 「完成」并返回 0——只读 bind mount、备份成功后磁盘写满、SELinux 拒绝这几种
    # 场景下用户会以为设好了而配置根本没落地。项目原则「落地类操作必须查返回值
    # 再宣布成功」，这里之前漏了
    if grep -q '^#precedence ::ffff:0:0/96  100' "$GAI_CONF"; then
        if ! sed -i 's|^#precedence ::ffff:0:0/96  100|precedence ::ffff:0:0/96  100|' "$GAI_CONF"; then
            echo -e "  ${RED}改写 $GAI_CONF 失败（只读挂载 / 磁盘满 / 权限），IPv4 优先未生效${NC}"
            echo -e "  ${YELLOW}备份已在 $GAI_BAK，原文件未被破坏${NC}"
            pause_return
            return 1
        fi
    elif ! grep -q '^precedence ::ffff:0:0/96  100' "$GAI_CONF"; then
        if ! echo 'precedence ::ffff:0:0/96  100' >>"$GAI_CONF"; then
            echo -e "  ${RED}追加到 $GAI_CONF 失败（只读挂载 / 磁盘满 / 权限），IPv4 优先未生效${NC}"
            echo -e "  ${YELLOW}备份已在 $GAI_BAK，原文件未被破坏${NC}"
            pause_return
            return 1
        fi
    fi

    # 兜底确认结果真的落地了：前面每步都查了返回值，但 sed -i 有过「返回 0 而
    # 文件没变」的实现差异（某些 busybox sed 版本），所以最后再回读一次
    if ! grep -q '^precedence ::ffff:0:0/96  100' "$GAI_CONF"; then
        echo -e "  ${RED}写入命令返回成功，但回读 $GAI_CONF 里没有那一行——未真正生效${NC}"
        echo -e "  ${YELLOW}请手动检查该文件；备份在 $GAI_BAK${NC}"
        pause_return
        return 1
    fi

    echo -e "${GREEN}完成：已设为 IPv4 优先（$GAI_CONF，原文件备份为 gai.conf.bak）${NC}"
    pause_return
}

# ==================================================
# --- 2. BBR + FQ ---
# ==================================================
enable_bbr() {
    echo -e "\n${YELLOW}>>> 开启 BBR + FQ${NC}"
    # 这里就会改运行时值，必须先快照——否则用户只跑菜单 2 再回退，
    # 就没有原值可还原了。快照失败必须中止：没有快照的回退等于猜
    save_original_values || { pause_return; return 1; }

    # 部分发行版 BBR 是模块，未加载时 available 列表里没有 bbr，直接写 sysctl 会静默失败
    if ! sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null | grep -qw bbr; then
        echo -e "${YELLOW}    当前内核未加载 BBR 模块，尝试 modprobe tcp_bbr ...${NC}"
        dryrun_skip "modprobe tcp_bbr" || modprobe tcp_bbr 2>/dev/null
    fi
    # [人工决策-2026-08-05 16:58:33] 模块的开机加载配置无条件写，且必须查返回值。
    # 两个判例：
    #   1) 原先只在「available 里没有 bbr」时写。模块已被手工 modprobe 进来的机器
    #      走不到那个分支，于是永远没有持久化配置，重启后回到 cubic
    #   2) 原先 echo 重定向不查返回值。只读 /etc 或磁盘满时它只往 stderr 报一行、
    #      退出码被丢弃，面板照样往下报「已持久化」而文件根本没落地
    #   3) [人工决策-2026-08-05 17:44:05] 原先是裸重定向，绕过了别的关键落地路径
    #      都在走的 atomic_write（内含 refuse_if_symlink + 先临时文件再 rename）。
    #      这条路径被预置成符号链接时，脚本会以 root 跟着链接写出去、覆盖链接目标，
    #      属实际的任意文件覆盖风险；而本项目的最坏边界是「参数没生效」。
    #      统一走 atomic_write，并在末尾确认结果文件真的落地
    if ! write_bbr_modload; then
        echo -e "  ${YELLOW}写 $BBR_MODLOAD 未成功（只读 /etc、磁盘满，或该路径是符号链接）${NC}"
        echo -e "  ${YELLOW}BBR 本次仍可生效，但开机不会自动加载 tcp_bbr 模块${NC}"
    fi

    ensure_sysctl_dir || { pause_return; return 1; }
    refuse_if_symlink "$BBR_OPT" || { pause_return; return 1; }
    # 查返回值：写失败后继续 apply_sysctl 是在应用一份没落地的配置，
    # 而面板会照常打印「BBR 已生效」。项目原则「落地类操作必须查返回值再宣布成功」
    if ! cat >"$BBR_OPT" <<'EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
EOF
    then
        echo -e "  ${RED}写入 $BBR_OPT 失败（磁盘满 / 只读挂载 / 权限），BBR 未配置${NC}"
        pause_return
        return 1
    fi
    # 走统一入口，别裸跑 sysctl --system：内核拒绝的原因（模块没加载、算法名不存在、
    # 被后加载文件覆盖）必须回显给用户，否则失败时只看到「当前仍为 cubic」而查不出为什么
    apply_sysctl

    local cur_cc cur_qdisc
    cur_cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
    cur_qdisc=$(sysctl -n net.core.default_qdisc 2>/dev/null)

    draw_line
    printf "  %-20s : %s\n" "拥塞算法" "$cur_cc"
    printf "  %-20s : %s\n" "默认队列(qdisc)" "$cur_qdisc"
    draw_line
    if [ "$cur_cc" = "bbr" ]; then
        echo -e "${GREEN}完成：BBR 已生效${NC}$(bbr_version_label)"
        # 「本次生效」与「开机还生效」是两件事，必须分开报。无 systemd 的机器上
        # /etc/sysctl.d 与 /etc/modules-load.d 开机都没人读，重启后回到 cubic
        report_sysctl_persist "$BBR_OPT"
    else
        echo -e "${RED}未生效：当前仍为 $cur_cc${NC}"
        # 分情况给具体线索，不要笼统说「可能不支持」
        local avail
        avail=$(sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null)
        if [ -n "$avail" ] && ! printf '%s' "$avail" | grep -qw bbr; then
            echo -e "  ${YELLOW}可用算法里没有 bbr（当前: $avail）。内核需 4.9+，且 tcp_bbr 模块要能加载${NC}"
            echo -e "  ${YELLOW}排查: modprobe tcp_bbr 看报什么；容器内通常无法加载内核模块${NC}"
        else
            echo -e "  ${YELLOW}bbr 在可用列表里但没生效，说明被别的配置覆盖了。排查:${NC}"
            echo -e "  ${YELLOW}    grep -rn tcp_congestion_control /etc/sysctl.d/ /etc/sysctl.conf${NC}"
            echo -e "  ${YELLOW}    上面 sysctl 的报错和 $APPLY_LOG${NC}"
        fi
    fi
    pause_return
}

# ==================================================
# --- 3. 内核参数调优 ---
# ==================================================
# 本脚本负责的 key。zz- 前缀只能赢过字典序在它之前的文件，遇到 zzz-*.conf 或
# /etc/sysctl.d/ 里被别的面板写的同名 key 依然会被盖。逐项校验能「发现」被覆盖，
# 接管才能「阻止」——把命中这些 key 的其它文件备份后移走，并把清单落盘供回退还原
OWNED_KEYS_RE='^[[:space:]]*net\.(core\.(default_qdisc|somaxconn|netdev_max_backlog|netdev_budget|netdev_budget_usecs|rmem_max|wmem_max|rps_sock_flow_entries)|ipv4\.(tcp_congestion_control|tcp_max_syn_backlog|tcp_syncookies|ip_local_port_range|ip_local_reserved_ports|tcp_rmem|tcp_wmem|tcp_notsent_lowat|tcp_mtu_probing|udp_rmem_min|tcp_slow_start_after_idle|tcp_no_metrics_save|tcp_tw_reuse|tcp_fin_timeout|tcp_fastopen|ip_forward))[[:space:]]*='

# 把一个文件里命中受管 key 的行注释掉，其余行原样保留。
# 关键点：只动冲突的那几行，不整文件禁用。发行版和安全加固包常把多个不相关的参数
# 放在同一个 .conf 里（比如 10-network-security.conf 同时有 rp_filter、accept_redirects
# 和一个我们要管的 key），整文件 mv 走会把那些无关的安全参数一起停掉——那是行为回归，
# 不是「接管冲突」
comment_out_conflicts() {
    local target=$1 tmp
    tmp="${target}.tcpdash.tmp"
    awk -v re="$OWNED_KEYS_RE" -v owner="$SYSCTL_OPT" '
        $0 ~ re && $0 !~ /^[[:space:]]*#/ {
            print "# moved to " owner " by tcp-dashboard: " $0
            next
        }
        { print }
    ' "$target" >"$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
    # 保持原有权限与属主
    cat "$tmp" >"$target" 2>/dev/null && rm -f "$tmp" && return 0
    rm -f "$tmp"
    return 1
}

# 接管 /etc/sysctl.d 下与本脚本冲突的文件，以及 /etc/sysctl.conf 里的冲突行。
# 一律「逐行注释 + 备份原文件」，不移动、不禁用整个文件
takeover_conflicts() {
    mkdir -p "$STATE_DIR"
    local ts backup_dir moved=0 f base
    ts=$(date '+%Y%m%d-%H%M%S')
    backup_dir="$STATE_DIR/takeover-$ts"

    for f in /etc/sysctl.d/*.conf /etc/sysctl.conf; do
        [ -f "$f" ] || continue
        base=$(basename "$f")
        # 跳过自己、BBR 子文件、RFS 子文件，以及备份/禁用/说明类文件
        case "$base" in
        "$(basename "$SYSCTL_OPT")" | "$(basename "$BBR_OPT")" | "$(basename "$NIC_SYSCTL_OPT")") continue ;;
        *.bak | *.bak.* | *.disabled | *.disabled.* | *.old | README*) continue ;;
        esac
        grep -qE "$OWNED_KEYS_RE" "$f" 2>/dev/null || continue

        mkdir -p "$backup_dir"
        # 备份文件名带路径信息，避免 /etc/sysctl.conf 与 /etc/sysctl.d/sysctl.conf 撞名。
        # 备份失败就不接管：回退是靠这份备份整份还原的，没备份成功就改原文件
        # 等于制造一个不可逆的改动——「可回退性」优先于「参数生效」
        if ! cp -a "$f" "$backup_dir/$(echo "${f#/}" | tr '/' '_')" 2>/dev/null; then
            echo -e "  ${RED}备份 $f 失败，跳过接管（不做无法回退的改动）${NC}"
            echo -e "  ${YELLOW}该文件里的同名参数可能仍会覆盖本脚本的设置${NC}"
            continue
        fi
        if comment_out_conflicts "$f"; then
            atomic_append "$TAKEOVER_LIST" "$f"
            echo -e "  ${YELLOW}已注释 $f 里的冲突行（该文件其余参数不受影响）${NC}"
            moved=$((moved + 1))
        else
            echo -e "  ${RED}无法改写 $f（只读挂载？），它可能仍会覆盖本脚本的参数${NC}"
        fi
    done

    # 上一版把冲突文件整体改名为 .disabled-by-tcp-dashboard，会连带停掉无关参数。
    # 遇到那种遗留就改回来，再走逐行注释
    for f in /etc/sysctl.d/*.disabled-by-tcp-dashboard; do
        [ -f "$f" ] || continue
        local orig="${f%.disabled-by-tcp-dashboard}"
        if [ ! -f "$orig" ]; then
            mv "$f" "$orig" 2>/dev/null && {
                echo -e "  ${YELLOW}发现旧版整文件禁用的遗留，已还原 $orig 并改为逐行注释${NC}"
                mkdir -p "$backup_dir"
                # 同上：备份失败就不接管，不制造无法回退的改动
                if cp -a "$orig" "$backup_dir/$(echo "${orig#/}" | tr '/' '_')" 2>/dev/null; then
                    comment_out_conflicts "$orig" && {
                        grep -qxF "$orig" "$TAKEOVER_LIST" 2>/dev/null || atomic_append "$TAKEOVER_LIST" "$orig"
                        moved=$((moved + 1))
                    }
                else
                    echo -e "  ${RED}备份 $orig 失败，跳过接管${NC}"
                fi
            }
        fi
    done

    [ "$moved" -gt 0 ] && echo -e "  ${GREEN}接管 $moved 处，原文件备份在 $backup_dir，回退时整份还原${NC}"

    report_vendor_conflicts
    return 0
}

# 报告 /etc 之外的目录里也设了同名参数的文件。只报告，不接管。
#
# systemd-sysctl 读四个目录：/etc/sysctl.d、/run/sysctl.d、/usr/local/lib/sysctl.d、
# /usr/lib/sysctl.d（部分发行版 /lib 是 /usr/lib 的符号链接），外加 /etc/sysctl.conf。
#
# 这里要说清一个容易搞错的点：sysctl.d(5) 原文是「All configuration files are sorted by
# their filename in lexicographic order, **regardless of which of the directories they
# reside in**」——跨目录一起按文件名排序，字典序最后的赢。目录优先级只在**同名文件**
# 之间起作用（/etc 里的同名文件整份替换 /usr/lib 里的）。
# 所以本脚本的 zz- 前缀在任何目录面前都是最后加载的，vendor 文件不会覆盖它。
#
# 那为什么还要报告？因为用户需要知道「同一个参数还有别处在设」：
#   1) 删掉本脚本的文件后，那些值会重新生效——回退后的状态不是发行版原始状态；
#   2) 排查「为什么值和我想的不一样」时，得知道完整的来源清单。
# 不接管 /usr/lib 与 /lib：那是包管理器的领地，改了会在下次升级时被覆盖，
# 且用户无从知晓。/run 是易失的（重启即空），改它没意义
report_vendor_conflicts() {
    local d f hits="" n=0
    for d in /run/sysctl.d /usr/local/lib/sysctl.d /usr/lib/sysctl.d /lib/sysctl.d; do
        [ -d "$d" ] || continue
        for f in "$d"/*.conf; do
            [ -f "$f" ] || continue
            # /lib 常是 /usr/lib 的符号链接，同一份文件会被数两次
            case " $hits " in *" $(readlink -f "$f" 2>/dev/null || echo "$f") "*) continue ;; esac
            grep -qE "$OWNED_KEYS_RE" "$f" 2>/dev/null || continue
            hits="$hits $(readlink -f "$f" 2>/dev/null || echo "$f")"
            n=$((n + 1))
        done
    done
    [ "$n" -eq 0 ] && return 0
    echo -e "  ${YELLOW}另有 $n 个系统目录下的文件也设了本脚本管理的参数：${NC}"
    for f in $hits; do echo -e "    ${YELLOW}$f${NC}"; done
    echo -e "  ${YELLOW}它们不会覆盖本脚本（zz- 前缀在跨目录字典序里最后加载），故不接管——${NC}"
    echo -e "  ${YELLOW}那些目录属包管理器所有，改动会在升级时被静默覆盖。${NC}"
    echo -e "  ${YELLOW}但要知道：回退删掉本脚本的文件后，上面这些值会重新生效${NC}"
    return 0
}

# 扫当前监听端口，把落在临时端口范围内的合并成区间写进 ip_local_reserved_ports。
# 这是放宽 ip_local_port_range 的正解：内核分配随机源端口时会跳过保留区间，
# 业务服务重启时就不会撞上「端口已被某条出站连接占用」
build_reserved_ports() {
    local lo=$1 hi=$2
    if ! command -v ss >/dev/null 2>&1; then
        echo -e "  ${YELLOW}无 ss 命令，跳过监听端口保留——放宽端口范围后业务重启可能撞端口${NC}" >&2
        return 0
    fi
    ss -HtulnA all 2>/dev/null | awk -v lo="$lo" -v hi="$hi" '
        {
            # 取本地地址列（形如 0.0.0.0:8080 / [::]:443 / *:53），端口是最后一个冒号之后
            for (i = 1; i <= NF; i++) if ($i ~ /:[0-9]+$/) { addr = $i; break }
            if (addr == "") next
            n = split(addr, a, ":"); p = a[n] + 0
            if (p >= lo && p <= hi) seen[p] = 1
            addr = ""
        }
        END {
            cnt = 0
            for (p in seen) ports[cnt++] = p + 0
            if (cnt == 0) exit
            # 简单插入排序，端口数量级很小
            for (i = 1; i < cnt; i++) { v = ports[i]; j = i - 1
                while (j >= 0 && ports[j] > v) { ports[j+1] = ports[j]; j-- }
                ports[j+1] = v }
            # 合并连续端口成区间，最多输出 64 项（内核对该字符串长度有限制）
            out = ""; items = 0; s = ports[0]; e = ports[0]
            for (i = 1; i <= cnt; i++) {
                if (i < cnt && ports[i] == e + 1) { e = ports[i]; continue }
                seg = (s == e) ? s : s "-" e
                if (items < 64) { out = (out == "") ? seg : out "," seg; items++ }
                if (i < cnt) { s = ports[i]; e = ports[i] }
            }
            print out
        }'
}

# 按带宽 x RTT 算缓冲区上限（BDP），而不是拍内存百分比。
# 内存百分比是代理指标：同一台 2G 内存的机器，跑 1Gbps/10ms 的同城线和 100Mbps/250ms 的
# 跨境线，需要的窗口差 20 倍，但按内存算会得到同一个值。
# 公式：BDP(bytes) = Mbps x 125 x RTT_ms，取 2.5 倍留给丢包重传期间的在途数据。
# 上限同时受内存约束（不超过总内存 5%），下限 8MB。
calc_buf_bytes() {
    local mbps=$1 rtt=$2 mem_total_kb=$3 pool_bytes=${4:-0}
    local bdp buf mem_cap pool_cap
    bdp=$((mbps * 125 * rtt))
    buf=$((bdp * 5 / 2))
    mem_cap=$((mem_total_kb * 5 / 100 * 1024))
    [ "$buf" -gt "$mem_cap" ] && buf=$mem_cap
    # 第四道约束：TCP 全局内存池。
    # rmem_max 是「单条连接的上限」，但所有连接共用 net.ipv4.tcp_mem[2] 这个全局池
    # （单位是页）。池被打满时内核进入内存压力模式，强制收缩**所有**连接的缓冲——
    # 那时 rmem_max 设多大都没意义，反而因为单条连接吃得多而更早触发。
    # 实测量级：512MB 内存机器的池约 48MB，而 BDP 算出的 47MB 意味着一条满载连接
    # 就能打满它。所以把单条上限压到「池 / 预期并发数」以内。
    # 取 16 作除数是保守估计：跨境代理/中转机同时跑几十条连接是常态，
    # 但真要按几十算会把缓冲压得太小、失去 BDP 的意义，16 是折中。
    # 池读不到（容器里 tcp_mem 常不可读）时传 0，本约束自动跳过——
    # 不猜一个池大小，猜错要么白白限制要么起不到作用
    if [ "${pool_bytes:-0}" -gt 0 ] 2>/dev/null; then
        pool_cap=$((pool_bytes / 16))
        [ "$buf" -gt "$pool_cap" ] && buf=$pool_cap
    fi
    [ "$buf" -lt 8388608 ] && buf=8388608
    [ "$buf" -gt 268435456 ] && buf=268435456
    # 向上取整到 MB，让 sysctl 里的数字好读
    echo $(((buf + 1048575) / 1048576 * 1048576))
}

# 读 tcp_mem 的第三个字段（max，单位是页）并换成字节。读不到回 0。
# 只读不写：本项目「故意不设」tcp_mem（ESnet 原话 leave net.tcp_mem at its defaults，
# 且社区脚本大面积把页当字节写出过 256GB 这种值），但读它来给缓冲区加一道上界是安全的
tcp_mem_pool_bytes() {
    local v pg hi
    v=$(sysctl -n net.ipv4.tcp_mem 2>/dev/null) || { echo 0; return; }
    hi=$(printf '%s' "$v" | awk '{print $3}')
    case "$hi" in '' | *[!0-9]*)
        echo 0
        return
        ;;
    esac
    pg=$(getconf PAGESIZE 2>/dev/null)
    case "$pg" in '' | *[!0-9]*) pg=4096 ;; esac
    # 页数 × 页大小可能超过 32 位，但 bash 算术是 64 位，安全
    echo $((hi * pg))
}

# 实测到公共地址的 RTT，用于 BDP 估算。三个目标取最小值（避开单点抖动），失败返回空
probe_rtt() {
    local t rtt best=""
    for t in $RTT_PROBE_TARGETS; do
        rtt=$(ping -c 3 -W 2 -q "$t" 2>/dev/null |
            awk -F'/' '/rtt|round-trip/{printf "%.0f", $5}')
        case "$rtt" in
        '' | 0 | *[!0-9]*) continue ;;
        esac
        [ -z "$best" ] && best=$rtt
        [ "$rtt" -lt "$best" ] && best=$rtt
    done
    echo "$best"
}

# 出口网卡的链路速率（Mbps）。读不到或不可信时回 0。
#
# 用途是给用户输入的带宽做个上界提示——填 10000 但网卡是 1000 时值得说一声，
# 因为带宽直接决定 BDP 与缓冲区大小，填错一个数量级会让缓冲区大一个数量级。
# 不用它当默认值：物理口速率 ≠ 可用带宽，跨境 VPS 常见千兆口但实际跑不到百兆，
# 拿口速当默认值会系统性高估。
# 虚拟网卡（virtio / veth）常返回 -1 或读取直接报错，那种情况回 0 让调用方跳过
nic_link_mbps() {
    local dev=$1 v
    [ -n "$dev" ] || return 0
    v=$(cat "/sys/class/net/$dev/speed" 2>/dev/null)
    case "$v" in
    '' | -* | *[!0-9]*)
        echo 0
        return
        ;;
    esac
    [ "$v" -le 0 ] 2>/dev/null && {
        echo 0
        return
    }
    echo "$v"
}

# RTT 抖动（ping 的 mdev 字段，即平均偏差）。输出 "目标 avg mdev"，每个目标一行。
#
# 为什么要单独取 mdev：抖动比均值更能说明链路质量，而调优的收益也常体现在抖动上。
# 有个很好的公开对照（nginx reuseport 那组数据）：延迟均值只从 15.65ms 降到 12.35ms
# （-21%），但标准差从 26.59 降到 3.15（-88%）——只看均值会几乎错过全部收益。
# 菜单 a 的结尾一直写着「抖动下降往往比均值提升更有价值」，但在此之前没有任何数字支撑它。
#
# ping 的汇总行是 min/avg/max/mdev，$5 是 avg、$7 是 mdev（$6 是 max）。
# mdev 是平均绝对偏差不是标准差，量级相近、方向一致，作为抖动指标够用且零成本
probe_jitter() {
    command -v ping >/dev/null 2>&1 || return 1
    local t line avg mdev
    for t in $RTT_PROBE_TARGETS; do
        # 汇总行形如 "rtt min/avg/max/mdev = 52.789/52.943/53.244/0.163 ms"。
        # 按 / 切之后最后一个字段带着单位（"0.163 ms"），所以在 awk 里就用 split 去掉尾巴，
        # 不能直接拿 $7——那样会连 " ms" 一起带出来，后面的数值校验必然失败
        line=$(ping -c 5 -W 2 -q "$t" 2>/dev/null | awk -F'/' '
            /rtt|round-trip/ {
                n = split($NF, a, " ")
                print $(NF-2) " " a[1]
                exit
            }')
        [ -n "$line" ] || continue
        avg=${line%% *}
        mdev=${line##* }
        case "$avg" in '' | *[!0-9.]*) continue ;; esac
        case "$mdev" in '' | *[!0-9.]*) continue ;; esac
        printf '%s %s %s\n' "$t" "$avg" "$mdev"
    done
}

# PROFILE: normal=普通业务（不开转发/不加 MSS clamp）  transit=中转/代理/隧道节点
PROFILE="${PROFILE:-normal}"
# TUNE_MBPS / TUNE_RTT 为空时走交互询问；非交互（一键全部）下用探测值 + 保守带宽
TUNE_MBPS="${TUNE_MBPS:-}"
TUNE_RTT="${TUNE_RTT:-}"

tune_sysctl() {
    save_original_values || { pause_return; return 1; }

    local old_cc old_somax old_rmem
    old_cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
    old_somax=$(sysctl -n net.core.somaxconn 2>/dev/null || echo "-")
    old_rmem=$(sysctl -n net.core.rmem_max 2>/dev/null || echo 212992)

    local mem_total_kb cpu_count buf_bytes mbps rtt
    mem_total_kb=$(awk '/MemTotal/{print $2}' /proc/meminfo)
    cpu_count=$(nproc)

    echo -e "\n${YELLOW}>>> 部署内核网络参数（档位: ${CYAN}${PROFILE}${YELLOW}）${NC}"

    mbps=$TUNE_MBPS
    # RTT 的来源要记下来：它直接决定缓冲区大小，而「实测 152ms」和「探测失败按 150 猜」
    # 是完全不同的置信度。三个月后回头看配置文件时这一点最容易忘
    local rtt_src=""
    rtt=$TUNE_RTT
    if [ -n "$rtt" ]; then
        rtt_src="(外部指定)"
    else
        # RTT 直接决定缓冲区大小，探不到就只能按典型值猜，所以缺 ping 时先装
        ensure_tools ping >/dev/null
        echo -e "  正在探测 RTT ..."
        rtt=$(probe_rtt)
        if [ -z "$rtt" ]; then
            rtt=150
            rtt_src="(探测失败，按跨境典型值估算)"
            echo -e "  ${YELLOW}探测失败（ICMP 可能被屏蔽），按跨境典型值 150ms 估算${NC}"
        else
            rtt_src="(实测 ${RTT_PROBE_TARGETS:-公网地址} 取最小)"
        fi
    fi
    if [ -z "$mbps" ]; then
        if [ "$BATCH" = "1" ]; then
            mbps=1000
        else
            # 先把网卡链路速率报出来当参考。不拿它当默认值——物理口速率不等于
            # 可用带宽，跨境 VPS 常见千兆口而实际跑不到百兆，当默认值会系统性高估
            local link_mbps
            link_mbps=$(nic_link_mbps "$(egress_dev)")
            [ "${link_mbps:-0}" -gt 0 ] 2>/dev/null &&
                echo -e "  参考：出口网卡链路速率 ${CYAN}${link_mbps}${NC} Mbps（实际可用带宽通常低于此值）"
            read -p "  本机出口带宽 Mbps（回车默认 1000）: " mbps
            case "$mbps" in
            '' | *[!0-9]*) mbps=1000 ;;
            esac
            # 填得比物理口还高时提示一次。不阻止——用户可能就是想按聚合带宽算，
            # 或者 /sys 里的 speed 本身不准（虚拟网卡常见）
            if [ "${link_mbps:-0}" -gt 0 ] 2>/dev/null && [ "$mbps" -gt "$link_mbps" ] 2>/dev/null; then
                echo -e "  ${YELLOW}提示：${mbps} Mbps 高于网卡链路速率 ${link_mbps} Mbps。${NC}"
                echo -e "  ${YELLOW}      带宽直接决定缓冲区大小，填大一个数量级缓冲区就大一个数量级${NC}"
            fi
        fi
    fi
    [ "$mbps" -lt 1 ] 2>/dev/null || [ -z "$mbps" ] && mbps=1000

    local pool_bytes bdp_bytes raw_target cap_reason
    pool_bytes=$(tcp_mem_pool_bytes)
    buf_bytes=$(calc_buf_bytes "$mbps" "$rtt" "$mem_total_kb" "$pool_bytes")
    bdp_bytes=$((mbps * 125 * rtt))
    raw_target=$((bdp_bytes * 5 / 2))

    # 说清最终值是被哪一道约束定下来的。用户最常问的就是「为什么是 24MB」，
    # 而答案可能是四种完全不同的原因，只显示结果等于让人自己猜
    if [ "$buf_bytes" -eq 8388608 ] && [ "$raw_target" -lt 8388608 ]; then
        cap_reason="下限 8MB（BDP 推导值 $((raw_target / 1048576))MB 偏小）"
    elif [ "$buf_bytes" -eq 268435456 ]; then
        cap_reason="上限 256MB"
    elif [ "$pool_bytes" -gt 0 ] && [ "$raw_target" -gt $((pool_bytes / 16)) ] &&
        [ $((pool_bytes / 16)) -le $((mem_total_kb * 5 / 100 * 1024)) ]; then
        cap_reason="TCP 全局池约束（tcp_mem 上限 $((pool_bytes / 1048576))MB ÷ 16）"
    elif [ "$raw_target" -gt $((mem_total_kb * 5 / 100 * 1024)) ]; then
        cap_reason="内存 5% 约束"
    else
        cap_reason="BDP x2.5"
    fi

    # 写进配置文件头部的两段说明，与屏幕输出共用同一份数据
    local link_note="" pool_note
    local _lm
    _lm=$(nic_link_mbps "$(egress_dev)")
    [ "${_lm:-0}" -gt 0 ] 2>/dev/null && link_note="（网卡链路速率 ${_lm} Mbps）"
    if [ "$pool_bytes" -gt 0 ]; then
        pool_note="$((pool_bytes / 1048576)) MB ÷ 16 = $((pool_bytes / 16 / 1048576)) MB   （tcp_mem 上限，所有连接共用）"
    else
        pool_note="读不到（容器环境常见），本约束跳过"
    fi

    echo -e "  CPU: ${CYAN}${cpu_count}${NC} 核 | 内存: ${CYAN}$((mem_total_kb / 1024))${NC} MB"
    echo -e "  带宽: ${CYAN}${mbps}${NC} Mbps | RTT: ${CYAN}${rtt}${NC} ms ${rtt_src} | BDP: ${CYAN}$((bdp_bytes / 1048576))${NC} MB"
    echo -e "  缓冲区上限: ${CYAN}$((buf_bytes / 1024 / 1024))${NC} MB  <- ${cap_reason}"
    if [ "$pool_bytes" -gt 0 ]; then
        echo -e "    TCP 全局池 (tcp_mem 上限): $((pool_bytes / 1048576)) MB，按本值可容纳约 $((pool_bytes / buf_bytes)) 条满载连接"
    fi

    ensure_sysctl_dir || { pause_return; return 1; }

    # 写入前先说清哪些 key 在本环境根本设不了，免得用户看完一屏"已写入"再去
    # verify 那段才发现一堆没生效。中转档的 ip_forward 也在受管清单里，一并预检
    sysctl_precheck "$MANAGED_KEYS"

    # 清掉旧版写的 99- 文件，避免两份配置并存（值不同时按字典序谁后加载谁赢，排查起来很坑）
    rm -f "$LEGACY_SYSCTL_OPT"

    takeover_conflicts

    # 容量类参数取 max(内核现值, 目标值)，避免在内核默认值更高的机器上反向调低
    local v_somax v_backlog v_rmem_max v_wmem_max v_rmem3 v_wmem3 reserved
    v_somax=$(sysctl_ceil net.core.somaxconn 65535)
    v_backlog=$(sysctl_ceil net.core.netdev_max_backlog 65535)
    v_rmem_max=$(sysctl_ceil net.core.rmem_max "$buf_bytes")
    v_wmem_max=$(sysctl_ceil net.core.wmem_max "$buf_bytes")
    v_rmem3=$(sysctl_ceil3 net.ipv4.tcp_rmem 4096 131072 "$buf_bytes")
    v_wmem3=$(sysctl_ceil3 net.ipv4.tcp_wmem 4096 16384 "$buf_bytes")
    # 保留端口要靠 ss 扫监听状态。缺了会导致放宽端口范围后业务端口可能被随机源端口占用，
    # 所以这里要装而不是静默跳过
    ensure_tools ss >/dev/null
    reserved=$(build_reserved_ports 32768 65535)

    refuse_if_symlink "$SYSCTL_OPT" || { pause_return; return 1; }
    # 主配置写失败必须中止：后面会 apply_sysctl 并报「配置持久化于 ...」，
    # 那时用户以为参数已经落地，而文件根本是空的或半截的
    if ! cat >"$SYSCTL_OPT" <<EOF
# ==================================================
# 由 tcpo v${SCRIPT_VERSION} 生成于 $(date '+%F %T')，档位 ${PROFILE}
#
# 缓冲区推导链（记下来是因为「为什么是这个数」三个月后没人记得，
# 而重新跑一遍未必得到同样的值——RTT 是实测的、内核默认值也会变）：
#   带宽        ${mbps} Mbps${link_note}
#   RTT         ${rtt} ms ${rtt_src}
#   BDP         ${mbps} x 125 x ${rtt} = $((bdp_bytes / 1048576)) MB
#   x2.5 余量   $((raw_target / 1048576)) MB   （留给丢包重传期间的在途数据）
#   内存 5%     $((mem_total_kb * 5 / 100 / 1024)) MB   （本机内存 $((mem_total_kb / 1024)) MB）
#   TCP 全局池  ${pool_note}
#   最终取值    $((buf_bytes / 1048576)) MB  <- ${cap_reason}
#
# 本机: $(nproc) 核 / $((mem_total_kb / 1024)) MB 内存 / 内核 $(uname -r)
# 回退: 运行 tcpo 选菜单 6（会连同运行时值一起还原到首次运行前的真实状态）
# ==================================================

# --- 队列与拥塞算法 ---
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr

# --- 连接容量（取 max(内核现值, 目标值)，不在默认值更高的机器上反向调低）---
net.core.somaxconn = ${v_somax}
net.core.netdev_max_backlog = ${v_backlog}
# 注意：现代内核里这个值不再决定 SYN 队列长度。inet_csk_reqsk_queue_is_full() 比的是
# sk_max_ack_backlog，它来自 listen() 的 backlog 参数、被 somaxconn 钳住。本参数如今只在
# syncookies 关闭时用于保留末 1/4 队列给「证明存活过」的对端。要真正放大半连接队列，
# 得让应用把 listen() backlog 传大（如 nginx listen ... backlog=）。
net.ipv4.tcp_max_syn_backlog = 16384
# SYN 洪泛时降级为无状态握手。内核默认已是 1，但常被各类面板脚本关掉，显式写回
net.ipv4.tcp_syncookies = 1

# --- 软中断收包预算（NAPI 单次轮询上限，内核默认 300 / 2000）---
# 抬高可减少高 PPS 下的 squeeze。是否真有收益看 /proc/net/softnet_stat 第 3 列有无增长，
# 菜单「诊断」会读这个数；若长期为 0 则本机不需要这两项
net.core.netdev_budget = 600
net.core.netdev_budget_usecs = 8000

# 出站随机源端口范围。不要从 1024 起：1024-32767 之间有大量服务默认端口
# (MySQL 3306 / Redis 6379 / PostgreSQL 5432 / 各类业务端口)，随机源端口一旦占用，
# 该服务重启时 bind 会失败报 Address already in use，概率低但极难归因。
# 下面的 ip_local_reserved_ports 会把当前监听中、且落在本范围内的端口排除掉。
net.ipv4.ip_local_port_range = 32768 65535
$(if [ -n "$reserved" ]; then
        echo "# 自动保留：以下端口在本次调优时处于监听状态且落在临时端口范围内，"
        echo "# 内核分配随机源端口时会跳过它们，避免业务重启时 bind 失败。"
        echo "# 新增服务后重跑菜单 3 可刷新此列表。"
        echo "net.ipv4.ip_local_reserved_ports = ${reserved}"
    else
        echo "# 未检测到落在 32768-65535 内的监听端口，无需保留（ip_local_reserved_ports 留空）"
    fi)

# --- 缓冲区（第三个值是上限，内核按需增长，不是预分配）---
# 中间值是新建 socket 的初始缓冲，不是上限。取值依据：
#   rmem 131072 —— 现代内核默认值（红帽 RHEL-25847 专门把 87380 抬到这里）。
#                   社区脚本普遍抄的 87380 是 2.6 时代的老默认值，写它等于把初始接收窗口往回压。
#   wmem 16384  —— 内核默认值，红帽 network-throughput / openshift 两个 profile 同值。
#                   发送缓冲有自动调优，把初值设大只会让每条连接起步多占内存；
#                   且下面已设 tcp_notsent_lowat 压住未发送队列，抬高初值没有对应收益。
net.core.rmem_max = ${v_rmem_max}
net.core.wmem_max = ${v_wmem_max}
net.ipv4.tcp_rmem = ${v_rmem3}
net.ipv4.tcp_wmem = ${v_wmem3}

# --- 跨境链路针对性 ---
# 限制未发送队列积压。取 128K 而非社区常见的 16K：16384 的出处是 Cloudflare 那篇
# HTTP/2 优先级文章，场景是 nginx 直接服务浏览器、要让高优先级响应尽快插队；
# 长肥网络转发是另一回事——写侧留太少会让每写一小块就等一次 epoll 唤醒，高 RTT 下出现空隙。
# 131072 是红帽 openshift profile 的取值，Cloudflare 高吞吐篇实测 466ms RTT 仍跑满 1Gbps
net.ipv4.tcp_notsent_lowat = 131072
# MTU 探测，解决部分运营商阻断 ICMP 造成的 PMTU 黑洞
net.ipv4.tcp_mtu_probing = 1
# UDP 最小接收缓冲，缓解 QUIC/Hysteria2 高并发丢包。
# 不设 udp_wmem_min——内核文档原文「UDP does not have tx memory accounting and this
# tunable has no effect」，写了不报错也不生效。UDP 发送侧要放大靠 net.core.wmem_max（已设）
# 加应用自己 setsockopt(SO_SNDBUF)
net.ipv4.udp_rmem_min = 16384
# 长连接空闲后不退回慢启动（对 SSE / 长轮询 / 视频流有效）
net.ipv4.tcp_slow_start_after_idle = 0
# 不把上次连接的 ssthresh/cwnd 缓存进路由 metrics。默认 0 会让跨境链路晚高峰一次拥塞留下的
# 低 ssthresh 被同一目的地址后续所有连接继承，表现为「刚才卡过之后一直上不去速」
net.ipv4.tcp_no_metrics_save = 1

# --- 连接回收 ---
# 不设 tcp_max_orphans——内核文档明写「you must not rely on this or lower the limit
# artificially, but rather increase it」，默认值 ehash_entries/2 随内存自动伸缩，
# 2GB 以上机器通常已超过社区常写的 32768，写死反而是在降低它；而本脚本把 wmem_max 抬到了
# 数十 MB，每个 orphan 最坏能吃一个 wmem 上限，固定 orphan 数的账算不出来
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_fastopen = 3

$(if [ "$PROFILE" = "transit" ]; then
        echo "# --- 中转档专属：本机要为别的流量做转发 ---"
        echo "# 只在中转/代理/隧道节点开。普通业务机开了等于把自己变成路由器，"
        echo "# 配上不当的防火墙规则可能成为开放中继"
        echo "net.ipv4.ip_forward = 1"
    else
        echo "# 普通档不开 IP 转发（ip_forward 保持系统原值）。中转/代理/隧道节点请用菜单 4 的中转档"
    fi)

# --- 可选项：按需自行放开 ---
# ECN 默认值 2（被动接受）。设为 1 是主动请求，遇到老旧中间设备可能丢 SYN，故不默认开启
# net.ipv4.tcp_ecn = 1
# 重传次数默认 15（约 15 分钟）。降到 8（约 100 秒）更快失败换路，但长静默连接可能被误断
# net.ipv4.tcp_retries2 = 8

# ==================================================
# 以下是「故意不设」的参数，社区脚本普遍在写，但对本场景无效或有害。
# 记录理由是为了防止后续版本把有意的省略当成遗漏「补上」。
# ==================================================
# tcp_mem / udp_mem   单位是页不是字节，社区脚本大面积搞错（见过写出 256GB 的）。
#                     内核按空闲内存自动分三档，ESnet 原话 leave net.tcp_mem at its defaults；
#                     红帽曾专门提交 commit 删掉显式 udp_mem，理由是没考虑用户内存大小
# tcp_adv_win_scale   6.6 起内核文档标注 Obsolete，已换成 per-socket 的 scaling_ratio
#                     （按 skb->len/skb->truesize 实测），唯一消费者不再读取该字段。
#                     能写入、不报错、完全无效。社区还在抄的 -2 在 6.6+ 上已失去意义
# tcp_tw_recycle      4.12 起从内核删除，写了 sysctl --system 会报 unknown key。
#                     删除前也有害：按对端 IP 记时间戳，NAT 后多客户端会被误判丢 SYN
# tcp_fack            5.4 起内核文档：this is a legacy option, it has no effect anymore
# tcp_low_latency     4.14 起同上，一字不差
# ipfrag_low_thresh   4.17 起标注 Obsolete
# tcp_max_tw_buckets  文档同样写 must not lower artificially。社区常写的 5000 会让超限的
#                     TIME_WAIT socket 被立即销毁，等于绕过 TIME_WAIT 语义、人为制造
#                     RFC1337 风险，只为让 ss | wc -l 的数字好看
# tcp_sack / tcp_dsack / tcp_timestamps / tcp_window_scaling
#                     硬化类脚本为省 CPU 或防指纹把它们设 0，对长肥网络是灾难：没有 SACK
#                     一次丢包只能靠累积确认恢复，没有时间戳 PAWS 和 RTT 估计都失效，
#                     关掉窗口缩放等于把窗口锁在 64KB。ESnet 明确反对为 WAN 关闭它们
# rp_filter           是安全项不是性能项，且 all 设 1 后无法在单个接口降回
#                     （内核取 conf/{all,interface} 的较大值）。代理机常有多网卡 / WireGuard /
#                     策略路由的非对称回程，设 1 会静默丢包。取值取决于用户的路由拓扑，
#                     不该由通用脚本代做决定
# tcp_rfc1337         同为安全项。内核默认 0 时本来就有 TIME_WAIT assassination 防护，
#                     设 1 会丢弃 TIME_WAIT 状态的 RST，代理机遇到对端异常重置时要多等一个
#                     完整 TIME_WAIT
# busy_poll/busy_read 用满核 CPU 换微秒级延迟。跨境链路的瓶颈是 RTT 不是本机中断，
#                     VPS 上烧 CPU 有直接成本。红帽只在 network-latency profile 里设它，
#                     network-throughput 一个字都没有
# rmem_default / wmem_default
#                     这是每 socket 的默认值而非上限，抬高对 UDP 尤其浪费（每个 socket
#                     实打实占用）。上限交给 rmem_max/wmem_max，初始值交给 tcp_rmem/tcp_wmem
# optmem_max          社区普遍写 65536，但内核文档说默认是 128KB（net.rst 原文
#                     "Maximum ancillary buffer size allowed per socket"，Default: 128 KB）。
#                     这个默认值随内核版本变过，写死 65536 在新内核上是往下调。
#                     而且它管的是 cmsg 辅助数据不是收发缓冲，对吞吐没有直接关系
# initcwnd / initrwnd 内核默认已是 RFC 6928 背书的 IW10，而 RFC 原文明说 10 以上
#                     "results are mixed" 且不提供支持证据。社区取值 20/30/50/64/100
#                     全无依据，加大还会抬高初始突发的丢包风险（RFC 自己的实测里
#                     重传率上升、SlowDC 的尾延迟反而恶化）。另外它写在路由属性上，
#                     DHCP 续租重装默认路由后会静默失效，要保住得再挂一层 dispatcher 钩子
# txqueuelen          红帽 tuned 提供了这个 option 但没有任何内置 profile 使用它。
#                     给出具体数字的权威来源只有 ESnet/OSG 那份，而它的阶梯是给
#                     10G 起步的专用数据传输节点的。本脚本已用 default_qdisc=fq 做整形、
#                     用 tcp_notsent_lowat 压未发送队列，再加深发送队列方向相反
EOF
    then
        echo -e "  ${RED}写入 $SYSCTL_OPT 失败（磁盘满 / 只读挂载 / 权限），内核参数未配置${NC}"
        echo -e "  ${YELLOW}已接管的冲突文件备份在 $STATE_DIR，可用菜单 6 回退${NC}"
        pause_return
        return 1
    fi

    apply_sysctl

    # 句柄上限的硬顶是 fs.nr_open，超过它 setrlimit 会被内核拒绝（实测报
    # "Operation not permitted"）。所以目标值要取 min(想要的, nr_open)——
    # 社区脚本普遍写死 1048576 或更大而不看 nr_open，在 nr_open 较低的内核上
    # 会让 limits.conf 整行失效（PAM 报错但用户看不到）
    local nofile_want=1048576 nr_open
    nr_open=$(sysctl -n fs.nr_open 2>/dev/null)
    case "$nr_open" in
    '' | *[!0-9]*) nr_open=1048576 ;;
    esac
    [ "$nofile_want" -gt "$nr_open" ] && nofile_want=$nr_open

    mkdir -p /etc/security/limits.d/
    # 句柄上限不是核心网络参数，是链接就跳过这一项、其余照做（不像 sysctl 主配置
    # 那样中止整个菜单）。严重度分级：核心参数写不了要停，附属项写不了只提示
    if refuse_if_symlink "$LIMITS_OPT"; then
        if ! cat >"$LIMITS_OPT" <<EOF
# 由 tcp-dashboard 写入。nofile 取 min(1048576, fs.nr_open=${nr_open})——
# 硬限超过 fs.nr_open 时 setrlimit 会被内核拒绝，整行静默失效
* soft nofile ${nofile_want}
* hard nofile ${nofile_want}
* soft nproc 65535
* hard nproc 65535
root soft nofile ${nofile_want}
root hard nofile ${nofile_want}
EOF
        then
            # 句柄上限是附属项，写不成只提示、其余照做（与上面链接分支同一处置）
            echo -e "  ${YELLOW}写入 $LIMITS_OPT 失败，句柄上限未改动${NC}"
        fi
    else
        echo -e "  ${YELLOW}跳过 limits.d（见上），句柄上限未改动${NC}"
    fi

    # limits.d 只走 PAM，systemd 启动的服务不经过 PAM——而 xray / nginx / sing-box
    # 这些最需要高 fd 的进程恰恰都是 systemd 服务。它们的上限来自 systemd 的
    # DefaultLimitNOFILE（unit 里没显式写 LimitNOFILE 时）。
    #
    # 写法参照 CachyOS 官方设置的 usr/lib/systemd/system.conf.d/10-limits.conf：
    # 用「软:硬」两段式而不是把软限也拉满——软限拉满会让那些按 RLIMIT_NOFILE 大小
    # 预分配 fd 表的老程序吃掉大量内存（select() 的 FD_SETSIZE 问题同源）。
    # 软限留小、让需要的进程自己 setrlimit 抬到硬限，是 systemd 自己的默认策略。
    # 硬限同样受 fs.nr_open 约束
    if has_systemd; then
        if mkdir -p "$(dirname "$SYSTEMD_LIMITS_OPT")" 2>/dev/null &&
            printf '[Manager]\nDefaultLimitNOFILE=2048:%s\n' "$nofile_want" |
            atomic_write "$SYSTEMD_LIMITS_OPT"; then
            echo -e "  已写 systemd 全局句柄上限 ${CYAN}2048:${nofile_want}${NC}（$SYSTEMD_LIMITS_OPT）"
            echo -e "  ${YELLOW}注意：已在运行的服务不受影响。要让它生效：${NC}"
            echo -e "  ${CYAN}    systemctl daemon-reexec && systemctl restart <你的服务>${NC}"
            echo -e "  ${YELLOW}  或重启机器。unit 里显式写了 LimitNOFILE 的服务优先级更高，需单独改${NC}"
        else
            echo -e "  ${YELLOW}systemd 全局句柄上限写入失败，systemd 服务的 fd 上限未改动${NC}"
        fi
    else
        echo -e "  ${YELLOW}本机不由 systemd 管理，跳过 systemd 全局句柄上限${NC}"
    fi

    # MSS clamp 只在中转档加。理由：
    #   1) 它的作用对象是「经过本机转发」的 TCP 连接，普通业务机没有这类流量，加了是空规则；
    #   2) 本机自己发起/接收的连接由已设的 tcp_mtu_probing 处理，功能重叠；
    #   3) 规则挂 FORWARD 链而非原来的 POSTROUTING——POSTROUTING 在 mangle 表虽然也能改到
    #      转发包，但同时会碰到本机 OUTPUT 出去的包，语义不清；FORWARD 才是转发路径的专用链
    if [ "$PROFILE" = "transit" ]; then
        # 中转档必须有 iptables，缺了就装（RHEL/Fedora/openSUSE/Alpine 的最小化安装都不自带）
        if ensure_tools iptables >/dev/null; then
            # 先清掉本脚本以前加的（含旧版无 comment 的），再加带 comment 的新规则。
            # 不能只靠精确文本匹配删除——见 del_owned_mss 的说明
            del_owned_mss >/dev/null
            if dryrun_skip "iptables -t mangle -A FORWARD ... TCPMSS --clamp-mss-to-pmtu"; then
                :
            elif iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN \
                -m comment --comment "$MSS_TAG" -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null; then
                echo -e "${GREEN}  已加 MSS Clamp 规则到 mangle FORWARD（标记 $MSS_TAG）${NC}"
                echo -e "  ${YELLOW}iptables 规则重启即失效，要持久化请装 iptables-persistent 并 netfilter-persistent save${NC}"
            elif iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN \
                -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null; then
                # comment 模块（xt_comment）在极简内核上可能缺失，降级到无标记规则。
                # 代价是回退时只能靠精确文本匹配，与用户自己加的同款规则无法区分
                echo -e "${GREEN}  已加 MSS Clamp 规则到 mangle FORWARD${NC}"
                echo -e "  ${YELLOW}本机缺 xt_comment 模块，规则未带所有权标记；回退时若你自己也加过同样的规则，可能一并删掉${NC}"
            else
                echo -e "  ${YELLOW}MSS Clamp 规则添加失败（内核缺 xt_TCPMSS 模块或权限不足），已跳过${NC}"
            fi
        else
            echo -e "  ${YELLOW}iptables 不可用且自动安装失败，跳过 MSS Clamp。${NC}"
            echo -e "  ${YELLOW}手动补: iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu${NC}"
        fi
    fi

    echo -e "\n${GREEN}完成，前后对比：${NC}"
    draw_line
    printf "  %-12s: %-14s -> %s\n" "拥塞算法" "$old_cc" "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)"
    printf "  %-12s: %-14s -> %s\n" "somaxconn" "$old_somax" "$(sysctl -n net.core.somaxconn 2>/dev/null)"
    # 读不到就显示「不可读」而不是 0MB——容器里 net.core.* 不在命名空间内，
    # 显示 0MB 会让人以为参数被清零了
    local new_rmem
    new_rmem=$(sysctl -n net.core.rmem_max 2>/dev/null)
    if [ -n "$new_rmem" ]; then
        printf "  %-12s: %-14s -> %s\n" "缓冲区上限" "$((old_rmem / 1024 / 1024))MB" "$((new_rmem / 1024 / 1024))MB"
    else
        printf "  %-12s: %-14s -> %s\n" "缓冲区上限" "$((old_rmem / 1024 / 1024))MB" "不可读(容器环境)，配置文件已写 $((buf_bytes / 1024 / 1024))MB"
    fi
    draw_line

    verify_sysctl_applied
    # 先逐条校验「本次是否生效」，再报「开机还会不会生效」。两件事分开说：
    # 无 systemd 的机器上前者全绿、后者是不会，混成一句「已持久化」就是假报成功
    report_sysctl_persist "$SYSCTL_OPT"

    echo -e "  ${YELLOW}注意：limits.d 只对登录 shell 生效；systemd 服务已由上面的 DefaultLimitNOFILE 覆盖。${NC}"
    echo -e "  ${YELLOW}      Docker 容器内的进程更是完全不受宿主 limits 影响（要改得用 docker run --ulimit）${NC}"
    pause_return
}

# 逐项比对「配置文件里写的」与「sysctl 实际生效的」，每行输出一条判定，
# 字段用 TAB 分隔：<OK|BAD|ABSENT>\t<key>\t<期望>\t<实际>
# 分隔符必须是 TAB 而不是空格：tcp_rmem/tcp_wmem/ip_local_port_range 的值本身带空格，
# 按空格切会把三元组切碎（曾用 "[want] [got]" 格式，${rest% *} 在三元组上取出半截值）
# 提成独立函数是因为主菜单的状态标记也要用同一份判据——两处各写一遍比较逻辑，
# 迟早漂成「详情页说没生效、菜单显示已开启」
sysctl_diff_lines() {
    local conf=$1 key want got line
    [ -f "$conf" ] || return 0
    while IFS= read -r line; do
        case "$line" in '' | '#'*) continue ;; esac
        key=${line%%=*}
        want=${line#*=}
        key=$(echo "$key" | tr -d ' \t')
        want=$(echo "$want" | tr -s ' \t' ' ' | sed 's/^ //;s/ $//')
        [ -z "$key" ] && continue
        # 空串是 ip_local_reserved_ports 的合法值，所以判「读不到」只能看退出码，
        # 不能看值是否为空（AGENTS.md 记过这个判例）
        if ! got=$(sysctl -n "$key" 2>/dev/null); then
            printf 'ABSENT\t%s\t%s\t\n' "$key" "$want"
            continue
        fi
        got=$(printf '%s' "$got" | tr -s ' \t' ' ' | sed 's/^ //;s/ $//')
        if [ "$got" = "$want" ]; then
            printf 'OK\t%s\t%s\t%s\n' "$key" "$want" "$got"
        else
            printf 'BAD\t%s\t%s\t%s\n' "$key" "$want" "$got"
        fi
    done <"$conf"
}

# 配置文件里有没有「写了但没生效」的项（只数 BAD，ABSENT 不算——容器里读不到属正常）。
# 主菜单用它区分「配置在且生效」与「配置在但没生效」，后者正是无 systemd 机器重启后的状态
sysctl_conf_stale() {
    sysctl_diff_lines "$1" | grep -q '^BAD'
}

# 写入前预检：这个 key 在本内核到底能不能设。
# 与 verify_sysctl_applied 的分工是「事前」与「事后」——后者能发现失败，前者能提前
# 说清原因。三种结果对应三种完全不同的处置：
#   MISSING 本内核没有这个参数（版本太老、或编译时没开对应 CONFIG）→ 跳过，不是错误
#   RO      路径在但不可写（非特权 LXC / 只读 /proc / 容器命名空间外）→ 无能为力，如实说
#   WRITABLE 可写
# 判据用 /proc/sys 路径而不是 sysctl -n：后者读得到不代表写得进去（容器里 net.core.*
# 常常可读不可写），而回退依赖「改过什么」的准确记录，猜不得
sysctl_writable() {
    local path
    # 用 tr 而不是 ${1//./\/}：后者在不同 shell 下对 \/ 的处理不一致（zsh 会把反斜杠
    # 当字面量留下，得到 net\/core\/rmem_max 这种路径，于是一律判成 MISSING）。
    # 本脚本虽然是 bash，但这种「换个 shell 就静默全错」的写法不值得留
    path="/proc/sys/$(printf '%s' "$1" | tr '.' '/')"
    if [ ! -e "$path" ]; then
        echo MISSING
    elif [ ! -w "$path" ]; then
        echo RO
    else
        echo WRITABLE
    fi
}

# 对一份 key 清单做预检并打印汇总。只报告不阻断——即使全部不可写也要把配置文件写下去，
# 因为用户可能是在容器里为宿主准备配置，或稍后会用特权模式重跑
sysctl_precheck() {
    local keys=$1 k st missing="" ro="" n_ok=0
    for k in $keys; do
        st=$(sysctl_writable "$k")
        case "$st" in
        MISSING) missing="${missing} $k" ;;
        RO) ro="${ro} $k" ;;
        *) n_ok=$((n_ok + 1)) ;;
        esac
    done
    if [ -z "$missing" ] && [ -z "$ro" ]; then
        echo -e "  写入前预检: ${GREEN}${n_ok} 项全部可写${NC}"
        return 0
    fi
    echo -e "  写入前预检: ${GREEN}${n_ok}${NC} 项可写"
    if [ -n "$missing" ]; then
        echo -e "    ${YELLOW}本内核不存在（将被跳过，非错误）:${NC}"
        echo -e "${YELLOW}$(wrap_keys "$missing")${NC}"
    fi
    if [ -n "$ro" ]; then
        echo -e "    ${YELLOW}路径存在但不可写（容器命名空间外 / 非特权 LXC）:${NC}"
        echo -e "${YELLOW}$(wrap_keys "$ro")${NC}"
        echo -e "    ${YELLOW}这些项写进配置文件但不会在本环境生效，需在宿主机上设置${NC}"
    fi
    return 0
}

# 把一串 key 折行成缩进段落。受管清单有二十多项，逐行输出会刷掉半屏。
# 不用 fmt：它不在 POSIX 必备工具里，busybox 环境常缺（缺了整段输出就没了）
wrap_keys() {
    printf '%s\n' $1 | awk '
        { if (length(line) + length($1) + 1 > 62) { print "      " line; line = "" }
          line = line (line == "" ? "" : " ") $1 }
        END { if (line != "") print "      " line }'
}

# 写进 /etc/sysctl.d/ 不等于生效——被后加载的文件覆盖、内核不支持该参数、模块没加载，
# 三种情况都静默失败，sysctl --system 的报错还常被 &>/dev/null 吞掉。
# 判例：somaxconn 写了 65535，被发行版自带的 99-sysctl.conf 盖回 1024，无任何提示
verify_sysctl_applied() {
    local mismatch=0 absent=0 total=0 in_container=0 verdict key want got
    is_container && in_container=1

    # IFS 只设 TAB：值里带空格（三元组）时按空格切会把字段切碎
    while IFS=$'\t' read -r verdict key want got; do
        [ -z "$verdict" ] && continue
        total=$((total + 1))
        case "$verdict" in
        ABSENT)
            # 读不到有两种含义：容器里 net.core.* 不在命名空间内（正常），
            # 或真机上参数名写错/内核太老（要修）。不能算进「全部生效」
            absent=$((absent + 1))
            [ "$in_container" = "0" ] && echo -e "  ${YELLOW}? $key 本内核无此参数${NC}"
            ;;
        BAD)
            echo -e "  ${RED}✗ $key 期望 [$want] 实际 [$got]${NC}"
            mismatch=$((mismatch + 1))
            ;;
        esac
    done <<EOF
$(sysctl_diff_lines "$SYSCTL_OPT")
EOF

    local applied=$((total - mismatch - absent))
    if [ "$mismatch" -gt 0 ]; then
        echo -e "  ${RED}有 $mismatch 项没真正生效（共 $total 项，已生效 $applied 项）${NC}"
        if [ "$in_container" = "1" ]; then
            echo -e "  ${YELLOW}检测到容器环境：net.core.* 等多数参数在容器内是只读的，这属正常，不是脚本问题${NC}"
        else
            echo -e "  ${YELLOW}最常见原因：/etc/sysctl.d/ 里有字典序更靠后的文件覆盖了同名参数。排查：${NC}"
            echo -e "  ${YELLOW}    grep -rn '<参数名>' /etc/sysctl.d/ /etc/sysctl.conf${NC}"
            echo -e "  ${YELLOW}    菜单 3 已会自动接管冲突文件，若仍不一致请看 $APPLY_LOG${NC}"
        fi
    elif [ "$absent" -gt 0 ]; then
        if [ "$in_container" = "1" ]; then
            echo -e "  ${GREEN}✓ 已生效 $applied 项${NC}${YELLOW}，另有 $absent 项在容器命名空间外（宿主机才有，属正常）${NC}"
        else
            echo -e "  ${GREEN}✓ 已生效 $applied 项${NC}${YELLOW}，另有 $absent 项本内核不支持（上面已列出）${NC}"
        fi
    else
        echo -e "  ${GREEN}✓ 配置项已逐条校验，全部 $total 项实际生效${NC}"
    fi
}

# ==================================================
# --- 4. 网卡多队列 / RPS ---
# ==================================================
# 生成 N 个 CPU 全开的掩码，格式为逗号分隔的 32 位字、高位在前（内核 bitmap 格式）。
# 不能用 printf '%x' $(((1 << n) - 1))：bash 算术是 64 位，n>=64 时移位溢出得 0
# （等于关闭 RPS），且 33-63 核算出的连续长十六进制串内核不接受。
# 实测对照 —— 64 核旧写法得 0、128 核得 0、33 核得 1ffffffff 都是错的
cpu_mask_all() {
    local n=$1 i out="" bits w words
    # words 必须单独一行赋值：同一条 local 语句里引用刚赋值的 n，展开时 n 还看不到值
    words=$(((n + 31) / 32))
    for ((i = words - 1; i >= 0; i--)); do
        bits=$((n - i * 32))
        [ "$bits" -gt 32 ] && bits=32
        if [ "$bits" -ge 32 ]; then
            w=ffffffff
        else
            w=$(printf '%08x' $(((1 << bits) - 1)))
        fi
        out="${out:+$out,}$w"
    done
    echo "$out"
}

# 掩码是否表示「已启用」。内核会重排掩码格式（补零、改分组），字符串相等比较不可靠，
# 判「去掉 0 和逗号后还有内容」才对
mask_is_set() {
    case "$(echo "$1" | tr -d '0,[:space:]')" in
    '') return 1 ;;
    *) return 0 ;;
    esac
}

# 候选物理网卡：排除回环与各类虚拟设备
phys_ifaces() {
    ls /sys/class/net 2>/dev/null | grep -vE '^(lo|docker|veth|br-|virbr|tun|tap|wg|sit|gre|vxlan|bond.*\.|any|dummy|ifb|nlmon|teql)'
}

# 网卡硬件收队列数（RSS）。ethtool -l 的 Current 段 Combined，取不到退回 rx-* 目录数
nic_hw_queues() {
    local eth=$1 n
    n=$(ethtool -l "$eth" 2>/dev/null | awk '/Current hardware settings/,0' | awk '/^Combined:/{print $2; exit}')
    case "$n" in '' | *[!0-9]*) n=$(ls -d /sys/class/net/"$eth"/queues/rx-* 2>/dev/null | wc -l) ;; esac
    echo "${n:-0}"
}

# ==================================================
# --- 4. 网卡多队列 / RPS / RFS / XPS ---
# ==================================================
tune_nic() {
    echo -e "\n${YELLOW}>>> 网卡队列与软中断分发${NC}"
    save_original_values || { pause_return; return 1; }
    # ethtool 用来读硬件队列数和丢包计数。缺了不致命（会退回数 rx-* 目录），但装上判断更准。
    # 旧版这里只写了 apt-get 和 yum，在 openSUSE/Arch/Alpine 上是静默失败的
    if ! ensure_tools ethtool >/dev/null; then
        echo -e "  ${YELLOW}ethtool 不可用，硬件队列数改用 rx-* 目录数估算，ring buffer 丢包检查跳过${NC}"
    fi

    local cpu_count mask flow_entries plan_tmp done_any=0
    cpu_count=$(nproc)
    mask=$(cpu_mask_all "$cpu_count")
    # RFS 全局表大小，按核数给，钳到 [32768, 262144]
    flow_entries=$((cpu_count * 4096))
    [ "$flow_entries" -lt 32768 ] && flow_entries=32768
    [ "$flow_entries" -gt 262144 ] && flow_entries=262144

    mkdir -p "$STATE_DIR"
    plan_tmp=$(mktemp)

    # RFS 全局表必须先分配，再配每队列的 rps_flow_cnt——顺序反了的话单队列表配了也没有全局表可用。
    # 写进独立的 drop-in 文件而不是追加到 $SYSCTL_OPT：本菜单可以单独执行（用户没跑过菜单 3/4），
    # 那时 $SYSCTL_OPT 不存在，追加式写法会静默丢掉持久化，重启后 /sys 下的 plan 被 unit 重放了、
    # 但全局流表是 0，RFS 处于半失效状态
    [ "$DRYRUN" = "1" ] || sysctl -w net.core.rps_sock_flow_entries="$flow_entries" &>/dev/null
    # 写失败必须中止：RFS 的全局流表是每队列 rps_flow_cnt 的前提，这份文件没落地
    # 就等于重启后全局表是 0、而各队列的 rps_flow_cnt 被 $NIC_APPLY 重放了回来——
    # RFS 处于半失效状态，而面板会照常报「已开启+持久化」。
    # [人工决策-2026-08-05 20:14:33] 原先写成 A && B && cat >... 的 && 链，cat 失败后
    # 函数照样往下走到 apply_sysctl 并返回 0（/dev/full 可复现）。这种 && 链形式还逃过了
    # 「无裸写 cat」的通用机检（它只匹配行首的 cat >），机检判据已一并修正
    if ! ensure_sysctl_dir || ! refuse_if_symlink "$NIC_SYSCTL_OPT" ||
        ! cat >"$NIC_SYSCTL_OPT" <<EOF
# 由 tcp-dashboard 菜单 5 写入。RFS 全局流表大小，随 CPU 核数计算。
# 每队列的 rps_flow_cnt = 本值 / 队列数，由 $NIC_APPLY 在开机时重放。
net.core.rps_sock_flow_entries = ${flow_entries}
EOF
    then
        echo -e "  ${RED}写入 $NIC_SYSCTL_OPT 失败，RFS 全局流表未持久化${NC}"
        echo -e "  ${YELLOW}继续下去会让重启后「每队列有 rps_flow_cnt、全局表是 0」——RFS 半失效${NC}"
        # 早退也要清临时文件：函数尾部那个 rm 走不到，每次命中这条路径就残留一个
        rm -f "$plan_tmp"
        pause_return
        return 1
    fi
    # 老版本可能把这一项追加在主配置文件里，清掉避免两处并存
    [ -f "$SYSCTL_OPT" ] && sed -i '/^net\.core\.rps_sock_flow_entries/d' "$SYSCTL_OPT"
    apply_sysctl

    local eth hwq nqueues per_flow
    for eth in $(phys_ifaces); do
        hwq=$(nic_hw_queues "$eth")
        nqueues=$(ls -d /sys/class/net/"$eth"/queues/rx-* 2>/dev/null | wc -l)
        [ "$nqueues" -eq 0 ] && continue

        # 硬件队列已经够多时不开 RPS：RSS 已经把包分到各核，再叠一层软件分发只是多一次
        # IPI 和跨核唤醒，延迟反而升高。内核 scaling.rst 也是这个说法
        if [ "$hwq" -ge "$cpu_count" ] && [ "$hwq" -gt 1 ]; then
            echo -e "  ${CYAN}$eth${NC} 硬件队列 $hwq 个（>= $cpu_count 核），RSS 已足够，跳过 RPS"
        else
            [ "$hwq" -gt 1 ] && echo -e "  ${CYAN}$eth${NC} 硬件队列 $hwq 个 < $cpu_count 核，用 RPS 补足软中断分摊"
            per_flow=$((flow_entries / nqueues))
            for f in /sys/class/net/"$eth"/queues/rx-*/rps_cpus; do
                [ -f "$f" ] || continue
                # 重定向失败的报错由 shell 打印，必须包住整个复合命令才吞得掉（只读 /sys 常见）
                if [ "$DRYRUN" = "1" ]; then
                    echo -e "$f\t$mask" >>"$plan_tmp"
                    done_any=1
                elif { echo "$mask" >"$f"; } 2>/dev/null; then
                    echo -e "$f\t$mask" >>"$plan_tmp"
                    done_any=1
                fi
            done
            # rps_flow_cnt 应为 全局表/队列数，而非以前固定的 4096
            for f in /sys/class/net/"$eth"/queues/rx-*/rps_flow_cnt; do
                [ -f "$f" ] || continue
                if [ "$DRYRUN" = "1" ]; then
                    echo -e "$f\t$per_flow" >>"$plan_tmp"
                elif { echo "$per_flow" >"$f"; } 2>/dev/null; then
                    echo -e "$f\t$per_flow" >>"$plan_tmp"
                fi
            done
        fi

        # XPS（发送侧）：把每个 tx 队列绑到一组 CPU，减少多核并发发送时的队列锁竞争。
        # 之前完全没做。有多个 tx 队列时按队列轮转分配 CPU，单队列就全核
        local txn i cpu xmask
        txn=$(ls -d /sys/class/net/"$eth"/queues/tx-* 2>/dev/null | wc -l)
        if [ "$txn" -gt 0 ]; then
            i=0
            for f in /sys/class/net/"$eth"/queues/tx-*/xps_cpus; do
                [ -f "$f" ] || continue
                if [ "$txn" -ge 2 ] && [ "$cpu_count" -ge 2 ]; then
                    cpu=$((i % cpu_count))
                    xmask=$(cpu_mask_one "$cpu_count" "$cpu")
                else
                    xmask=$mask
                fi
                if [ "$DRYRUN" = "1" ]; then
                    echo -e "$f\t$xmask" >>"$plan_tmp"
                    done_any=1
                elif { echo "$xmask" >"$f"; } 2>/dev/null; then
                    echo -e "$f\t$xmask" >>"$plan_tmp"
                    done_any=1
                fi
                i=$((i + 1))
            done
        fi

        # ring buffer 改为按需：拉满能减少突发丢包，但抬高排队延迟、加剧网卡级 bufferbloat，
        # 且已知会瞬断几百毫秒。先看驱动计数器有没有真的丢包再决定
        local drops
        drops=$(ethtool -S "$eth" 2>/dev/null | grep -iE 'drop|over|miss|fifo' |
            awk -F: '{gsub(/ /,"",$2); s+=$2} END{print s+0}')
        if [ "${drops:-0}" -gt 0 ]; then
            echo -e "  ${YELLOW}$eth 驱动计数器有 ${drops} 次丢包/溢出，可考虑加大 ring buffer${NC}"
            echo -e "  ${YELLOW}  命令: ethtool -G $eth rx <max> tx <max>（会瞬断几百毫秒，请在低峰执行）${NC}"
            echo -e "  ${YELLOW}  上限查询: ethtool -g $eth${NC}"
        fi
    done

    if [ "$done_any" = "1" ]; then
        # plan 是开机重放脚本唯一消费的状态文件——它没落地就装 unit，等于装一个开机
        # 读不到数据、什么都不做的服务，而面板会报「已启用并校验通过」。
        # [人工决策-2026-08-05 22:14:38] 原先是裸 `sort -u > "$NICPLAN"` 不查返回值，
        # /dev/full 复现：sort 已报 No space left on device，后续仍装 unit 并报成功、rc=0。
        # 走 atomic_write 一并拿到链接防护与原子性（写一半断电不会留半截 plan）
        if ! sort -u "$plan_tmp" | atomic_write "$NICPLAN"; then
            echo -e "  ${RED}写入 $NICPLAN 失败，开机重放清单没落地${NC}"
            echo -e "  ${YELLOW}当前会话的队列设置已生效，但重启后不会恢复；不安装开机单元${NC}"
            rm -f "$plan_tmp"
            pause_return
            return 1
        fi
        echo -e "${GREEN}完成：RPS/XPS 掩码 $mask（$cpu_count 核），RFS 全局表 $flow_entries${NC}"
        if install_nic_unit; then
            echo -e "  ${GREEN}开机单元 $(basename "$NIC_UNIT") 已启用并校验通过，重启后仍生效${NC}"
        else
            echo -e "  ${YELLOW}未能启用开机单元，/sys 下的设置重启后会失效（详见上面的原因）${NC}"
        fi
    else
        echo -e "${YELLOW}未改动：没找到可写的网卡队列（容器或只读 /sys 环境常见）${NC}"
    fi
    rm -f "$plan_tmp"
    pause_return
}

# 单个 CPU 的掩码（供 XPS 逐队列绑核）
cpu_mask_one() {
    local n=$1 cpu=$2 i out="" w words
    words=$(((n + 31) / 32))
    for ((i = words - 1; i >= 0; i--)); do
        if [ $((cpu / 32)) -eq "$i" ]; then
            w=$(printf '%08x' $((1 << (cpu % 32))))
        else
            w=00000000
        fi
        out="${out:+$out,}$w"
    done
    echo "$out"
}

# /sys 下的设置重启即失效。用一个 oneshot unit 在开机时重放 plan。
# unit 里不调用本脚本的函数——bash 不 hoist 函数定义，「参数分发在文件头、函数在后面」
# 的写法会让 unit 报 command not found 却仍 exit 0，systemctl status 显示成功而实际什么都没做
# （社区里有脚本正是这么翻车的）。所以生成一个独立的、只读 plan 的小脚本
# has_systemd 定义在「环境探测」小节（菜单 2/3/4 判持久化也要用它，必须早于本处定义）

# 返回 0 表示 unit 确实已 enable。状态判据用它，而不是「unit 文件存在」——
# 文件是我们无条件写的，写成功不代表 systemd 接受了它
nic_unit_enabled() {
    has_systemd || return 1
    [ -f "$NIC_UNIT" ] || return 1
    systemctl is-enabled "$(basename "$NIC_UNIT")" 2>/dev/null | grep -q '^enabled$'
}

install_nic_unit() {
    if ! has_systemd; then
        echo -e "  ${YELLOW}本机不由 systemd 管理（WSL / 容器 / sysvinit），无法安装开机单元${NC}"
        # 应用脚本仍然写出来，方便用户自己挂。写不成要如实说——
        # 后面那些「已生成开机重放脚本」的提示都以它落地为前提
        if ! write_nic_apply; then
            echo -e "  ${RED}辅助脚本未能写出（原因见上），无法提供任何形式的开机重放${NC}"
            return 1
        fi
        # 本菜单还往 $NIC_SYSCTL_OPT 写了 RFS 全局流表（rps_sock_flow_entries），
        # 那是个 sysctl 参数、不在 nic.plan 里，$NIC_APPLY 不重放它。
        # 只挂 nic-apply 的话重启后每队列 rps_flow_cnt 回来了、全局表却是 0，
        # RFS 处于半失效状态。所以这里也要把 sysctl 重放脚本备好，并让用户一次挂对：
        # sysctl-apply 内部已经会调 nic-apply，挂它一个就够
        if is_container; then
            echo -e "  ${YELLOW}当前设置本次有效，重启后失效。容器的持久化由宿主决定${NC}"
            return 1
        fi
        if write_sysctl_apply; then
            echo -e "  ${YELLOW}当前设置本次有效，重启后失效${NC}"
            echo -e "  ${GREEN}已生成开机重放脚本 $SYSCTL_APPLY${NC}（含 RFS 全局表与本菜单的队列设置）"
            wsl_boot_hint
        else
            echo -e "  ${YELLOW}当前设置本次有效，重启后失效。如需持久化请自行把 $NIC_APPLY 挂到你的 init 流程${NC}"
            echo -e "  ${YELLOW}注意 $NIC_APPLY 不含 RFS 全局表，还需自行重放 $NIC_SYSCTL_OPT${NC}"
        fi
        return 1
    fi

    # helper 是 unit 的 ExecStart 目标。它没落地就装 unit，等于装一个开机必然
    # 报 status=203/EXEC 的服务，而 systemctl enable 会成功——那就是假报持久化
    if ! write_nic_apply; then
        echo -e "  ${RED}辅助脚本未能写出（原因见上），不安装开机单元${NC}"
        echo -e "  ${YELLOW}  否则会装出一个开机必定失败的服务，且 systemctl enable 仍会成功${NC}"
        return 1
    fi

    refuse_if_symlink "$NIC_UNIT" || return 1
    # 写失败就别往下 enable 了：那会 enable 一个内容不完整的 unit，
    # 而 systemctl enable 仍可能成功，于是面板报「已启用并校验通过」
    if ! cat >"$NIC_UNIT" <<UNITEOF
[Unit]
Description=tcp-dashboard: apply RPS/RFS/XPS queue settings
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$NIC_APPLY

[Install]
WantedBy=multi-user.target
UNITEOF
    then
        echo -e "  ${RED}写入 $NIC_UNIT 失败（磁盘满 / 只读挂载 / 权限），开机单元未安装${NC}"
        return 1
    fi

    local err
    if [ "$DRYRUN" = "1" ]; then
        echo -e "  ${CYAN}[演练]${NC} 跳过: systemctl daemon-reload + enable $(basename "$NIC_UNIT")"
        return 0
    fi
    if ! err=$(systemctl daemon-reload 2>&1); then
        echo -e "  ${RED}systemctl daemon-reload 失败，开机单元未生效: $err${NC}"
        return 1
    fi
    if ! err=$(systemctl enable "$(basename "$NIC_UNIT")" 2>&1); then
        echo -e "  ${RED}systemctl enable 失败，开机单元未生效: $err${NC}"
        return 1
    fi
    if ! nic_unit_enabled; then
        echo -e "  ${RED}开机单元 enable 后校验仍未通过，请手动检查 systemctl status $(basename "$NIC_UNIT")${NC}"
        return 1
    fi
    return 0
}

write_nic_apply() {
    # 这个辅助脚本是 RPS/XPS/qdisc 持久化的唯一执行者：它没落地，unit 装得再好
    # 开机也什么都不会做。所以写入失败必须让调用方知道。
    # [人工决策-2026-08-05 15:48:02] 早前 cat 与 chmod 都不查返回值、函数恒返回 0，
    # 于是 install_nic_unit 照常建 unit 并报「开机重放已装好」。用 /dev/full 做
    # 目标可复现：shell 已报 No space left on device，函数仍返回 rc=0。
    # 项目原则「落地类操作必须查返回值再宣布成功」在这里被漏掉了
    refuse_if_symlink "$NIC_APPLY" || return 1
    if ! cat >"$NIC_APPLY" <<'APPLYEOF'
#!/bin/bash
# 由 tcp-dashboard 生成：开机重放 RPS/RFS/XPS 与 qdisc 设置。
# 两份 plan 都是「不存在就跳过」——网卡改名或队列数变化时不报错退出。
# 本脚本不调用主脚本的任何函数：bash 不 hoist 函数定义，那种写法会 command not found
# 却仍 exit 0，systemctl status 显示成功而实际什么都没做（社区里有脚本正是这么翻车的）

# --- 1. /sys 队列设置（路径<TAB>值，直接写入）---
PLAN="/var/lib/tcp-dashboard/nic.plan"
if [ -f "$PLAN" ]; then
    while IFS=$'\t' read -r path value; do
        [ -n "$path" ] && [ -f "$path" ] && { echo "$value" >"$path"; } 2>/dev/null
    done <"$PLAN"
fi

# --- 2. qdisc（网卡<TAB>目标qdisc，要跑 tc 且区分多队列）---
# 多队列网卡的 root 恒为 mq/mqprio，真实 qdisc 在叶子上。必须逐叶子替换：
# 顶掉 mq 会让所有硬件队列共用一把 qdisc 锁，等于主动放弃多队列
QPLAN="/var/lib/tcp-dashboard/qdisc.plan"
if [ -f "$QPLAN" ] && command -v tc >/dev/null 2>&1; then
    while IFS=$'\t' read -r qdev qwant; do
        [ -n "$qdev" ] && [ -n "$qwant" ] || continue
        [ -d "/sys/class/net/$qdev" ] || continue
        qroot=$(tc qdisc show dev "$qdev" 2>/dev/null | awk 'NR==1{print $2}')
        case "$qroot" in
        mq | mqprio)
            # 队列号必须自己拼，不能枚举现有的 parent 行：开机时叶子可能还没建出来
            # （或被 del 过），那时 tc 输出只剩一行 mq、没有任何 parent 行可枚举——
            # 实测 del 掉全部叶子后 tc qdisc show 只有 "qdisc mq 1: root"，重放静默失效。
            # 取 root 的 handle（第 3 字段，形如 "1:"）+ 队列序号 1..N，N 从 sysfs 数
            qh=$(tc qdisc show dev "$qdev" 2>/dev/null | awk 'NR==1{print $3}')
            [ -n "$qh" ] || continue
            qn=0
            for qq in /sys/class/net/"$qdev"/queues/tx-*; do
                [ -d "$qq" ] && qn=$((qn + 1))
            done
            qi=1
            while [ "$qi" -le "$qn" ]; do
                tc qdisc replace dev "$qdev" parent "${qh}${qi}" "$qwant" 2>/dev/null
                qi=$((qi + 1))
            done
            ;;
        '') ;;
        # noqueue 是 lo/veth 的固定行为（内核忽略 default_qdisc），不该覆盖
        noqueue) ;;
        *) tc qdisc replace dev "$qdev" root "$qwant" 2>/dev/null ;;
        esac
    done <"$QPLAN"
fi
exit 0
APPLYEOF
    then
        echo -e "  ${RED}写入 $NIC_APPLY 失败（磁盘满 / 只读挂载 / 权限）${NC}"
        echo -e "  ${RED}  开机重放脚本没落地，队列设置重启后不会恢复${NC}"
        return 1
    fi
    # 没有可执行位，unit 里的 ExecStart 会 Permission denied，等于持久化没做成
    if ! chmod 755 "$NIC_APPLY"; then
        echo -e "  ${RED}给 $NIC_APPLY 加可执行位失败，开机重放不会生效${NC}"
        return 1
    fi
    # 兜底确认结果真的存在且可执行——前面每步都查了，这里再确认一次落地结果
    if [ ! -x "$NIC_APPLY" ]; then
        echo -e "  ${RED}$NIC_APPLY 写完后仍不可执行，开机重放不会生效${NC}"
        return 1
    fi

    # 路由感知兜底：网卡每次变为 routable 时再跑一遍。
    # oneshot unit 只在开机触发一次，而网卡热插拔、重连、或 systemd-networkd 重配
    # 之后 /sys 下的队列设置会回到默认。这个目录只在装了 systemd-networkd 的机器上
    # 存在（用 ifupdown / NetworkManager 的机器没有），所以是「有就加、没有不报错」。
    # 关键是 exec 同一个 $NIC_APPLY——两处共用一份逻辑，不会漂移
    if [ -d /etc/networkd-dispatcher/routable.d ] && refuse_if_symlink "$NIC_DISPATCH"; then
        if printf '#!/bin/sh\nexec %s\n' "$NIC_APPLY" >"$NIC_DISPATCH" 2>/dev/null &&
            chmod 755 "$NIC_DISPATCH" 2>/dev/null; then
            echo -e "  ${GREEN}已加 networkd-dispatcher 钩子（网卡重连后自动重放）${NC}"
        else
            echo -e "  ${YELLOW}networkd-dispatcher 钩子写入失败，不影响开机重放${NC}"
        fi
    fi
    return 0
}

# ==================================================
# --- c. 让 default_qdisc 立刻在已有网卡上生效 ---
# ==================================================
# 为什么单独一项、而不是塞进菜单 2 或一键流程：
#   1) 这是运行时改动（tc），不是文件级改动。重启即失效，与本项目其他改动的性质不同；
#   2) 队列切换瞬间会丢弃已排队的包，虽然量很小但非零，而本面板经 SSH 使用；
#   3) 大多数人不需要它——重启一次 default_qdisc 就自动接管了。
# 所以做成用户主动选择、进去前明确告知风险的独立项。
#
# 多队列网卡的正确改法是逐个叶子替换，绝不能动 root。实测对照（4 队列 veth）：
#   错误做法 tc qdisc replace dev X root fq  =>  mq 与 4 个子 qdisc 被压成 1 个
#                                               共享 fq（refcnt 5），多核高 PPS 下
#                                               所有队列争同一把锁
#   正确做法 tc qdisc replace dev X parent 1:N fq  =>  root 仍是 mq，每队列独立 fq
# [人工决策-2026-08-05 11:02:33] 社区脚本（Bud668/vps-mgr、LightKnightBBR 等）普遍
# 无条件 replace root，等于在多队列机器上主动放弃多队列。本项目按 root 类型分流
apply_live_qdisc() {
    echo -e "\n${YELLOW}>>> 让 default_qdisc 在已有网卡上立刻生效${NC}"
    # 这是写入类操作（不是只读菜单），按本项目约定缺工具就装。
    # RHEL 系把 tc 拆到独立包 iproute-tc，pkg_for 已处理这个映射
    if ! command -v tc >/dev/null 2>&1; then
        ensure_tools tc >/dev/null
        if ! command -v tc >/dev/null 2>&1; then
            echo -e "  ${YELLOW}tc 不可用且自动安装失败，无法继续（见上面的手动补装命令）${NC}"
            pause_return
            return 1
        fi
    fi

    local dev want root leaf
    dev=$(egress_dev)
    want=$(sysctl -n net.core.default_qdisc 2>/dev/null)
    if [ -z "$dev" ]; then
        echo -e "  ${YELLOW}识别不出出口网卡，跳过${NC}"
        pause_return
        return 1
    fi
    if [ -z "$want" ]; then
        echo -e "  ${YELLOW}读不到 net.core.default_qdisc（容器命名空间外），跳过${NC}"
        pause_return
        return 1
    fi

    IFS=$'\t' read -r root leaf <<<"$(qdisc_kinds "$dev")"
    echo -e "  出口网卡: ${CYAN}${dev}${NC}   目标 qdisc: ${CYAN}${want}${NC}"
    case "$root" in
    mq | mqprio)
        echo -e "  当前: root=${CYAN}${root}${NC}（多队列容器）叶子=${CYAN}${leaf:-未知}${NC}"
        ;;
    *)
        echo -e "  当前: root=${CYAN}${root:-未知}${NC}"
        ;;
    esac

    # noqueue 不是「没配好」而是设备类型决定的：内核文档明写 lo 与 veth 忽略
    # default_qdisc 并固定用 noqueue（"lo/veth ignore this setting and instead
    # default to noqueue"）。容器里出口网卡就是 veth，此时改它既无意义也不该改
    if [ "$root" = "noqueue" ]; then
        echo -e "  ${YELLOW}本设备是 noqueue：lo / veth 这类虚拟设备按内核设计忽略 default_qdisc${NC}"
        echo -e "  ${YELLOW}容器内的出口网卡通常就是 veth。宿主机上的物理网卡才需要本项${NC}"
        pause_return
        return 0
    fi

    # 已经是目标值就不动——幂等，且避免无谓的队列切换
    local effective=$root
    case "$root" in mq | mqprio) effective=$leaf ;; esac
    if [ "$effective" = "$want" ]; then
        echo -e "  ${GREEN}已经是 ${want}，无需改动${NC}"
        pause_return
        return 0
    fi

    echo -e "\n  ${YELLOW}这是运行时改动，与本面板其他改动不同：${NC}"
    case "$root" in
    mq | mqprio)
        echo -e "  ${YELLOW}  · 将逐个队列执行 tc qdisc replace dev $dev parent <N> $want${NC}"
        echo -e "  ${YELLOW}  · root 的 $root 保持不动（顶掉它等于放弃多队列）${NC}"
        ;;
    *)
        echo -e "  ${YELLOW}  · 将执行 tc qdisc replace dev $dev root $want${NC}"
        ;;
    esac
    echo -e "  ${YELLOW}  · 队列切换瞬间会丢弃已排队的包（量很小但非零）${NC}"
    echo -e "  ${YELLOW}  · 重启后由开机单元重放；回退用菜单 6（会 tc qdisc del 恢复内核默认）${NC}"
    if [ "$BATCH" != "1" ]; then
        read -p "  确认执行？[y/N]: " _c
        [[ "$_c" =~ ^[Yy]$ ]] || {
            echo -e "  ${GREEN}已取消，未做任何改动${NC}"
            pause_return
            return 0
        }
    fi

    save_original_values || { pause_return; return 1; }
    mkdir -p "$STATE_DIR"

    local done_n=0 fail_n=0 p
    if [ "$DRYRUN" = "1" ]; then
        echo -e "  ${CYAN}[演练]${NC} 跳过 tc qdisc replace，仅写 plan 文件"
        printf '%s\t%s\n' "$dev" "$want" | atomic_write "$QDISCPLAN"
        pause_return
        return 0
    fi
    case "$root" in
    mq | mqprio)
        # parent handle 直接取 tc 输出里 parent 后一个字段。不能硬编码 8001:N ——
        # 主号由内核分配，带 dev 查询时还会省略成 :N，两种形式都能原样回传给 tc
        for p in $(tc qdisc show dev "$dev" 2>/dev/null |
            awk '/parent/{for(i=1;i<=NF;i++) if($i=="parent") print $(i+1)}'); do
            if tc qdisc replace dev "$dev" parent "$p" "$want" 2>/dev/null; then
                done_n=$((done_n + 1))
            else
                fail_n=$((fail_n + 1))
            fi
        done
        ;;
    *)
        if tc qdisc replace dev "$dev" root "$want" 2>/dev/null; then
            done_n=1
        else
            fail_n=1
        fi
        ;;
    esac

    if [ "$done_n" -eq 0 ]; then
        echo -e "  ${RED}全部失败（$fail_n 项）。可能本内核缺 sch_${want} 模块，或权限不足${NC}"
        echo -e "  ${YELLOW}检查: modinfo sch_${want}${NC}"
        pause_return
        return 1
    fi

    # 回读校验：tc 返回 0 不等于真的换了（曾有 mq 场景 replace 成功但叶子没变）
    IFS=$'\t' read -r root leaf <<<"$(qdisc_kinds "$dev")"
    local now=$root
    case "$root" in mq | mqprio) now=$leaf ;; esac
    if [ "$now" = "$want" ]; then
        echo -e "  ${GREEN}完成：$done_n 个队列已切到 $want（回读校验通过）${NC}"
        [ "$fail_n" -gt 0 ] && echo -e "  ${YELLOW}其中 $fail_n 项失败${NC}"
    else
        echo -e "  ${YELLOW}执行了 $done_n 项，但回读到的仍是「$now」而非 $want${NC}"
        echo -e "  ${YELLOW}请手动检查: tc qdisc show dev $dev${NC}"
    fi

    # 持久化：写进独立的 qdisc plan，由同一个 $NIC_APPLY 在开机时重放。
    # 不复用 $NICPLAN——那份是「路径<TAB>值」的 /sys 写入，格式和执行方式都不同
    # 走 atomic_write：它自带链接防护，且 plan 是回退时要读的状态文件，
    # 写一半就断电会让开机重放拿到半截内容
    if ! printf '%s\t%s\n' "$dev" "$want" | atomic_write "$QDISCPLAN"; then
        echo -e "  ${YELLOW}qdisc plan 写入失败，本次改动重启后不会重放${NC}"
    fi
    if install_nic_unit; then
        echo -e "  ${GREEN}已写入开机重放（$QDISCPLAN），重启后仍生效${NC}"
    else
        echo -e "  ${YELLOW}未能启用开机单元，本次改动重启后失效（原因见上）${NC}"
    fi
    pause_return
}

# ==================================================
# --- 8. 诊断：调 sysctl 到底有没有用 ---
# ==================================================
# 这一项只读，不改任何东西。
# 思路：光看「参数写进去了」证明不了有效果。内核在每条连接上记了瓶颈到底在哪，
# ss -ti 会把它暴露出来——sndbuf_limited / rwnd_limited / app_limited 三个计时器
# 分别对应「本机发送缓冲不够」「对端接收窗口小」「应用自己喂不满」。
# 只有第一种调本机 sysctl 才有救，后两种调了也白调。
diagnose() {
    echo -e "\n${YELLOW}>>> 网络瓶颈诊断（只读，不修改任何设置）${NC}"
    # 只读功能不装包：文案对外承诺「零副作用、生产机可直接跑」，而装包会动
    # apt/dpkg 数据库、刷新索引、往系统里装新二进制——那不是零副作用。
    # 缺工具就降级并给出手动补装命令，由用户自己决定要不要在这台机器上装
    require_tools_readonly ss nstat tc
    local dev cc qdisc live_qdisc bbr_ver
    dev=$(egress_dev)
    cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
    qdisc=$(sysctl -n net.core.default_qdisc 2>/dev/null)

    draw_line
    echo -e "  出口网卡     : ${CYAN}${dev:-未识别}${NC}"
    echo -e "  拥塞算法     : ${CYAN}${cc}${NC}$(bbr_version_label)"
    # 可用算法列表比「设完再回显」可靠：回显只说明当前值，说明不了 bbr 到底能不能选。
    # 内核没编 tcp_bbr、或模块没加载时，写 bbr 会被 sysctl 拒绝而当前值原样不动——
    # 那种情况下只看当前值会以为「本来就不是 bbr」，而不知道是「根本用不了」
    local avail_cc
    avail_cc=$(sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null)
    if [ -n "$avail_cc" ]; then
        echo -e "  可用算法     : ${CYAN}${avail_cc}${NC}"
        case " $avail_cc " in
        *" bbr "*) ;;
        *) echo -e "    ${YELLOW}=> 列表里没有 bbr：本内核未编入或模块未加载，菜单 2 会尝试 modprobe tcp_bbr${NC}" ;;
        esac
    fi
    echo -e "  default_qdisc: ${CYAN}${qdisc}${NC}"
    # default_qdisc 只对「之后新建」的网卡队列生效，已存在的网卡不受影响。
    # 所以必须查这块网卡实际挂的 qdisc，否则会误以为 fq 已经在跑。
    #
    # 但「实际挂的」在多队列网卡上不是 root：root 恒为 mq/mqprio，真正的 qdisc 在每个
    # 硬件队列的叶子上。内核文档原话是多队列网卡 root 保持 mq、default_qdisc 作用于叶子
    # （"multiqueue NICs keep mq as root and use this for leaves"）。
    # [人工决策-2026-08-05 10:32:41] 早期版本只取 tc 输出第一行的 root 去比 default_qdisc，
    # 在任何多队列网卡上都必然报「不一致」——实测 root=mq / default_qdisc=fq_codel 即触发。
    # 改为 root 是 mq/mqprio 时以叶子类型为判据，且不自动执行 tc qdisc replace：
    # tc 改动是运行时的、重启即失效，要做就得配持久化，属菜单 c 的职责，诊断保持只读
    local live_root live_leaf effective
    if [ -n "$dev" ]; then
        IFS=$'\t' read -r live_root live_leaf <<<"$(qdisc_kinds "$dev")"
        case "$live_root" in
        mq | mqprio)
            # 叶子可能不止一种（有人手工只改了部分队列），全列出来
            echo -e "  实际 root qdisc: ${CYAN}${live_root}${NC}（多队列容器，本身不是排队算法）"
            echo -e "    叶子 qdisc   : ${CYAN}${live_leaf:-未知}${NC}"
            effective=$live_leaf
            ;;
        '')
            echo -e "  实际 root qdisc: ${YELLOW}未知（缺 tc 或读取失败）${NC}"
            effective=""
            ;;
        *)
            echo -e "  实际 root qdisc: ${CYAN}${live_root}${NC}"
            effective=$live_root
            ;;
        esac
        # noqueue 是设备类型决定的，不是配置问题：内核文档明写 lo 与 veth 忽略
        # default_qdisc。容器内出口网卡就是 veth，报「不一致」会误导
        if [ "$effective" = "noqueue" ]; then
            echo -e "    ${YELLOW}=> noqueue 是 lo / veth 这类虚拟设备的固定行为，按内核设计忽略 default_qdisc${NC}"
            echo -e "    ${YELLOW}   容器内出口就是 veth，这里无需也无法改动${NC}"
            effective=""
        fi
        # 叶子有多种时 effective 含空格，不等于单个 qdisc 名，同样算不一致
        if [ -n "$effective" ] && [ -n "$qdisc" ] && [ "$effective" != "$qdisc" ]; then
            echo -e "    ${YELLOW}=> 与 default_qdisc（$qdisc）不一致${NC}"
            echo -e "    ${YELLOW}   default_qdisc 只影响之后新建的队列。重启即生效；${NC}"
            echo -e "    ${YELLOW}   要立刻生效用菜单 c（会逐个队列替换，不动 mq 本身）${NC}"
        elif [ -n "$effective" ]; then
            echo -e "    ${GREEN}=> 与 default_qdisc 一致${NC}"
        fi
    fi
    draw_line

    # --- 瓶颈归因 ---
    if ! command -v ss &>/dev/null; then
        echo -e "  ${YELLOW}缺少 ss 命令（iproute2），跳过连接级归因${NC}"
    else
        local stats
        # 汇总所有已建立连接的受限计时器与重传。计时器单位是微秒，取相对占比而非绝对值。
        #
        # app_limited 与另外两个不同：它是「裸标记」，没有跟数值（实测 ss 输出里就是
        # 独立的单词 app_limited），表示这条连接当前受限于应用喂数据的速度而非网络。
        # 所以它只能数「有多少条连接带这个标记」，不能像 sndbuf_limited 那样算时间占比。
        # [人工决策-2026-08-05 10:41:07] 实测一台真实机器：app_limited 出现 11 次、
        # rwnd_limited 11 次、sndbuf_limited 0 次。app_limited 才是现实中最常见的
        # 「其实调参没用」信号，而早期版本只在注释里提过它、代码没解析，落到 else 分支
        # 只能靠重传率反推。内核已经把结论直接给出来了，没有理由去猜
        stats=$(ss -tin 2>/dev/null | awk '
            /sndbuf_limited:/ { match($0, /sndbuf_limited:[0-9]+/); s += substr($0, RSTART+15, RLENGTH-15) }
            /rwnd_limited:/   { match($0, /rwnd_limited:[0-9]+/);   r += substr($0, RSTART+13, RLENGTH-13) }
            /busy:/           { match($0, /busy:[0-9]+/);           b += substr($0, RSTART+5,  RLENGTH-5) }
            # 词边界要自己保证：app_limited 是裸标记，直接 /app_limited/ 会被将来
            # 可能出现的同前缀字段误伤，锚定前后为空白或行首行尾
            /(^|[ \t])app_limited([ \t]|$)/ { a++ }
            # 连接数要数「每条连接的指标行」而不是含 retrans: 的行。
            # [人工决策-2026-08-05 10:48:15] 早期版本用 /retrans:/ 计数，但那个字段只在
            # 连接发生过重传时才出现——实测 28 条连接里只有 7 条有 retrans:，于是
            # 「活跃连接 N 条」长期少报，且拿它当分母会让 app_limited 占比算出 116%。
            # ss -tin 的输出是「头行 + 缩进指标行」成对，数缩进行即等于连接数
            /^[ \t]+[a-z]/    { n++ }
            END { printf "%d %d %d %d %d", s+0, r+0, b+0, n+0, a+0 }')
        local snd rwnd busy nconn applim
        read -r snd rwnd busy nconn applim <<<"$stats"

        echo -e "  ${CYAN}连接级瓶颈归因${NC}（活跃连接 ${nconn:-0} 条）"
        if [ "${busy:-0}" -eq 0 ]; then
            echo -e "    当前没有足够的传输活动可供判断。请在跑业务/压测时再执行本项"
        else
            local snd_pct rwnd_pct app_pct=0
            snd_pct=$((snd * 100 / busy))
            rwnd_pct=$((rwnd * 100 / busy))
            [ "${nconn:-0}" -gt 0 ] && app_pct=$((applim * 100 / nconn))
            printf "    发送缓冲受限 (sndbuf_limited) : %s%%\n" "$snd_pct"
            printf "    对端窗口受限 (rwnd_limited)   : %s%%\n" "$rwnd_pct"
            printf "    应用喂不满 (app_limited)     : %s/%s 条连接 (%s%%)\n" \
                "${applim:-0}" "${nconn:-0}" "$app_pct"
            # 判定顺序：缓冲区受限优先（那是本机能调的），再看对端，最后才是应用。
            # app_limited 放在缓冲区之后——一条连接可能既 app_limited 又短暂 sndbuf_limited，
            # 而后者才是可行动项
            if [ "$snd_pct" -ge 10 ]; then
                echo -e "    ${GREEN}=> 发送缓冲是瓶颈：加大 wmem 有效，本脚本菜单 3 正对这个问题${NC}"
            elif [ "$rwnd_pct" -ge 10 ]; then
                echo -e "    ${YELLOW}=> 对端接收窗口是瓶颈：本机调 sysctl 无效，要对端也调或换对端${NC}"
            elif [ "$app_pct" -ge 50 ]; then
                echo -e "    ${YELLOW}=> 过半连接是应用喂不满（内核直接给出的判定）：${NC}"
                echo -e "    ${YELLOW}   瓶颈在应用层（并发不够 / 单线程 / 上游慢），调内核参数不会有变化${NC}"
            else
                echo -e "    ${YELLOW}=> 缓冲区和应用都不是瓶颈。看下面的重传率：${NC}"
                echo -e "    ${YELLOW}   重传高 => 线路丢包，sysctl 无解，考虑换线路或上 FEC 类方案（kcptun/Hysteria）${NC}"
                echo -e "    ${YELLOW}   重传低 => 已接近本机能力上限，继续调参收益有限${NC}"
            fi
        fi
    fi
    draw_line

    # --- 重传率（区分「窗口受限」和「丢包受限」的关键）---
    # 计数器统一走 read_counters：有 nstat 用 nstat，没有则直读 /proc/net/{snmp,netstat}。
    # 以前这里直接调 nstat 且同一份数据调了四遍，缺 nstat 时整段跳过
    local snap_a snap_b seg_out retrans rate
    snap_a=$(read_counters)
    seg_out=$(counter_get TcpOutSegs "$snap_a")
    retrans=$(counter_get TcpRetransSegs "$snap_a")
    if [ -n "$seg_out" ] && [ "${seg_out:-0}" -gt 0 ] 2>/dev/null; then
        rate=$((retrans * 10000 / seg_out))
        echo -e "  ${CYAN}累计重传率${NC}: $((rate / 100)).$((rate % 100))%  (${retrans} / ${seg_out} 段，开机以来)"

        # 累计值会被历史流量稀释：跑了几个月的机器上，即使现在丢包 5%，
        # 累计值也可能只有 0.5%——分母里全是历史上正常的段。
        # 判例：容器里注入 5% 丢包，累计重传率只显示 0.47%，结论行报「线路干净」。
        # 所以再取一个 5 秒窗口的增量，结论以窗口值为准
        local o2 r2 d_out d_ret wrate=""
        echo -ne "  ${CYAN}近期重传率${NC}: 采样 5 秒 ..."
        sleep 5
        snap_b=$(read_counters)
        o2=$(counter_get TcpOutSegs "$snap_b")
        r2=$(counter_get TcpRetransSegs "$snap_b")
        d_out=$((${o2:-0} - seg_out))
        d_ret=$((${r2:-0} - retrans))
        if [ "$d_out" -gt 200 ]; then
            wrate=$((d_ret * 10000 / d_out))
            echo -e "\r  ${CYAN}近期重传率${NC}: $((wrate / 100)).$((wrate % 100))%  (${d_ret} / ${d_out} 段，最近 5 秒)    "
        else
            echo -e "\r  ${CYAN}近期重传率${NC}: 本机 5 秒内只发了 ${d_out} 段，样本太少，下面按累计值判断    "
        fi

        # 有窗口值就用它，没有才退回累计值
        local judge=${wrate:-$rate}
        if [ "$judge" -ge 200 ]; then
            echo -e "    ${RED}=> 超过 2%：属于丢包受限。BBR 能缓解但治不了，sysctl 调缓冲区没用${NC}"
        elif [ "$judge" -ge 50 ]; then
            echo -e "    ${YELLOW}=> 0.5%-2%：跨境常态，BBR 正是为这个场景${NC}"
        else
            echo -e "    ${GREEN}=> 低于 0.5%：线路干净${NC}"
        fi
        if [ -n "$wrate" ] && [ "$wrate" -ge 200 ] && [ "$rate" -lt 200 ]; then
            echo -e "    ${YELLOW}（累计值被历史流量稀释了，以近期值为准）${NC}"
        fi

        # --- 重传成因分解 ---
        # 一个「重传率 2%」说明不了该做什么。拆成四类之后结论完全不同：
        #   SynRetrans      建连阶段就在丢。跟传输中丢包是两回事——跨境线路握手丢包常见，
        #                   表现是「连上很慢但连上后还行」，调缓冲区完全无关
        #   Timeouts        RTO 硬等超时。这比重传率本身严重得多：快速重传（SACK 驱动）
        #                   只损失一点吞吐，而 RTO 意味着连接停了至少一个 RTO 周期
        #   SackRecovery    SACK 触发的快速恢复次数。它高是**健康**的——说明丢包被快速
        #                   修好了。所以它单独看会误导，必须和 Timeouts 比：
        #                   SackRecovery 占多数 = 恢复机制正常；Timeouts 占多数 = 恢复失败
        #   LostRetransmit  重传包本身又丢了。持续性劣化的硬证据，重传率会被大流量稀释
        #                   而这个计数器只要涨就是坏消息
        # 四项的处置都是「sysctl 无解」，但归因准确能让用户不在缓冲区上白花时间
        local lostret synret timeouts sackrec
        lostret=$(counter_get TcpExtTCPLostRetransmit "$snap_b")
        [ -z "$lostret" ] && lostret=$(counter_get TcpExtTCPLostRetransmit "$snap_a")
        synret=$(counter_get TcpExtTCPSynRetrans "$snap_b")
        [ -z "$synret" ] && synret=$(counter_get TcpExtTCPSynRetrans "$snap_a")
        timeouts=$(counter_get TcpExtTCPTimeouts "$snap_b")
        [ -z "$timeouts" ] && timeouts=$(counter_get TcpExtTCPTimeouts "$snap_a")
        sackrec=$(counter_get TcpExtTCPSackRecovery "$snap_b")
        [ -z "$sackrec" ] && sackrec=$(counter_get TcpExtTCPSackRecovery "$snap_a")

        if [ -n "$lostret" ] || [ -n "$synret" ] || [ -n "$timeouts" ]; then
            echo -e "  ${CYAN}重传成因分解${NC}"
            printf "    建连丢包 (SynRetrans)      : %s\n" "${synret:--}"
            printf "    硬等超时 (Timeouts)        : %s\n" "${timeouts:--}"
            printf "    重传又丢 (LostRetransmit)  : %s\n" "${lostret:--}"
            printf "    SACK 快速恢复 (SackRecovery): %s\n" "${sackrec:--}"

            # 建连丢包单独判：它与传输质量无关，用户容易把两者混为一谈
            if [ "${synret:-0}" -gt 0 ] 2>/dev/null && [ "${retrans:-0}" -gt 0 ] 2>/dev/null; then
                local sr_pct=$((synret * 100 / retrans))
                [ "$sr_pct" -ge 20 ] &&
                    echo -e "    ${YELLOW}=> 建连丢包占重传 ${sr_pct}%：握手阶段就在丢，表现为「连接建立慢」${NC}" &&
                    echo -e "    ${YELLOW}   与缓冲区无关；tcp_syn_retries 只影响放弃前重试几次，治不了丢包${NC}"
            fi
            # 恢复机制是否在正常工作：Timeouts vs SackRecovery 的相对占比
            if [ "${timeouts:-0}" -gt 0 ] 2>/dev/null; then
                local recov_total=$((timeouts + ${sackrec:-0}))
                if [ "$recov_total" -gt 0 ]; then
                    local to_pct=$((timeouts * 100 / recov_total))
                    if [ "$to_pct" -ge 50 ]; then
                        echo -e "    ${RED}=> 超时占恢复事件 ${to_pct}%：丢包没被 SACK 快速修好，在硬等 RTO${NC}"
                        echo -e "    ${RED}   这比「重传率高」严重——每次 RTO 连接至少停一个超时周期${NC}"
                    else
                        echo -e "    ${GREEN}=> 超时只占恢复事件 ${to_pct}%，SACK 快速恢复在正常工作${NC}"
                    fi
                fi
            fi
            if [ "${lostret:-0}" -gt 0 ] 2>/dev/null && [ "${retrans:-0}" -gt 0 ] 2>/dev/null; then
                local lr_pct=$((lostret * 100 / retrans))
                [ "$lr_pct" -ge 5 ] &&
                    echo -e "    ${RED}=> 重传又丢占重传 ${lr_pct}%：线路持续性丢包，调缓冲区无解${NC}"
            fi
        fi

        # --- tcp_mtu_probing 到底有没有真的触发过 ---
        # 本脚本菜单 3 设了 tcp_mtu_probing=1、菜单 b 还专门做 PMTU 阶梯探测，
        # 但那些都是「我们主动去探」。这两个计数器反映的是**真实业务连接**遇到的情况：
        # 非零就说明内核确实在某条连接上启动过 MTU 探测，也就是说路径上真有黑洞、
        # 而且这个参数正在起作用。这是全部受管参数里唯一能这样自证的一项，
        # 比 ICMP 阶梯更可信（ICMP 可能被单独屏蔽，而这是 TCP 自己的数据）
        local mtup_ok mtup_fail
        mtup_ok=$(counter_get TcpExtTCPMTUPSuccess "$snap_a")
        mtup_fail=$(counter_get TcpExtTCPMTUPFail "$snap_a")
        if [ -n "$mtup_ok" ] || [ -n "$mtup_fail" ]; then
            if [ "${mtup_ok:-0}" -gt 0 ] 2>/dev/null || [ "${mtup_fail:-0}" -gt 0 ] 2>/dev/null; then
                echo -e "  ${CYAN}MTU 探测实际触发${NC}: 成功 ${mtup_ok:--} / 失败 ${mtup_fail:--}"
                echo -e "    ${GREEN}=> 非零说明路径上确有 MTU 黑洞，且 tcp_mtu_probing=1 正在起作用${NC}"
                echo -e "    ${GREEN}   这是真实业务连接的证据，比菜单 b 的 ICMP 阶梯更可信${NC}"
                [ "${mtup_fail:-0}" -gt "${mtup_ok:-0}" ] 2>/dev/null &&
                    echo -e "    ${YELLOW}   但失败多于成功：探测收敛不下去，可考虑菜单 b 找出实际 PMTU${NC}"
            else
                echo -e "  ${CYAN}MTU 探测实际触发${NC}: 0（本机连接没遇到过 MTU 黑洞）"
                echo -e "    ${GREEN}=> tcp_mtu_probing=1 是保险，没触发说明路径 MTU 干净${NC}"
            fi
        fi
    else
        echo -e "  ${YELLOW}读不到 TCP 计数器（缺 nstat 且 /proc/net/snmp 不可读），跳过重传率${NC}"
    fi
    draw_line

    # --- 队列容量证据：判断 somaxconn / netdev_max_backlog 到底有没有意义 ---
    # 这两个参数社区脚本一律拉满，但拉满有没有用取决于是否真的溢出过。
    # ListenOverflows = accept 队列满导致的丢弃（应用 accept 太慢或 backlog 太小）
    # TCPBacklogDrop  = socket backlog 满导致的丢弃（接收侧处理不及）
    # 两个都为 0 就说明本机根本没到容量瓶颈，加大它们纯属安慰剂
    if [ -n "$snap_a" ]; then
        local lisov lisdrop bkdrop ofo
        lisov=$(counter_get TcpExtListenOverflows "$snap_a")
        lisdrop=$(counter_get TcpExtListenDrops "$snap_a")
        bkdrop=$(counter_get TcpExtTCPBacklogDrop "$snap_a")
        ofo=$(counter_get TcpExtTCPOFOQueue "$snap_a")
        if [ -n "$lisov" ] || [ -n "$bkdrop" ]; then
            echo -e "  ${CYAN}队列容量证据${NC}"
            printf "    accept 队列溢出 (ListenOverflows): %s\n" "${lisov:--}"
            printf "    listen 丢弃      (ListenDrops)   : %s\n" "${lisdrop:--}"
            printf "    backlog 丢包     (TCPBacklogDrop): %s\n" "${bkdrop:--}"
            if [ "${lisov:-0}" -gt 0 ] 2>/dev/null; then
                echo -e "    ${YELLOW}=> accept 队列溢出过：somaxconn 加大有意义，但也要让应用把 listen() backlog 传大${NC}"
            elif [ "${bkdrop:-0}" -gt 0 ] 2>/dev/null; then
                echo -e "    ${YELLOW}=> backlog 有丢包：netdev_max_backlog 加大有意义${NC}"
            else
                echo -e "    ${GREEN}=> 均为 0：本机没到队列容量瓶颈，这两项属安慰剂（本脚本用 max 语义写入，不会反向调低）${NC}"
            fi
        fi
        # 乱序入队：路径多径或重排。高值会拖累 SACK 恢复效率，但不是本机能调的
        if [ -n "$ofo" ] && [ "${ofo:-0}" -gt 0 ] 2>/dev/null && [ "${seg_out:-0}" -gt 0 ] 2>/dev/null; then
            echo -e "  ${CYAN}乱序入队${NC} (TCPOFOQueue): ${ofo}"
            echo -e "    ${YELLOW}=> 路径存在重排/多径。SACK 已默认开启（本脚本不关它），本机无其他可调项${NC}"
        fi
    fi

    # --- 各服务实际的 accept 队列容量：somaxconn 管得到谁 ---
    # 上面的 ListenOverflows 是累计值，回答「曾经满过吗」；这里回答「现在离满多远」，
    # 以及更要紧的一点：somaxconn 到底管不管得到这个服务。
    #
    # ss -Hltn 的 Send-Q 列对 LISTEN socket 来说是**该 socket 实际生效的 backlog**
    # （即 sk_max_ack_backlog），Recv-Q 是当前已完成握手、等应用 accept 的连接数。
    # 内核取 min(应用 listen() 传的 backlog, somaxconn)——所以 Send-Q 明显小于
    # somaxconn 时，瓶颈在**应用自己传的值**，改 sysctl 一点用都没有。
    # 这正是本脚本配置文件里那段 tcp_max_syn_backlog 注释讲的原理，但在此之前
    # 用户没有任何手段看到自己的服务属于哪种情况（nginx 要写 listen ... backlog=，
    # Go 程序看 net.ListenConfig，Java 看 ServerSocket 的 backlog 参数）
    if command -v ss >/dev/null 2>&1; then
        local somax listen_stat
        somax=$(sysctl -n net.core.somaxconn 2>/dev/null)
        if [ -n "$somax" ] && [ "${somax:-0}" -gt 0 ] 2>/dev/null; then
            # 一次 awk 出全部结论：监听总数、backlog 低于 somaxconn 的个数、
            # 当前有排队的个数、以及最小的那个 backlog 值与它的地址
            listen_stat=$(ss -Hltn 2>/dev/null | awk -v sm="$somax" '
                {
                    n++
                    q = $3 + 0
                    if (q < sm) { low++; if (minq == 0 || q < minq) { minq = q; minaddr = $4 } }
                    if ($2 + 0 > 0) { queued++; if ($2 + 0 > maxrq) { maxrq = $2 + 0; rqaddr = $4 } }
                }
                END { printf "%d %d %d %d %s %d %s", n+0, low+0, queued+0, minq+0, (minaddr==""?"-":minaddr), maxrq+0, (rqaddr==""?"-":rqaddr) }')
            local l_n l_low l_queued l_minq l_minaddr l_maxrq l_rqaddr
            read -r l_n l_low l_queued l_minq l_minaddr l_maxrq l_rqaddr <<<"$listen_stat"
            if [ "${l_n:-0}" -gt 0 ] 2>/dev/null; then
                echo -e "  ${CYAN}监听队列容量${NC}（somaxconn=${somax}，共 ${l_n} 个监听端口）"
                if [ "${l_low:-0}" -gt 0 ] 2>/dev/null; then
                    echo -e "    ${YELLOW}${l_low} 个服务的实际 backlog 低于 somaxconn，最小的是 ${l_minq}（${l_minaddr}）${NC}"
                    echo -e "    ${YELLOW}=> 内核取 min(应用 listen() 传的值, somaxconn)。这些服务的瓶颈在应用侧，${NC}"
                    echo -e "    ${YELLOW}   改 somaxconn 对它们无效——要改应用配置（nginx 的 listen ... backlog=）${NC}"
                else
                    echo -e "    ${GREEN}=> 所有监听的 backlog 都已达到 somaxconn，sysctl 这一侧没有余量可挖${NC}"
                fi
                if [ "${l_queued:-0}" -gt 0 ] 2>/dev/null; then
                    echo -e "    ${YELLOW}当前有 ${l_queued} 个端口存在待 accept 队列，最多的 ${l_maxrq} 个（${l_rqaddr}）${NC}"
                    echo -e "    ${YELLOW}=> 应用 accept 跟不上新连接速率。加大 backlog 只是让它排更久，不解决处理能力${NC}"
                fi
            fi
        fi
    fi

    # --- 内存压力：缓冲区「开太大」的反向信号 ---
    # 这一段的方向和其他判据相反。PruneCalled/RcvPruned 是内核为了腾接收缓冲而裁剪
    # 乱序队列，TCPMemoryPressures 是进入内存压力模式（会强制收缩所有连接的缓冲）。
    # 它们非零说明缓冲区总量已经超出机器承受能力——此时该往下调而不是继续加大，
    # 这正是本脚本用「内存 5%」钳住 BDP 推导结果的原因
    if [ -n "$snap_a" ]; then
        local prune rcvpr mempr
        prune=$(counter_get TcpExtPruneCalled "$snap_a")
        rcvpr=$(counter_get TcpExtRcvPruned "$snap_a")
        mempr=$(counter_get TcpExtTCPMemoryPressures "$snap_a")
        if [ "${prune:-0}" -gt 0 ] 2>/dev/null || [ "${mempr:-0}" -gt 0 ] 2>/dev/null; then
            echo -e "  ${CYAN}TCP 内存压力${NC}"
            printf "    队列裁剪 (PruneCalled/RcvPruned): %s / %s\n" "${prune:--}" "${rcvpr:--}"
            printf "    进入压力模式 (MemoryPressures)  : %s\n" "${mempr:--}"
            echo -e "    ${RED}=> 非零是「缓冲区开太大」的信号，与其他项方向相反：${NC}"
            echo -e "    ${RED}   内核在强制收缩缓冲。此时应调小 rmem_max/wmem_max 或加内存，而不是继续加大${NC}"
        fi
    fi

    # --- UDP 侧：QUIC / Hysteria2 的关键判据 ---
    # UdpRcvbufErrors 直接对应 udp_rmem_min 与 rmem_max 该不该调。
    # UdpInErrors 占 UdpInDatagrams 的比例是另一件事：Golden-GRE 记录过一个案例，
    # GRO 在 GRE-in-UDP 隧道的 underlay 上错误合并包，导致 UdpInErrors 占到约 25%、
    # TCP 吞吐从 1Mbit 恢复到 350Mbit/s（关掉该网卡 GRO 后 UdpInErrors 归零）。
    # 所以高比例不是「UDP 缓冲小」，而是要怀疑 offload 与隧道封装冲突
    if [ -n "$snap_a" ]; then
        local udperr udpin udprcv udpsnd
        udperr=$(counter_get UdpInErrors "$snap_a")
        udpin=$(counter_get UdpInDatagrams "$snap_a")
        udprcv=$(counter_get UdpRcvbufErrors "$snap_a")
        udpsnd=$(counter_get UdpSndbufErrors "$snap_a")
        if [ -n "$udpin" ]; then
            echo -e "  ${CYAN}UDP 侧${NC}（QUIC / Hysteria2 / WireGuard 走这里）"
            printf "    接收缓冲溢出 (UdpRcvbufErrors): %s\n" "${udprcv:--}"
            printf "    发送缓冲溢出 (UdpSndbufErrors): %s\n" "${udpsnd:--}"
            [ "${udprcv:-0}" -gt 0 ] 2>/dev/null &&
                echo -e "    ${YELLOW}=> 接收缓冲溢出过：udp_rmem_min 与 rmem_max 加大有意义（本脚本菜单 3 已设）${NC}"
            if [ "${udpin:-0}" -gt 1000 ] 2>/dev/null && [ "${udperr:-0}" -gt 0 ] 2>/dev/null; then
                local uerr_pct=$((udperr * 1000 / udpin))
                printf "    InErrors/InDatagrams         : %s.%s%%  (%s / %s)\n" \
                    "$((uerr_pct / 10))" "$((uerr_pct % 10))" "$udperr" "$udpin"
                if [ "$uerr_pct" -ge 50 ]; then
                    echo -e "    ${RED}=> 超过 5%：不像是缓冲区问题。若本机跑 GRE-in-UDP / FOU / WireGuard 隧道，${NC}"
                    echo -e "    ${RED}   优先怀疑网卡 GRO 与封装冲突（社区有实测：关掉 underlay 网卡 GRO 后 TCP 从 1Mbit 恢复到 350Mbit）${NC}"
                    echo -e "    ${RED}   验证: ethtool -K <承载隧道的物理网卡> gro off  然后重测${NC}"
                fi
            fi
        fi
    fi
    draw_line

    # --- softnet：判断 netdev_budget 那两项有没有意义 ---
    if [ -r /proc/net/softnet_stat ]; then
        local squeezed dropped
        dropped=$(softnet_sum 2)
        squeezed=$(softnet_sum 3)
        echo -e "  ${CYAN}软中断收包${NC}: backlog 丢包 ${dropped:-?} 次 | NAPI 预算耗尽 ${squeezed:-?} 次"
        if [ "${squeezed:-0}" -gt 0 ]; then
            echo -e "    ${GREEN}=> squeeze 非零，说明 netdev_budget/netdev_budget_usecs 抬高对本机有意义${NC}"
        else
            echo -e "    ${YELLOW}=> squeeze 为 0，本机收包压力不大，netdev_budget 那两项属安慰剂${NC}"
        fi
        if [ "${dropped:-0}" -gt 0 ]; then
            echo -e "    ${YELLOW}=> backlog 有丢包，netdev_max_backlog 加大有意义${NC}"
        fi
    fi

    # --- NET_RX 软中断分布：RPS 该不该开的直接证据 ---
    # 菜单 5 现在只按「硬件队列数 < 核数」决定开不开 RPS，那是能力判断而非需求判断：
    # 单队列网卡不代表软中断真的成了瓶颈。RPS 的作用是把收包软中断从一个核摊到多核，
    # 所以真正的证据是 NET_RX 是否集中在少数核上。全部核均摊时开 RPS 只是多一次
    # IPI 与跨核唤醒，反而抬高延迟（内核 scaling.rst 也是这个说法）
    if [ -r /proc/softirqs ]; then
        local rx_stat
        # 纯 POSIX awk：算最大核占比与核数。数值可能很大，用 awk 自己的浮点避免溢出
        rx_stat=$(awk '/NET_RX/ {
            max = 0; sum = 0; n = 0; mi = 0
            for (i = 2; i <= NF; i++) {
                v = $i + 0; sum += v; n++
                if (v > max) { max = v; mi = i - 2 }
            }
            if (sum > 0) printf "%d %d %d", n, mi, max * 100 / sum
            exit
        }' /proc/softirqs 2>/dev/null)
        if [ -n "$rx_stat" ]; then
            local rx_n rx_top rx_pct
            read -r rx_n rx_top rx_pct <<<"$rx_stat"
            echo -e "  ${CYAN}NET_RX 软中断分布${NC}: ${rx_n} 核，最忙的是 CPU${rx_top}（占 ${rx_pct}%）"
            # 阈值取「均摊值的 3 倍」：n 核均摊每核 100/n%，集中到 3 倍以上才算倾斜。
            # 单核机器恒为 100%，此时 RPS 无意义，单独排除
            if [ "${rx_n:-1}" -le 1 ]; then
                echo -e "    ${YELLOW}=> 单核机器，RPS 无意义（没有其他核可以分摊）${NC}"
            elif [ "$rx_pct" -ge $((300 / rx_n)) ] && [ "$rx_pct" -ge 40 ]; then
                echo -e "    ${GREEN}=> 明显集中在单核：RPS/RFS 有实际意义，菜单 5 正对这个问题${NC}"
            else
                echo -e "    ${YELLOW}=> 分布较均匀（均摊值约 $((100 / rx_n))%），软中断不是瓶颈，开 RPS 收益有限${NC}"
            fi
        fi
    fi

    # --- qdisc 丢包：区分「本地出向队列」和「路径」---
    # 必须累加所有 qdisc 行而不是只取第一个：多队列网卡第一行是 mq 的汇总，
    # 而实际丢包发生在各叶子队列上。只取首行会在 mq 汇总不反映叶子时漏报
    if [ -n "$dev" ] && command -v tc &>/dev/null; then
        local qdrop
        qdrop=$(qdisc_drops "$dev")
        if [ -n "$qdrop" ]; then
            echo -e "  ${CYAN}出向队列丢包${NC}: $qdrop（全部队列累计）"
            [ "$qdrop" -gt 0 ] 2>/dev/null &&
                echo -e "    ${YELLOW}=> 本地出向队列在丢包，是本机发送能力/整形问题，不是路径问题${NC}"
        fi
    fi

    # --- conntrack：表满会静默丢包且日志不显眼 ---
    local ct_count ct_max
    ct_count=$(sysctl -n net.netfilter.nf_conntrack_count 2>/dev/null)
    ct_max=$(sysctl -n net.netfilter.nf_conntrack_max 2>/dev/null)
    if [ -n "$ct_count" ] && [ -n "$ct_max" ] && [ "${ct_max:-0}" -gt 0 ]; then
        local ct_pct=$((ct_count * 100 / ct_max))
        echo -e "  ${CYAN}conntrack${NC}: $ct_count / $ct_max (${ct_pct}%)"
        [ "$ct_pct" -ge 80 ] &&
            echo -e "    ${RED}=> 超过 80%，表满会静默丢包。需要加大 nf_conntrack_max 并同步 hashsize${NC}"
    fi

    # --- 转发与 MSS clamp 状态（中转档的两项改动是否还在）---
    # iptables 规则重启即失效，用户可能跑过菜单 4 但重启后规则没了而 ip_forward 还在
    # （后者写进了 drop-in），那种半生效状态从菜单状态栏看不出来。
    #
    # 查规则必须用 iptables-save 而不是 iptables -t mangle -S：后者会在 mangle 表
    # 尚未使用时把 xt_TCPMSS/iptable_mangle 模块加载进内核，那就不是零副作用了。
    # iptables-save 只遍历已经加载的表，读不到就说明本来没有
    local fwd
    fwd=$(sysctl -n net.ipv4.ip_forward 2>/dev/null)
    if [ -n "$fwd" ]; then
        if [ "$fwd" = "1" ]; then
            echo -e "  ${CYAN}IP 转发${NC}: ${YELLOW}已开启${NC}（中转档特征；普通业务机不该开）"
            if command -v iptables-save >/dev/null 2>&1; then
                if iptables-save 2>/dev/null | grep -q 'TCPMSS'; then
                    echo -e "    MSS clamp: ${GREEN}规则在${NC}"
                else
                    echo -e "    ${YELLOW}MSS clamp: 规则不在（iptables 规则重启即失效）${NC}"
                    echo -e "    ${YELLOW}  转发已开但 clamp 没了，隧道路径可能出现 MTU 黑洞。重跑菜单 4 可补回${NC}"
                fi
            fi
        else
            echo -e "  ${CYAN}IP 转发${NC}: 关闭（普通业务机的正常状态）"
        fi
    fi
    draw_line
    pause_return
}

# BBR 版本标签。sysctl 回显 bbr 和 uname 里有 xanmod 都证明不了版本，
# 唯一可靠判据是模块自报的 version（Google 的 v3 patch 里有 MODULE_VERSION("3")）。
# XanMod 把 BBR 编进内核而非模块，modinfo 读的是 modules.builtin.modinfo，
# 很老的 kmod 读不到——这时报「未知」而不是判失败
#
# 主线 tcp_bbr.c 从来没写过 MODULE_VERSION，所以「读不到 version」有两种成因：
# 模块确实没报版本，或者 modinfo 通路本身不可用。用 tcp_cubic 当探针区分——主线
# 一直给它写着 MODULE_VERSION("2.3")，探针读得到就说明通路正常。
#
# 但探针只能证明通路可用，证明不了「这就是主线 BBR」：任何不写 MODULE_VERSION
# 的下游/自研 BBR 补丁在这里长得和主线一模一样。所以标签只陈述观察到的事实
# 「模块未报版本」，不写成「主线 BBR」——缺少证据不是证据
# [人工决策-2026-08-04 23:07:09] 探针的结论边界：区分「模块没报版本」与「读不到」
# 成立，据此推断「是主线实现」不成立。审查指出把缺少 version 当正向证据是结论强于
# 证据，故标签退回事实陈述。未来要真正判定实现来源须另找判据（如比对模块签名/符号）
bbr_version_label() {
    local cc ver
    cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
    [ "$cc" = "bbr" ] || return 0
    ver=$(modinfo tcp_bbr 2>/dev/null | awk '/^version:/{print $2; exit}')
    case "$ver" in
    3) echo -e " ${GREEN}[BBRv3]${NC}" ;;
    '')
        if [ -n "$(modinfo tcp_cubic 2>/dev/null | awk '/^version:/{print $2; exit}')" ]; then
            echo -e " ${YELLOW}[模块未报版本]${NC}"
        else
            echo -e " ${YELLOW}[版本未知]${NC}"
        fi
        ;;
    *) echo -e " ${CYAN}[BBRv${ver}]${NC}" ;;
    esac
}

# ==================================================
# --- A. 调优前后效果测量 ---
# ==================================================
# 计数器一律取「时间窗内的增量」而不是绝对值——绝对值是开机以来的累计，看不出这次调优的效果。
# 有 iperf3 就跑主动压测（-O 2 丢掉前 2 秒的慢启动），没有就只做被动观测
measure() {
    echo -e "\n${YELLOW}>>> 调优效果测量${NC}"
    # 只读功能不自动装包，见 require_tools_readonly 的说明
    require_tools_readonly nstat tc
    local dev win=10 peer=""
    dev=$(egress_dev)

    if [ "$BATCH" != "1" ]; then
        read -p "  iperf3 对端地址（留空则只做被动观测）: " peer
        read -p "  观测窗口秒数（回车默认 10）: " win
        case "$win" in '' | *[!0-9]*) win=10 ;; esac
    fi

    local snap1 snap2
    snap1=$(counter_snapshot "$dev")

    # --- bufferbloat 的空载基线 ---
    # 判据是「负载中的 RTT 相比空载涨了多少」。空载基线必须在打流量**之前**取，
    # 而且要用同一个目标——用不同目标测出来的差值毫无意义。
    # 只在有压测对端且 ping 可用时做：被动观测模式下「空载」和「负载」的边界不存在
    local bb_base="" bb_target=""
    if [ -n "$peer" ] && command -v ping >/dev/null 2>&1; then
        bb_target=$peer
        echo -e "  取空载 RTT 基线（对 $bb_target）..."
        # 5 个包够看基线，别拖太久。取 avg 与 mdev
        bb_base=$(ping -c 5 -W 2 -q "$bb_target" 2>/dev/null | awk -F'/' '
            /rtt|round-trip/ { n = split($NF, a, " "); print $(NF-2) " " a[1]; exit }')
        if [ -n "$bb_base" ]; then
            echo -e "    空载: ${CYAN}${bb_base%% *}${NC} ms (mdev ${bb_base##* })"
        else
            echo -e "    ${YELLOW}空载基线取不到（ICMP 可能被屏蔽），跳过 bufferbloat 判据${NC}"
        fi
    fi

    # iperf3 是主动压测工具，会真的打流量，所以问一次再装——不像 ss/nstat 那样纯读
    if [ -n "$peer" ] && ! command -v iperf3 >/dev/null 2>&1 && [ "$BATCH" != "1" ]; then
        read -p "  未装 iperf3（压测需要，会产生真实流量）。现在安装？[y/N]: " _ins
        [[ "$_ins" =~ ^[Yy]$ ]] && ensure_tools iperf3 >/dev/null
    fi

    # 负载中的 RTT 要与压测**同时**采样，所以后台起一个 ping、把结果写临时文件。
    # 不用 pkill -f 收尾：那个模式可能匹配到当前 SSH 会话的命令行（netriage 踩过这个坑），
    # 只 kill 自己记下的 PID
    local bb_load="" bb_out="" bb_pid=""
    if [ -n "$bb_base" ]; then
        bb_out=$(mktemp)
        # 比压测窗口多跑 2 秒，确保覆盖整个负载期；间隔 1 秒（默认）足够
        ping -c $((win + 2)) -W 2 -q "$bb_target" >"$bb_out" 2>/dev/null &
        bb_pid=$!
        # 用户中途 Ctrl-C 时，后台 ping 与临时文件都要收掉，否则留个孤儿进程
        # 继续 ping 到包数用完。
        # [人工决策-2026-08-05 14:05:33] 用 EXIT 而不是 INT/TERM：实测 kill -INT 发给
        # 主进程时 bash 正阻塞在 iperf3/sleep 上，信号处理要等前台命令返回，那时 ping
        # 早跑完了、trap 等于没用。EXIT 无论怎么退出（正常/中断/set -e）都会执行。
        # 只清自己起的那个 PID——不用 pkill -f，那个模式可能匹配到别的东西
        # （含当前 SSH 会话的命令行，netriage 记过这个判例）
        # shellcheck disable=SC2064
        trap "kill $bb_pid 2>/dev/null; rm -f '$bb_out'" EXIT
    fi

    if [ -n "$peer" ] && command -v iperf3 &>/dev/null; then
        echo -e "  正在对 $peer 压测（${win}s，丢弃前 2s 慢启动）..."
        iperf3 -c "$peer" -t "$win" -O 2 2>&1 | tail -6
    elif [ -n "$peer" ]; then
        echo -e "  ${YELLOW}iperf3 不可用，改为被动观测（只统计这段时间内的真实业务流量）${NC}"
        sleep "$win"
    else
        echo -e "  被动观测 ${win}s（请同时让业务跑起来）..."
        sleep "$win"
    fi

    snap2=$(counter_snapshot "$dev")

    # 收回后台 ping。wait 会等它自然结束（它的包数已经算好了），超时才 kill
    if [ -n "$bb_pid" ]; then
        # 最多再等 4 秒；ping 的总时长是 win+2 秒，正常这时已经结束或即将结束
        local _w=0
        while kill -0 "$bb_pid" 2>/dev/null && [ "$_w" -lt 4 ]; do
            sleep 1
            _w=$((_w + 1))
        done
        kill "$bb_pid" 2>/dev/null
        wait "$bb_pid" 2>/dev/null
        # 解除 trap：它只为覆盖「压测期间被中断」这个窗口，留着会在每次退出时
        # 对一个已经回收的 PID 发信号（无害但无谓），也会干扰后续可能加的 EXIT 处理
        trap - EXIT
        bb_load=$(awk -F'/' '/rtt|round-trip/ { n = split($NF, a, " "); print $(NF-2) " " a[1]; exit }' "$bb_out" 2>/dev/null)
        rm -f "$bb_out"
    fi

    echo -e "\n  ${CYAN}${win}s 窗口内的增量${NC}${YELLOW}（rx/tx_bytes 统计的是网卡 ${dev:-未识别}）${NC}"
    draw_line
    local deltas seg_delta tx_delta
    deltas=$(diff_counters "$snap1" "$snap2")
    echo "$deltas"
    # TCP 段有增长但网卡字节为 0，说明流量没走这块网卡（回环、容器内 veth、
    # 或走了另一条路由）。不解释一下会让人以为测量坏了
    seg_delta=$(echo "$deltas" | awk '$1=="TcpOutSegs"{print $2+0; exit}')
    # tx_bytes 那行是 "tx_bytes  0.00 MB"，取 $2 并去掉小数点后比较整数部分，
    # 避免因格式（前导空格、精度）导致字符串比较失败
    tx_delta=$(echo "$deltas" | awk '$1=="tx_bytes"{printf "%d", $2; exit}')
    if [ "${seg_delta:-0}" -gt 100 ] 2>/dev/null && [ "${tx_delta:-0}" -eq 0 ] 2>/dev/null; then
        echo -e "  ${YELLOW}注意: TCP 段有增长但 ${dev:-出口网卡} 字节为 0${NC}"
        echo -e "  ${YELLOW}      说明这些流量没走这块网卡（回环 / 容器内虚拟网卡 / 另一条路由）${NC}"
    fi
    draw_line

    # --- bufferbloat：负载下 RTT 涨多少 ---
    # 这是唯一能解释「带宽跑满了但延迟很差」的指标。原理是路径上某个设备（家宽网关、
    # 运营商接入层、对端网卡）的缓冲过深：满负载时包在那里排长队，RTT 被抬高几倍，
    # 而吞吐数字看起来完全正常。
    #
    # 判据取「负载 RTT / 空载 RTT ≥ 2」。这个倍数不是精确阈值——路径缓冲的绝对量
    # 才是本质，但那个量测不到，涨幅是能测到的最直接代理指标。
    # 浮点比较必须交给 awk：bash 算术只有整数，53.2 和 152.9 直接比会报错
    if [ -n "$bb_base" ] && [ -n "$bb_load" ]; then
        local bb_verdict
        bb_verdict=$(awk -v b="${bb_base%% *}" -v bm="${bb_base##* }" \
            -v l="${bb_load%% *}" -v lm="${bb_load##* }" '
            BEGIN {
                if (b <= 0) { print "skip"; exit }
                r = l / b
                # mdev 的倍数单独算：抖动放大往往比均值更明显（队列时深时浅）
                rm = (bm > 0) ? lm / bm : 0
                printf "%.1f %.0f", r, rm
            }')
        if [ "$bb_verdict" != "skip" ] && [ -n "$bb_verdict" ]; then
            local bb_ratio bb_mratio
            read -r bb_ratio bb_mratio <<<"$bb_verdict"
            echo -e "  ${CYAN}负载下的 RTT 变化${NC}（bufferbloat 判据，对 $bb_target）"
            printf "    空载  : %s ms  (mdev %s)\n" "${bb_base%% *}" "${bb_base##* }"
            printf "    负载中: %s ms  (mdev %s)\n" "${bb_load%% *}" "${bb_load##* }"
            printf "    倍数  : RTT x%s" "$bb_ratio"
            [ "${bb_mratio:-0}" -gt 1 ] 2>/dev/null && printf "，抖动 x%s" "$bb_mratio"
            printf "\n"
            # 用 awk 判阈值，同样是浮点
            case "$(awk -v r="$bb_ratio" 'BEGIN{ print (r >= 2) ? "bad" : (r >= 1.3 ? "mild" : "ok") }')" in
            bad)
                echo -e "    ${RED}=> 负载下 RTT 涨到 ${bb_ratio} 倍：路径上有过深的缓冲（bufferbloat）${NC}"
                echo -e "    ${RED}   这是中间设备的问题，本机调 sysctl 无解。BBR 比 CUBIC 在这种路径上${NC}"
                echo -e "    ${RED}   表现更好（它按实测带宽发包而不是把队列填满），本脚本已默认开 BBR + fq${NC}"
                ;;
            mild)
                echo -e "    ${YELLOW}=> 负载下 RTT 涨 ${bb_ratio} 倍：轻微排队，属正常范围${NC}"
                ;;
            *)
                echo -e "    ${GREEN}=> 负载下 RTT 基本不涨：路径缓冲健康，没有 bufferbloat${NC}"
                ;;
            esac
            draw_line
        fi
    fi

    # 抖动本身要给出数字，否则下面那句「抖动比均值更有价值」是空话。
    # 用 mdev（ping 的平均偏差）作指标，调优前后各跑一次就能看出差别
    if command -v ping >/dev/null 2>&1; then
        local jt jline
        jline=$(probe_jitter)
        if [ -n "$jline" ]; then
            echo -e "  ${CYAN}RTT 抖动${NC}（mdev，调优前后各跑一次对比）"
            printf '%s\n' "$jline" | while read -r jt javg jmdev; do
                printf "    %-14s avg %-9s mdev %s ms\n" "$jt" "${javg}ms" "$jmdev"
            done
        fi
        draw_line
    fi
    echo -e "  ${YELLOW}A/B 对比要点：同一对端、时间相邻、至少各测 3 次取中位数；${NC}"
    echo -e "  ${YELLOW}单流和多流分别测（iperf3 -P 1 / -P 4），双向都测（加 -R）。${NC}"
    echo -e "  ${YELLOW}只看平均带宽会漏掉真实收益——抖动下降往往比均值提升更有价值${NC}"
    echo -e "  ${YELLOW}（公开对照：nginx reuseport 那组数据里均值只降 21%，标准差降了 88%）${NC}"
    pause_return
}

# 一次性抓齐所有计数器，输出 key=value 便于做差
counter_snapshot() {
    local dev=$1
    if command -v nstat &>/dev/null; then
        nstat -saz 2>/dev/null | awk '/^Tcp(OutSegs|RetransSegs|InSegs)|^TcpExtTCPLoss|^UdpInErrors|^UdpInDatagrams/{print $1"="$2}'
    fi
    if [ -r /proc/net/softnet_stat ]; then
        echo "softnet_dropped=$(softnet_sum 2)"
        echo "softnet_squeezed=$(softnet_sum 3)"
    fi
    if [ -n "$dev" ] && command -v tc &>/dev/null; then
        # 走公共函数：多队列网卡上必须累加全部队列，只取首处会读成 mq 的汇总值（常为 0）
        echo "qdisc_dropped=$(qdisc_drops "$dev")"
    fi
    if [ -n "$dev" ] && [ -r "/sys/class/net/$dev/statistics/rx_bytes" ]; then
        echo "rx_bytes=$(cat "/sys/class/net/$dev/statistics/rx_bytes")"
        echo "tx_bytes=$(cat "/sys/class/net/$dev/statistics/tx_bytes")"
    fi
}

diff_counters() {
    local before=$1 after=$2
    # 两份快照拼成一个流：同一 key 第二次出现时做差。顺序保证在前的是 before
    printf '%s\n%s\n' "$before" "$after" | awk -F= '
        { if (seen[$1]++) { d = $2 - first[$1]; delta[$1] = d } else { first[$1] = $2 } }
        END {
            for (k in delta) {
                if (k == "rx_bytes" || k == "tx_bytes")
                    printf "  %-22s %s MB\n", k, sprintf("%.2f", delta[k] / 1048576)
                else
                    printf "  %-22s %s\n", k, delta[k]
            }
            if (("TcpOutSegs" in delta) && delta["TcpOutSegs"] > 0) {
                r = delta["TcpRetransSegs"] * 10000 / delta["TcpOutSegs"]
                printf "  %-22s %d.%02d%%   <-- 本窗口真实重传率\n", "retrans_rate", r / 100, r % 100
            }
        }' | sort
}

# ==================================================
# --- B. MTU / PMTU 黑洞探测 ---
# ==================================================
# 只读探测。判据链：公网口是否 1500 -> 到对端 PMTU 是否干净 -> 路径有无隧道 ->
# 真实业务是 TCP 还是 UDP/QUIC -> 有无分片/黑洞证据。干净就保持 1500 不要乱改。
# 关键：先做基线探测。busybox / BSD 的 ping 没有 -M do，那种环境下每一档都会 FAIL，
# 那是「没有数据」而不是「有黑洞」——不先说清楚会把用户引向错误结论
probe_mtu() {
    echo -e "\n${YELLOW}>>> MTU / PMTU 探测（只读）${NC}"
    # 必须是支持 -M do 的 ping（iputils）。busybox 的 ping 没这个选项，
    # 那种环境下每一档都会 FAIL——那是「没有数据」而不是「有黑洞」，会误导用户改 MTU。
    # 只读功能不自动装包，见 require_tools_readonly 的说明
    require_tools_readonly ping tracepath
    local peer dev cur_mtu
    dev=$(egress_dev)
    [ -n "$dev" ] && cur_mtu=$(cat "/sys/class/net/$dev/mtu" 2>/dev/null)
    echo -e "  出口网卡 ${CYAN}${dev:-?}${NC} 当前 MTU: ${CYAN}${cur_mtu:-?}${NC}"

    if [ "$BATCH" = "1" ]; then
        peer=1.1.1.1
    else
        read -p "  探测目标（回车默认 1.1.1.1，建议填你真实的业务对端）: " peer
        [ -z "$peer" ] && peer=1.1.1.1
    fi

    if ! ping -M do -s 56 -c 1 -W 2 "$peer" >/dev/null 2>&1; then
        echo -e "  ${YELLOW}基线探测失败：ICMP 可能被屏蔽，或本机 ping 不支持 -M do（busybox/BSD）。${NC}"
        echo -e "  ${YELLOW}这种情况下面全 FAIL 表示「拿不到数据」，不是「存在黑洞」，别据此改 MTU${NC}"
    fi

    command -v tracepath &>/dev/null && tracepath -n "$peer" 2>/dev/null | head -12

    local s mtu ok_max=0
    echo -e "\n  ${CYAN}DF 置位的载荷阶梯（载荷 + 28 = IPv4 MTU）${NC}"
    for s in 1472 1464 1452 1432 1412 1392 1372 1352 1332 1312 1292; do
        mtu=$((s + 28))
        if ping -M do -s "$s" -c 2 -W 2 "$peer" >/dev/null 2>&1; then
            echo -e "    载荷 $s  MTU $mtu  ${GREEN}OK${NC}"
            [ "$ok_max" -eq 0 ] && ok_max=$mtu
        else
            echo -e "    载荷 $s  MTU $mtu  ${RED}FAIL${NC}"
        fi
    done

    draw_line
    if [ "$ok_max" -eq 0 ]; then
        echo -e "  ${YELLOW}没有任何一档通过：优先怀疑 ICMP 被屏蔽（见上面基线提示），而不是 MTU 问题${NC}"
    elif [ "$ok_max" -ge 1500 ]; then
        echo -e "  ${GREEN}路径 MTU 1500 干净，不要改接口 MTU${NC}"
    else
        echo -e "  ${YELLOW}路径 MTU 上限约 $ok_max（低于 1500）${NC}"
        echo -e "  ${YELLOW}如果这是 TCP-only 的黑洞，本脚本已设的 tcp_mtu_probing=1 会自动收敛，无需改接口 MTU；${NC}"
        echo -e "  ${YELLOW}只有 UDP/QUIC 业务也受影响、且路径里确有隧道封装时，才考虑 ip link set $dev mtu $ok_max${NC}"
    fi
    draw_line
    pause_return
}

# ==================================================
# --- 9. 一键全部（1+2+3+4）---
# ==================================================
run_all() {
    echo -e "\n${YELLOW}>>> 一键全部优化：IPv4 优先 + BBR/FQ + 内核参数 + 网卡队列${NC}"
    echo -e "  ${YELLOW}不会改 ring buffer（有丢包时只提示，避免瞬断）；不会改内核。${NC}"

    # 档位要用户明确选，不能默认给中转档——开 IP 转发对普通业务机是意外的语义变更
    echo -e "\n  这台机器的角色："
    echo -e "    ${CYAN}1${NC}) 普通业务机（Web / 面板 / 数据库 / 一般应用）—— 保守档，不开转发"
    echo -e "    ${CYAN}2${NC}) 中转 / 代理 / 隧道节点 —— 保守档 + IP 转发 + MSS Clamp"
    read -p "  选择 [1/2，回车默认 1]: " role
    case "$role" in
    2) PROFILE=transit ;;
    *) PROFILE=normal ;;
    esac

    read -p "  本机出口带宽 Mbps（回车默认 1000，用于按 BDP 算缓冲区）: " TUNE_MBPS
    case "$TUNE_MBPS" in '' | *[!0-9]*) TUNE_MBPS=1000 ;; esac

    read -p "确认执行？[y/N]: " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || {
        echo -e "${GREEN}已取消。${NC}"
        sleep 1
        return
    }

    BATCH=1
    set_ipv4_priority
    enable_bbr
    tune_sysctl
    tune_nic
    BATCH=0
    TUNE_MBPS=""

    echo -e "\n${GREEN}===== 一键优化完成 =====${NC}"
    draw_line
    printf "  %-14s : %s\n" "拥塞算法" "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)"
    printf "  %-14s : %s\n" "默认队列" "$(sysctl -n net.core.default_qdisc 2>/dev/null)"
    printf "  %-14s : %s\n" "somaxconn" "$(sysctl -n net.core.somaxconn 2>/dev/null)"
    printf "  %-14s : %s MB\n" "缓冲区上限" "$(($(sysctl -n net.core.rmem_max 2>/dev/null || echo 0) / 1024 / 1024))"
    printf "  %-14s : %s\n" "IPv4 优先" "$(grep -q '^precedence ::ffff:0:0/96  100' "$GAI_CONF" 2>/dev/null && echo 已开启 || echo 未开启)"
    printf "  %-14s : %s\n" "档位" "$PROFILE"
    draw_line
    echo -e "  ${CYAN}下一步：菜单 8 看瓶颈到底在哪，菜单 a 测调优前后差异${NC}"
    pause_return
}

# ==================================================
# --- 5. 回退 ---
# ==================================================
rollback_tune() {
    echo -e "\n${YELLOW}>>> 回退全部优化${NC}"
    local had_systemd_limits=0
    [ -f "$SYSTEMD_LIMITS_OPT" ] && had_systemd_limits=1
    rm -f "$SYSCTL_OPT" "$LEGACY_SYSCTL_OPT" "$NIC_SYSCTL_OPT" "$LIMITS_OPT" "$BBR_OPT" \
        "$SYSTEMD_LIMITS_OPT" \
        "$BBR_MODLOAD"
    # 删掉 system.conf.d drop-in 后 systemd 不会自动重读，要 daemon-reexec。
    # 它只重新执行 systemd 自身（PID 1 原地 re-exec），不影响正在跑的服务
    if [ "$had_systemd_limits" = "1" ] && has_systemd; then
        if systemctl daemon-reexec 2>/dev/null; then
            echo -e "  已移除 systemd 全局句柄上限并重载（已在运行的服务保持原上限，重启后归位）"
        else
            echo -e "  ${YELLOW}已删除 systemd 句柄上限文件，但 daemon-reexec 失败；重启后自然生效${NC}"
        fi
    fi
    # 无 systemd 环境的开机重放脚本也要删，否则回退后它仍在开机时跑 sysctl --system。
    # 那时配置文件已删，--system 不会重设本脚本的参数，但留个指向已删配置的孤儿脚本
    # 不符合「可完整回退」；用户自己挂到 wsl.conf / rc.local 的那一行删不掉，明确告知
    if [ -f "$SYSCTL_APPLY" ]; then
        rm -f "$SYSCTL_APPLY"
        # 时间戳一起删：留着会让下次调优误判「脚本还挂着」，而脚本本体已经没了
        rm -f "$SYSCTL_APPLY_STAMP"
        echo -e "  已移除开机重放脚本 $(basename "$SYSCTL_APPLY")"
        if is_wsl && [ -n "$(wsl_boot_command)" ]; then
            case "$(wsl_boot_command)" in
            *"$(basename "$SYSCTL_APPLY")"*)
                echo -e "  ${YELLOW}注意：/etc/wsl.conf 的 [boot] command 里还挂着它，请手动删掉那段${NC}"
                echo -e "  ${YELLOW}      当前: command=$(wsl_boot_command)${NC}"
                ;;
            esac
        fi
    fi

    if [ -f "$GAI_BAK" ]; then
        # 查返回值：回退失败必须让用户知道，否则 IPv4 优先会留在系统里而回退报成功。
        # 「可回退性」是本项目的最高优先级，静默失败的回退等于没有回退
        if ! mv "$GAI_BAK" "$GAI_CONF"; then
            echo -e "  ${RED}还原 $GAI_CONF 失败，IPv4 优先设置可能仍生效${NC}"
            echo -e "  ${YELLOW}手动处理: mv $GAI_BAK $GAI_CONF${NC}"
        fi
    elif [ -f "$GAI_CONF" ]; then
        # 无备份时的降级回退：把那一行注释回去。
        # [人工决策-2026-08-05 17:34:52] 这个分支原先是 sed -i ... 2>/dev/null，
        # 既不查返回值也不回读——失败后函数继续往下报「回退完成」，而 IPv4 优先
        # 实际还留在系统里。有备份的分支已经查了 mv 的返回值，这里要对齐：
        # 回退是本项目的最高优先级，静默失败的回退等于没有回退
        if ! sed -i 's|^precedence ::ffff:0:0/96  100|#precedence ::ffff:0:0/96  100|' "$GAI_CONF" 2>/dev/null; then
            echo -e "  ${RED}改回 $GAI_CONF 失败（只读挂载 / 权限），IPv4 优先仍生效${NC}"
            echo -e "  ${YELLOW}手动处理: 把 $GAI_CONF 里 precedence ::ffff:0:0/96 100 那行前面加 #${NC}"
        elif grep -q '^precedence ::ffff:0:0/96  100' "$GAI_CONF" 2>/dev/null; then
            # sed 返回 0 不等于真改了（某些 busybox sed 版本有此差异），回读确认
            echo -e "  ${RED}sed 返回成功但 $GAI_CONF 里那一行仍未被注释，IPv4 优先仍生效${NC}"
            echo -e "  ${YELLOW}手动处理: 把 $GAI_CONF 里 precedence ::ffff:0:0/96 100 那行前面加 #${NC}"
        fi
    fi

    # 还原被接管的冲突文件。接管清单在首次调优时落盘，这里逐条改回来
    if [ -f "$TAKEOVER_LIST" ]; then
        local tf bak flat
        # 从最早的备份目录取——多次调优会产生多个 takeover-*，第一次那份才是用户的原文件
        local earliest
        earliest=$(ls -d "$STATE_DIR"/takeover-* 2>/dev/null | head -1)
        while IFS= read -r tf; do
            [ -z "$tf" ] && continue
            flat=$(echo "${tf#/}" | tr '/' '_')
            bak=""
            [ -n "$earliest" ] && [ -f "$earliest/$flat" ] && bak="$earliest/$flat"
            # 兼容上一版的备份命名（直接用 basename）
            [ -z "$bak" ] && [ -n "$earliest" ] && [ -f "$earliest/$(basename "$tf")" ] &&
                bak="$earliest/$(basename "$tf")"
            if [ -n "$bak" ]; then
                cat "$bak" >"$tf" 2>/dev/null &&
                    echo -e "  已还原 $tf（从 $bak）"
            else
                # 没有备份就只把我们加的注释标记去掉，把原行恢复出来
                sed -i 's|^# moved to .* by tcp-dashboard: ||' "$tf" 2>/dev/null &&
                    echo -e "  ${YELLOW}$tf 无备份，已就地去掉接管标记恢复原行${NC}"
            fi
            # 旧版整文件禁用的遗留
            [ -f "$tf.disabled-by-tcp-dashboard" ] && [ ! -s "$tf" ] &&
                mv "$tf.disabled-by-tcp-dashboard" "$tf" 2>/dev/null
        done <"$TAKEOVER_LIST"
        rm -f "$TAKEOVER_LIST"
    fi

    # MSS clamp 规则按 comment 标记删除，只动本脚本加的那条——
    # 用户自己加过同样的规则时不会被误删（实测验证过）
    if command -v iptables &>/dev/null; then
        local _mss_n
        _mss_n=$(del_owned_mss)
        [ "${_mss_n:-0}" -gt 0 ] 2>/dev/null &&
            echo -e "  已删除 ${_mss_n} 条本脚本加的 MSS Clamp 规则"
    fi

    # 停掉并删除 RPS/XPS 的开机应用单元
    if [ -f "$NIC_UNIT" ]; then
        systemctl disable --now "$(basename "$NIC_UNIT")" &>/dev/null
        rm -f "$NIC_UNIT" "$NIC_APPLY" "$NICPLAN"
        systemctl daemon-reload &>/dev/null
        echo -e "  已移除开机应用单元 $(basename "$NIC_UNIT")"
    fi
    # networkd-dispatcher 钩子是另一处状态，unit 不存在时也可能留着（用户只跑过菜单 c）
    [ -f "$NIC_DISPATCH" ] && {
        rm -f "$NIC_DISPATCH"
        echo -e "  已移除 networkd-dispatcher 钩子"
    }

    # qdisc 的运行时改动要还原。顺序是「先删 plan 再恢复」，否则 dispatcher 钩子
    # 可能在中途被触发、把刚删掉的设置又写回来。
    # 恢复方式是 tc qdisc del 让内核按 default_qdisc 重建，而不是硬编码回落到某个值——
    # 社区脚本常见的「失败就 replace root fq」等于把用户改成另一个状态，不是回退
    if [ -f "$QDISCPLAN" ]; then
        local qdev qwant qroot
        while IFS=$'\t' read -r qdev qwant; do
            [ -n "$qdev" ] && [ -d "/sys/class/net/$qdev" ] || continue
            qroot=$(tc qdisc show dev "$qdev" 2>/dev/null | awk 'NR==1{print $2}')
            case "$qroot" in
            mq | mqprio)
                # 逐叶子 del：内核会按 default_qdisc 给每个队列重建默认 qdisc。
                # 不能对 root 做 del——那会把 mq 本身删掉
                for f in $(tc qdisc show dev "$qdev" 2>/dev/null |
                    awk '/parent/{for(i=1;i<=NF;i++) if($i=="parent") print $(i+1)}'); do
                    tc qdisc del dev "$qdev" parent "$f" 2>/dev/null
                done
                ;;
            '') ;;
            *) tc qdisc del dev "$qdev" root 2>/dev/null ;;
            esac
        done <"$QDISCPLAN"
        rm -f "$QDISCPLAN"
        echo -e "  已还原 qdisc（交回内核按 default_qdisc 重建）"
    fi

    local eth f
    for eth in $(phys_ifaces); do
        for f in /sys/class/net/"$eth"/queues/rx-*/rps_cpus; do [ -f "$f" ] && { echo 0 >"$f"; } 2>/dev/null; done
        for f in /sys/class/net/"$eth"/queues/tx-*/xps_cpus; do [ -f "$f" ] && { echo 0 >"$f"; } 2>/dev/null; done
    done

    # 顺序很关键：先让 sysctl --system 重新应用「还留在系统里的」配置文件
    # （包括刚还原回来的被接管文件），再逐个写回受管 key 的原始运行时值。
    # 反过来做的话 --system 会把刚还原的值又覆盖掉
    apply_sysctl
    restore_managed_keys

    echo -e "${GREEN}回退完成：配置文件已清理，受管参数已逐个还原到首次运行前的值${NC}"
    if [ -f "$ORIG_STATE" ]; then
        echo -e "  ${YELLOW}原始值快照保留在 $ORIG_STATE（卸载面板时才删除）${NC}"
    fi
    # ip_forward 遗留是安全问题，单独确认一次
    local fw
    fw=$(sysctl -n net.ipv4.ip_forward 2>/dev/null)
    if [ "$fw" = "1" ]; then
        local ofw
        ofw=$(orig_value net.ipv4.ip_forward 2>/dev/null)
        if [ "$ofw" = "1" ]; then
            echo -e "  ${YELLOW}ip_forward 仍为 1，但快照显示本机运行前就是 1，属原状${NC}"
        else
            echo -e "  ${RED}警告: ip_forward 仍为 1 且未能还原，请手动执行 sysctl -w net.ipv4.ip_forward=0${NC}"
            echo -e "  ${RED}      并检查 /etc/sysctl.d/ 与 /etc/sysctl.conf 里是否有别的文件也在设它${NC}"
        fi
    fi
}

# ==================================================
# --- 主菜单 ---
# ==================================================
# 版本检查只在进菜单前做一次（结果存 $LATEST_VERSION，循环里每次刷新直接读）。
# 放进 while 会让每次菜单重绘都走一遍缓存判断，纯属噪音
fetch_latest_version

while true; do
    if [ -f "$GAI_CONF_REAL" ] && grep -q '^precedence ::ffff:0:0/96  100' "$GAI_CONF_REAL"; then
        st_ipv4="${GREEN}[已开启]${NC}"
    else
        st_ipv4="${RED}[未开启]${NC}"
    fi
    # BBR 三态。只判运行时值会漏掉最误导人的那种：配置文件写着 bbr、实际跑 cubic
    # （无 systemd 机器重启后的常态）。那种情况报「未开启」也不对——用户明明设过，
    # 报「配置未生效」才能让他知道要去挂开机重放
    if [ "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)" = "bbr" ]; then
        st_bbr="${GREEN}[已开启]${NC}"
    elif [ -f "$BBR_OPT" ]; then
        st_bbr="${YELLOW}[配置未生效]${NC}"
    else
        st_bbr="${RED}[未开启]${NC}"
    fi
    # 同理：文件存在不等于参数在跑。sysctl_conf_stale 逐条比对配置与实际生效值，
    # 有任一项不符就标黄，避免「显示已开启、实际全是原值」（判例：WSL2 重启后）
    if [ -f "$SYSCTL_OPT" ]; then
        if grep -q '^net\.ipv4\.ip_forward *= *1' "$SYSCTL_OPT" 2>/dev/null; then
            st_sysctl="${GREEN}[中转档]${NC}"
        else
            st_sysctl="${GREEN}[保守档]${NC}"
        fi
        sysctl_conf_stale "$SYSCTL_OPT" && st_sysctl="${YELLOW}[配置未生效]${NC}"
    else
        st_sysctl="${RED}[未开启]${NC}"
    fi
    # 状态判据必须读真实生效的掩码。以前判 rps_sock_flow_entries==32768：
    # 一是那个值只设了运行时、重启就丢，二是它跟 rps_cpus 到底有没有生效毫无关系
    st_nic="${RED}[未开启]${NC}"
    for _f in /sys/class/net/*/queues/rx-*/rps_cpus; do
        [ -f "$_f" ] || continue
        if mask_is_set "$(cat "$_f" 2>/dev/null)"; then
            # 判「unit 确实 enable 了」而不是「unit 文件存在」——文件是无条件写的，
            # 容器里或 systemctl enable 失败时仍会存在，据此报持久化就是假阳性
            if nic_unit_enabled; then
                st_nic="${GREEN}[已开启+持久化]${NC}"
            else
                st_nic="${YELLOW}[已开启未持久化]${NC}"
            fi
            break
        fi
    done

    # qdisc 状态：判「实际生效的」是否已等于 default_qdisc。
    # 多队列网卡要看叶子而不是 root（root 恒为 mq），否则永远显示不一致。
    # 这里是主循环而非函数体，不能用 local（会报 "local: can only be used in a function"）
    st_qdisc="${YELLOW}[未知]${NC}"
    _qdev=$(egress_dev)
    _qwant=$(sysctl -n net.core.default_qdisc 2>/dev/null)
    if [ -n "$_qdev" ] && [ -n "$_qwant" ]; then
        IFS=$'\t' read -r _qroot _qleaf <<<"$(qdisc_kinds "$_qdev")"
        _qnow=$_qroot
        case "$_qroot" in mq | mqprio) _qnow=$_qleaf ;; esac
        if [ -z "$_qroot" ]; then
            st_qdisc="${YELLOW}[缺 tc 无法判断]${NC}"
        elif [ "$_qnow" = "$_qwant" ]; then
            st_qdisc="${GREEN}[已是 ${_qwant}]${NC}"
        elif [ "$_qnow" = "noqueue" ]; then
            # lo / veth 按内核设计固定 noqueue，不算未生效（容器里出口就是 veth）
            st_qdisc="${GREEN}[noqueue 虚拟设备]${NC}"
        else
            st_qdisc="${YELLOW}[当前 ${_qnow:-?}]${NC}"
        fi
    fi

    # 无 TERM 环境（CI / 非交互）下 clear 会报错，回落到 ANSI 清屏
    clear 2>/dev/null || printf '\033[2J\033[H'
    echo -e "${YELLOW}==================================================${NC}"
    echo -e "${YELLOW}           TCP/UDP 网络调优面板                   ${NC}"
    echo -e "${GREEN}           快捷命令: tcpo   v${SCRIPT_VERSION}${NC}"
    # 有新版只在标题栏提示一行，不自动更新（这台机器可能正在跑业务）
    _hint=$(version_hint)
    [ -n "$_hint" ] && echo -e "           $_hint"
    echo -e "${YELLOW}==================================================${NC}"
    echo -e "  ${CYAN}9. 一键全部优化 (1+2+3+4)${NC}"
    draw_line
    echo -e "  1. IPv4 优先解析      -> $st_ipv4  [避免 IPv6 绕路导致的握手延迟]"
    echo -e "  2. BBR + FQ           -> $st_bbr  [不因随机丢包降速，跨境链路必开]"
    echo -e "  3. 内核参数调优       -> $st_sysctl  [保守档：不开转发，适合普通业务]"
    echo -e "  4. 内核参数-中转档    -> $st_sysctl  [保守档 + IP 转发 + MSS Clamp]"
    echo -e "  5. 网卡队列/RPS/XPS   -> $st_nic  [软中断分摊，含开机持久化]"
    echo -e "  c. qdisc 立刻生效     -> $st_qdisc  [运行时改动。不改也可，重启即自动生效]"
    draw_line
    echo -e "  ${CYAN}8. 瓶颈诊断${NC}          [只读。判断调 sysctl 到底有没有用]"
    echo -e "  ${CYAN}a. 调优效果测量${NC}      [只读。前后计数器增量对比]"
    echo -e "  ${CYAN}b. MTU / PMTU 探测${NC}   [只读。查路径有没有 MTU 黑洞]"
    draw_line
    echo -e "  6. 回退全部优化"
    echo -e "  7. 更新脚本"
    echo -e "  q. 卸载面板"
    echo -e "  0. 退出"
    draw_line
    echo -e "  当前: 算法 ${GREEN}$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)${NC}$(bbr_version_label) | 队列 ${GREEN}$(sysctl -n net.core.default_qdisc 2>/dev/null)${NC} | 句柄 ${GREEN}$(ulimit -n)${NC}"
    [ "$DRYRUN" = "1" ] && echo -e "  ${CYAN}[演练模式] 不会写入任何系统文件，退出时打印将写入的内容${NC}"
    draw_line

    # read 失败 = stdin 已 EOF（无 tty 的非交互环境），必须退出，否则 case 落到 * 分支空转刷屏
    read -p "请选择: " opt || {
        echo
        exit 0
    }
    case "$opt" in
    9) run_all ;;
    1) set_ipv4_priority ;;
    2) enable_bbr ;;
    3) PROFILE=normal tune_sysctl ;;
    4)
        echo -e "\n${YELLOW}中转档会额外开启 IP 转发并给 mangle FORWARD 加 MSS Clamp。${NC}"
        echo -e "${YELLOW}只有中转 / 代理 / 隧道节点才需要——普通业务机开了等于把自己变成路由器。${NC}"
        read -p "确认使用中转档？[y/N]: " _c
        [[ "$_c" =~ ^[Yy]$ ]] && PROFILE=transit tune_sysctl || echo -e "${GREEN}已取消。${NC}"
        ;;
    5) tune_nic ;;
    8) diagnose ;;
    a | A) measure ;;
    b | B) probe_mtu ;;
    c | C) apply_live_qdisc ;;
    6) rollback_tune && pause_return ;;
    7) check_update ;;
    q | Q) uninstall_script ;;
    0)
        dryrun_report
        exit 0
        ;;
    *) echo -e "${RED}输入无效${NC}" && sleep 1 ;;
    esac
done
